---
import BaseLayout from "../layouts/BaseLayout.astro";
import BreadcrumbHero from "./BreadcrumbHero.astro";
import FunnelPageView from "./FunnelPageView.astro";
import {
  breadcrumbSchema,
  contactPageSchema,
  howToSchema,
  site,
} from "../data/site";

interface Props {
  currentPath?: string;
  variant?: "quote" | "contact";
}
const { currentPath = "/request-a-quote", variant = "quote" } = Astro.props;
const isContact = variant === "contact";
const steps = [
  {
    name: "Completeness check",
    text: "We check the model, quantity, destination and available files.",
  },
  {
    name: "Technical review",
    text: "The complete code and key application parameters are compared.",
  },
  {
    name: "Sourcing review",
    text: "Suitable suppliers confirm model, price, MOQ, lead time and available evidence.",
  },
  {
    name: "Risk and quote",
    text: "The quotation states differences, open confirmations and commercial terms.",
  },
];
const pageUrl = `${site.url}${isContact ? "/contact/" : "/request-a-quote/"}`;
const pageTitle = isContact
  ? "Contact Hydraulic Match"
  : "Request a Hydraulic Component Match and Quote";
const pageDescription = isContact
  ? "Contact Hydraulic Match for hydraulic valve, pump, cylinder, inventory, direct replacement and international sourcing inquiries."
  : "Upload a hydraulic nameplate, drawing or RFQ list. Send the original manufacturer, complete model code, quantity, destination and application details.";
const breadcrumbLabel = isContact ? "Contact Us" : "Request a Match";
const heroTitle = isContact
  ? "Contact Hydraulic Match"
  : "Request a Hydraulic Component Match and Quote";
const whatsappHref = `https://wa.me/${site.whatsapp.replace(/\D/g, "")}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  currentPath={currentPath}
  hideFloatingCta
  jsonLd={[
    breadcrumbSchema([
      { name: "Home", url: site.url },
      { name: breadcrumbLabel, url: pageUrl },
    ]),
    contactPageSchema({
      name: pageTitle,
      description: pageDescription,
      url: pageUrl,
    }),
    howToSchema({
      name: "How to request a hydraulic component match",
      description: "Submit technical details for review and quotation.",
      steps,
    }),
  ]}
>
  <FunnelPageView stage="quote" label="hydraulic-rfq" />
  <BreadcrumbHero
    title={heroTitle}
    trail={[{ label: "Home", href: "/" }, { label: breadcrumbLabel }]}
    variant="5"
  />
  <section class="hm-rfq" aria-labelledby="rfq-form-heading">
    <div class="container hm-rfq__layout">
      <div class="hm-rfq__form-card">
        <header>
          <p class="hm-kicker">COMPLETE RFQ</p>
          <h2 id="rfq-form-heading">Tell us what must be matched.</h2>
          <p class="hm-rfq__lead">
            Required: name, email, country, manufacturer and quantity. A full
            model code <em>or</em> a clear nameplate / photo is enough to submit.
            Technical fields are optional and can be added when known.
          </p>
        </header>
        <form
          id="hydraulic-rfq-form"
          class="hm-rfq-form"
          data-endpoint="/api/rfq/"
          data-fallback-email={site.email}
        >
          <fieldset>
            <legend>Customer information</legend>
            <div class="hm-rfq-grid">
              <label
                >Name *<input name="name" autocomplete="name" required /></label
              >
              <label
                >Company<input
                  name="company"
                  autocomplete="organization"
                /></label
              >
              <label
                >Business Email *<input
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                /></label
              >
              <label
                >Phone / WhatsApp<input
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                /></label
              >
              <label class="hm-rfq-full"
                >Destination Country *<input
                  name="country"
                  autocomplete="country-name"
                  required
                /></label
              >
            </div>
          </fieldset>
          <fieldset>
            <legend>Product information</legend>
            <div class="hm-rfq-grid">
              <label
                >Original Manufacturer *<input
                  name="brand"
                  placeholder="e.g. Rexroth, Vickers, Parker"
                  required
                /></label
              >
              <label
                >Full Model Code<input
                  name="model"
                  placeholder="Enter the complete code, or upload a clear reference file"
                /></label
              >
              <label
                >Product Type<select name="product_type"
                  ><option value="">Select</option><option
                    >Hydraulic Valve</option
                  ><option>Hydraulic Pump</option><option
                    >Hydraulic Pump Part</option
                  ><option>Hydraulic Cylinder</option><option>Other</option
                  ></select
                ></label
              >
              <label
                >Quantity *<input
                  name="quantity"
                  placeholder="e.g. 2 pcs"
                  required
                /></label
              >
            </div>
          </fieldset>
          <fieldset>
            <legend>Files and message</legend>
            <div class="hm-rfq-grid">
              <label class="hm-rfq-full hm-file-label"
                >Upload nameplates, product photos, drawings, datasheets or an
                RFQ list
                <input
                  name="attachments"
                  type="file"
                  accept=".jpg,.jpeg,.png,.webp,.pdf,.xls,.xlsx,.doc,.docx,.csv"
                  multiple
                />
                <span
                  >Up to 5 files. JPG, PNG, WebP, PDF, Excel, Word or CSV;
                  maximum 5 MB per file and 20 MB combined.</span
                >
              </label>
              <label class="hm-rfq-full"
                >Additional Message<textarea
                  name="details"
                  rows="3"
                  placeholder="Add commercial, packing or inspection notes if needed."
                ></textarea></label
              >
            </div>
          </fieldset>
          <details class="hm-rfq-disclosure">
            <summary>
              <span>More options</span>
              <span class="hm-rfq-disclosure__hint"
                >Buyer type, part number, delivery date</span
              >
            </summary>
            <div class="hm-rfq-grid">
              <label
                >Buyer Type<select name="role"
                  ><option value="">Select</option><option>Distributor</option
                  ><option>Repair / Service Company</option><option
                    >MRO / Factory Maintenance</option
                  ><option>Equipment Manufacturer</option><option
                    >Other Business Buyer</option
                  ></select
                ></label
              >
              <label>Order / Part Number<input name="part_number" /></label>
              <label
                >Required Delivery Date<input
                  name="deadline"
                  type="date"
                /></label
              >
            </div>
          </details>
          <details class="hm-rfq-disclosure">
            <summary>
              <span>Technical details (optional)</span>
              <span class="hm-rfq-disclosure__hint"
                >Skip if the model code or nameplate is clear</span
              >
            </summary>
            <div class="hm-rfq-grid">
              <label
                >Working Pressure<input
                  name="working_pressure"
                  placeholder="bar / MPa"
                /></label
              >
              <label
                >Flow or Displacement<input name="flow_displacement" /></label
              >
              <label
                >Voltage and Connector<input name="voltage_connector" /></label
              >
              <label
                >Mounting and Port Details<input name="mounting_ports" /></label
              >
              <label>Rotation and Shaft<input name="rotation_shaft" /></label>
              <label
                >Fluid and Temperature<input name="fluid_temperature" /></label
              >
              <label class="hm-rfq-full"
                >Application / replacement notes<textarea
                  name="application"
                  rows="4"
                  placeholder="Machine, duty cycle, failure mode, or why a replacement is needed."
                ></textarea></label
              >
            </div>
          </details>
          <input
            type="hidden"
            name="source"
            value={isContact
              ? "Hydraulic Match contact page"
              : "Hydraulic Match complete RFQ"}
          />
          <input type="hidden" name="message" />
          <div class="hp-field" aria-hidden="true">
            <label
              >Leave empty<input
                name="website"
                tabindex="-1"
                autocomplete="off"
              /></label
            >
          </div>
          {
            site.turnstileSiteKey && (
              <div class="hm-rfq-turnstile">
                <div
                  class="cf-turnstile"
                  data-sitekey={site.turnstileSiteKey}
                  data-theme="light"
                />
                <p>
                  Security verification protects this technical inquiry form
                  from automated abuse.
                </p>
              </div>
            )
          }
          <div class="hm-rfq-submit">
            <button type="submit">
              <span>Send Match Request</span>
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M5 12h14m0 0-5-5m5 5-5 5"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
            <p>
              Response timing depends on inquiry completeness, supplier
              confirmation and time zone. A quotation is not a compatibility
              guarantee until the required technical confirmation is complete.
            </p>
          </div>
          <div class="form-result" aria-live="polite" role="status"></div>
        </form>
      </div>
      <aside class="hm-rfq__aside" aria-label="RFQ process and contact">
        <div class="hm-rfq__aside-card hm-rfq__aside-card--dark">
          <p class="hm-kicker hm-kicker--light">WHAT HAPPENS NEXT</p>
          <ol>
            {
              steps.map((step, index) => (
                <li>
                  <span aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <strong>{step.name}</strong>
                    <p>{step.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="hm-rfq__aside-card">
          <h3>Minimum useful information</h3>
          <ul>
            <li>Original brand</li>
            <li>Complete model code</li>
            <li>Quantity</li>
            <li>Destination country</li>
            <li>Nameplate or photos</li>
          </ul>
        </div>
        <div class="hm-rfq__aside-card">
          <h3>Prefer email?</h3>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <p>
            Attach the same model, quantity, destination and technical files.
          </p>
        </div>
      </aside>
    </div>
  </section>
  {
    !isContact && (
      <section class="hm-rfq-guidance">
        <div class="container">
          <header>
            <p class="hm-kicker">BEFORE YOU SUBMIT</p>
            <h2>What a responsible quotation should make visible.</h2>
            <p>
              A submitted form starts a review; it does not create a supply
              commitment. The response should separate confirmed facts from
              assumptions and open questions.
            </p>
          </header>
          <div class="hm-rfq-guidance__grid">
            <article>
              <strong>Original reference</strong>
              <p>
                The manufacturer, complete code and source files used for
                identification.
              </p>
            </article>
            <article>
              <strong>Offered route</strong>
              <p>
                The proposed manufacturer or supply condition, rather than an
                ambiguous “replacement” label.
              </p>
            </article>
            <article>
              <strong>Technical status</strong>
              <p>
                Matched fields, known differences and confirmations still
                required before release.
              </p>
            </article>
            <article>
              <strong>Commercial scope</strong>
              <p>
                Price, MOQ, lead time, warranty, inspection, packing, Incoterm
                and quote validity.
              </p>
            </article>
          </div>
          <div class="hm-rfq-guidance__boundary">
            <div>
              <strong>Possible response states</strong>
              <p>
                Ready to quote, technical clarification required, conditional
                candidate, or no responsible supply route.
              </p>
            </div>
            <div>
              <strong>File and privacy boundary</strong>
              <p>
                Upload only files you are authorized to share. Inquiry files may
                be reviewed with relevant suppliers for quotation and
                verification as described in the{" "}
                <a href="/privacy/">privacy policy</a>.
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }
  {
    isContact && (
      <section
        class="hm-contact-details"
        aria-labelledby="contact-details-heading"
      >
        <div class="container">
          <header>
            <p class="hm-kicker">DIRECT CONTACT</p>
            <h2 id="contact-details-heading">
              Contact our hydraulic sourcing team.
            </h2>
            <p>
              Use email, phone or WhatsApp for inventory checks, direct
              replacement review, warranty questions and urgent hydraulic
              requirements.
            </p>
          </header>
          <div class="hm-contact-details__grid">
            <article>
              <span>EMAIL</span>
              <h3>Sales and technical inquiries</h3>
              <a href={`mailto:${site.email}`}>{site.email}</a>
              <p>
                Attach the complete model code, nameplate, quantity and
                destination.
              </p>
            </article>
            <article>
              <span>PHONE &amp; WHATSAPP</span>
              <h3>Fast commercial communication</h3>
              <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>
              <a href={whatsappHref} target="_blank" rel="noopener noreferrer">
                Open WhatsApp
              </a>
            </article>
            <article>
              <span>SUPPLY OFFICE</span>
              <h3>China hydraulic sourcing</h3>
              <p>
                Inventory coordination, supplier qualification, supply-route
                review, inspection, export packing and international shipping
                support.
              </p>
              <a href="/about/">About Hydraulic Match</a>
            </article>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  const rfqForm = document.querySelector<HTMLFormElement>(
    "#hydraulic-rfq-form",
  );
  if (rfqForm) {
    const params = new URLSearchParams(window.location.search);
    ["brand", "model"].forEach((name) => {
      const value = params.get(name);
      const field = rfqForm.querySelector<HTMLInputElement>(
        `input[name="${name}"]`,
      );
      if (value && field) field.value = value;
    });
    const source = params.get("source");
    const sourceField = rfqForm.querySelector<HTMLInputElement>(
      'input[name="source"]',
    );
    if (source && sourceField) sourceField.value = source;
  }
  rfqForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const result = rfqForm.querySelector<HTMLElement>(".form-result");
    const submit = rfqForm.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    const data = new FormData(rfqForm);
    const attachments = data
      .getAll("attachments")
      .filter((entry) => entry instanceof File && entry.size > 0) as File[];
    const model = data.get("model")?.toString().trim() ?? "";
    const fileError =
      attachments.length > 5
        ? "Please upload no more than 5 files."
        : attachments.some((file) => file.size > 5 * 1024 * 1024)
          ? "Each file must be 5 MB or smaller."
          : attachments.reduce((total, file) => total + file.size, 0) >
              20 * 1024 * 1024
            ? "The combined attachment size must be 20 MB or smaller."
            : !model && attachments.length === 0
              ? "Enter the full model code or upload at least one clear reference file."
              : "";
    if (fileError) {
      if (result) {
        result.className = "form-result is-visible is-error";
        result.setAttribute("role", "alert");
        result.textContent = fileError;
      }
      return;
    }
    const lines = [
      `Original manufacturer: ${data.get("brand")}`,
      `Full model code: ${model || "See attachment"}`,
      `Order / part number: ${data.get("part_number") || "-"}`,
      `Product type: ${data.get("product_type") || "-"}`,
      `Quantity: ${data.get("quantity")}`,
      `Required delivery date: ${data.get("deadline") || "-"}`,
      "",
      `Working pressure: ${data.get("working_pressure") || "-"}`,
      `Flow / displacement: ${data.get("flow_displacement") || "-"}`,
      `Voltage / connector: ${data.get("voltage_connector") || "-"}`,
      `Mounting / ports: ${data.get("mounting_ports") || "-"}`,
      `Rotation / shaft: ${data.get("rotation_shaft") || "-"}`,
      `Fluid / temperature: ${data.get("fluid_temperature") || "-"}`,
      `Application / replacement notes: ${data.get("application") || "-"}`,
      "",
      `Additional message: ${data.get("details") || "-"}`,
    ];
    data.set("message", lines.join("\n"));
    data.set("replacement_reason", "");
    submit?.setAttribute("disabled", "true");
    if (submit) {
      const label = submit.querySelector("span");
      if (label) label.textContent = "Sending...";
      else submit.textContent = "Sending...";
    }
    if (result) {
      result.className = "form-result";
      result.setAttribute("role", "status");
      result.textContent = "";
    }
    try {
      const response = await fetch(rfqForm.dataset.endpoint ?? "/api/rfq/", {
        method: "POST",
        body: data,
        headers: { Accept: "application/json" },
      });
      if (!response.ok) {
        const payload = await response.json().catch(() => null);
        throw new Error(
          typeof payload?.message === "string"
            ? payload.message
            : "The form could not be sent.",
        );
      }
      window.location.href = "/thank-you/?source=rfq";
    } catch (error) {
      if (result) {
        result.className = "form-result is-visible is-error";
        result.setAttribute("role", "alert");
        const message =
          error instanceof Error
            ? error.message
            : "The form could not be sent.";
        result.textContent = `${message} If the problem continues, email ${rfqForm.dataset.fallbackEmail} with your files.`;
      }
      submit?.removeAttribute("disabled");
      if (submit) {
        const label = submit.querySelector("span");
        if (label) label.textContent = "Send Match Request";
        else submit.textContent = "Send Match Request";
      }
    }
  });
</script>

<style>
  /*
    RFQ page SEO / conversion layout
    Structure: Hero → Form+Aside → Guidance (quote) | Contact details (contact)
    - Horizontal inset aligned with navbar (global .container is 0)
    - Readable copy ≥16px; form inputs 16px (mobile zoom prevention)
    - Touch targets ≥44px; visible focus; reduced-motion
  */
  .hm-rfq {
    margin-top: 14px;
    padding: 24px 0 30px;
    background: radial-gradient(
      900px 280px at 40% -10%,
      rgba(20, 110, 245, 0.07),
      transparent 70%
    );
    /* linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%); */
  }

  .hm-rfq > .container,
  .hm-rfq-guidance > .container,
  .hm-contact-details > .container {
    width: 100%;
    max-width: 1880px;
    margin-left: auto;
    margin-right: auto;
    /* padding-left: 20px;
    padding-right: 20px; */
    box-sizing: border-box;
  }

  .hm-rfq__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
    gap: 24px;
    align-items: start;
  }

  .hm-rfq__form-card {
    padding: 36px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    /* border-radius: 14px; */
    background: #fff;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 16px 40px rgba(15, 23, 42, 0.05);
  }

  .hm-rfq__form-card header {
    max-width: 68ch;
    margin-bottom: 32px;
  }

  .hm-kicker {
    margin: 0 0 8px;
    color: var(--color-primary);
    font-family: var(--font-title);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hm-kicker--light {
    color: #93c5fd;
  }

  .hm-rfq__form-card h2 {
    margin: 0 0 12px;
    color: #0f172a;
    font-size: clamp(1.55rem, 2.4vw, 2rem);
    line-height: 1.25;
    text-transform: none;
  }

  .hm-rfq__lead {
    margin: 0;
    color: #475569;
    font-size: 16px;
    line-height: 1.7;
  }

  .hm-rfq-form {
    display: grid;
    gap: 28px;
  }

  .hm-rfq__lead em {
    font-style: normal;
    font-weight: 600;
    color: #0f172a;
  }

  .hm-rfq-form fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .hm-rfq-form legend {
    width: 100%;
    margin-bottom: 16px;
    padding: 0 0 12px;
    border-bottom: 1px solid #e2e8f0;
    color: #0f172a;
    font: 600 1.1rem/1.3 var(--font-title);
  }

  .hm-rfq-disclosure {
    margin: 0;
    padding: 0;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: #f8fafc;
    overflow: hidden;
  }

  .hm-rfq-disclosure summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    min-height: 52px;
    padding: 14px 18px;
    color: #0f172a;
    font: 600 0.95rem/1.35 var(--font-title);
    list-style: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .hm-rfq-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .hm-rfq-disclosure summary::after {
    content: "";
    width: 10px;
    height: 10px;
    margin-left: auto;
    border-right: 2px solid #64748b;
    border-bottom: 2px solid #64748b;
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .hm-rfq-disclosure[open] summary::after {
    transform: rotate(-135deg) translateY(-2px);
  }

  .hm-rfq-disclosure summary:hover {
    background: #f1f5f9;
  }

  .hm-rfq-disclosure summary:focus-visible {
    outline: 3px solid rgba(20, 110, 245, 0.28);
    outline-offset: -3px;
  }

  .hm-rfq-disclosure__hint {
    color: #64748b;
    font: 400 13px/1.4 var(--font-primary);
  }

  .hm-rfq-disclosure .hm-rfq-grid {
    padding: 4px 18px 18px;
  }

  .hm-rfq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .hm-rfq-form label {
    display: grid;
    gap: 8px;
    color: #0f172a;
    font-size: 13px;
    font-weight: 600;
  }

  .hm-rfq-form input,
  .hm-rfq-form select,
  .hm-rfq-form textarea {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid #d7dee8;
    border-radius: 8px;
    background: #fff;
    color: #0f172a;
    font: 400 16px/1.5 var(--font-primary);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .hm-rfq-form select {
    appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='8' viewBox='0 0 14 8' fill='none'><path d='M1 1L7 7L13 1' stroke='%230F172A' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-position: right 14px center;
    background-repeat: no-repeat;
    background-size: 14px;
    padding-right: 40px;
    cursor: pointer;
  }

  .hm-rfq-form textarea {
    min-height: 96px;
    resize: vertical;
  }

  .hm-rfq-form input:hover,
  .hm-rfq-form select:hover,
  .hm-rfq-form textarea:hover {
    border-color: #b8c4d4;
  }

  .hm-rfq-form input:focus-visible,
  .hm-rfq-form select:focus-visible,
  .hm-rfq-form textarea:focus-visible {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(20, 110, 245, 0.14);
  }

  .hm-rfq-full {
    grid-column: 1 / -1;
  }

  .hm-file-label {
    padding: 18px;
    border: 1.5px dashed rgba(20, 110, 245, 0.3);
