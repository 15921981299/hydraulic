---
import BaseLayout from "../layouts/BaseLayout.astro";
import BreadcrumbHero from "./BreadcrumbHero.astro";
import FunnelPageView from "./FunnelPageView.astro";
import {
  breadcrumbSchema,
  contactPageSchema,
  howToSchema,
  site,
} from "../data/site";

interface Props {
  currentPath?: string;
  variant?: "quote" | "contact";
}
const { currentPath = "/request-a-quote", variant = "quote" } = Astro.props;
const isContact = variant === "contact";
const steps = [
  {
    name: "Completeness check",
    text: "We check the model, quantity, destination and available files.",
  },
  {
    name: "Technical review",
    text: "The complete code and key application parameters are compared.",
  },
  {
    name: "Sourcing review",
    text: "Suitable suppliers confirm model, price, MOQ, lead time and available evidence.",
  },
  {
    name: "Risk and quote",
    text: "The quotation states differences, open confirmations and commercial terms.",
  },
];
const pageUrl = `${site.url}${isContact ? "/contact/" : "/request-a-quote/"}`;
const pageTitle = isContact
  ? "Contact Hydraulic Match"
  : "Request a Hydraulic Component Match and Quote";
const pageDescription = isContact
  ? "Contact Hydraulic Match for hydraulic valve, pump, cylinder, inventory, direct replacement and international sourcing inquiries."
  : "Upload a hydraulic nameplate, drawing or RFQ list. Send the original manufacturer, complete model code, quantity, destination and application details.";
const breadcrumbLabel = isContact ? "Contact Us" : "Request a Match";
const heroTitle = isContact
  ? "Contact Hydraulic Match"
  : "Request a Hydraulic Component Match and Quote";
const whatsappHref = `https://wa.me/${site.whatsapp.replace(/\D/g, "")}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  currentPath={currentPath}
  hideFloatingCta
  jsonLd={[
    breadcrumbSchema([
      { name: "Home", url: site.url },
      { name: breadcrumbLabel, url: pageUrl },
    ]),
    contactPageSchema({
      name: pageTitle,
      description: pageDescription,
      url: pageUrl,
    }),
    howToSchema({
      name: "How to request a hydraulic component match",
      description: "Submit technical details for review and quotation.",
      steps,
    }),
  ]}
>
  <FunnelPageView stage="quote" label="hydraulic-rfq" />
  <BreadcrumbHero
    title={heroTitle}
    trail={[{ label: "Home", href: "/" }, { label: breadcrumbLabel }]}
    variant="5"
  />
  <section class="hm-rfq">
    <div class="container hm-rfq__layout">
      <div class="hm-rfq__form-card">
        <header>
          <p class="hm-kicker">COMPLETE RFQ</p>
          <h2>Tell us what must be matched.</h2>
          <p>
            Fields marked * are required. If you do not have a complete model
            code, upload the nameplate and product photos.
          </p>
        </header>
        <form
          id="hydraulic-rfq-form"
          class="hm-rfq-form"
          data-endpoint="/api/rfq/"
          data-fallback-email={site.email}
        >
          <fieldset>
            <legend>Customer information</legend>
            <div class="hm-rfq-grid">
              <label
                >Name *<input name="name" autocomplete="name" required /></label
              >
              <label
                >Company<input
                  name="company"
                  autocomplete="organization"
                /></label
              >
              <label
                >Business Email *<input
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                /></label
              >
              <label
                >Phone / WhatsApp<input
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                /></label
              >
              <label
                >Destination Country *<input
                  name="country"
                  autocomplete="country-name"
                  required
                /></label
              >
              <label
                >Buyer Type<select name="role"
                  ><option value="">Select</option><option>Distributor</option
                  ><option>Repair / Service Company</option><option
                    >MRO / Factory Maintenance</option
                  ><option>Equipment Manufacturer</option><option
                    >Other Business Buyer</option
                  ></select
                ></label
              >
            </div>
          </fieldset>
          <fieldset>
            <legend>Product information</legend>
            <div class="hm-rfq-grid">
              <label
                >Original Manufacturer *<input
                  name="brand"
                  placeholder="e.g. Rexroth, Vickers, Parker"
                  required
                /></label
              >
              <label
                >Full Model Code<input
                  name="model"
                  placeholder="Enter the complete code, or upload a clear reference file"
                /></label
              >
              <label>Order / Part Number<input name="part_number" /></label>
              <label
                >Product Type<select name="product_type"
                  ><option value="">Select</option><option
                    >Hydraulic Valve</option
                  ><option>Hydraulic Pump</option><option
                    >Hydraulic Pump Part</option
                  ><option>Hydraulic Cylinder</option><option>Other</option
                  ></select
                ></label
              >
              <label
                >Quantity *<input
                  name="quantity"
                  placeholder="e.g. 2 pcs"
                  required
                /></label
              >
              <label
                >Required Delivery Date<input
                  name="deadline"
                  type="date"
                /></label
              >
            </div>
          </fieldset>
          <fieldset>
            <legend>Technical information</legend>
            <div class="hm-rfq-grid">
              <label
                >Working Pressure<input
                  name="working_pressure"
                  placeholder="bar / MPa"
                /></label
              >
              <label
                >Flow or Displacement<input name="flow_displacement" /></label
              >
              <label
                >Voltage and Connector<input name="voltage_connector" /></label
              >
              <label
                >Mounting and Port Details<input name="mounting_ports" /></label
              >
              <label>Rotation and Shaft<input name="rotation_shaft" /></label>
              <label
                >Fluid and Temperature<input name="fluid_temperature" /></label
              >
              <label class="hm-rfq-full"
                >Machine / Application<textarea name="application" rows="3"
                ></textarea></label
              >
              <label class="hm-rfq-full"
                >Known Failure or Replacement Reason<textarea
                  name="replacement_reason"
                  rows="3"></textarea></label
              >
            </div>
          </fieldset>
          <fieldset>
            <legend>Files and message</legend>
            <div class="hm-rfq-grid">
              <label class="hm-rfq-full hm-file-label"
                >Upload nameplates, product photos, drawings, datasheets or an
                RFQ list
                <input
                  name="attachments"
                  type="file"
                  accept=".jpg,.jpeg,.png,.webp,.pdf,.xls,.xlsx,.doc,.docx,.csv,.zip"
                  multiple
                />
                <span
                  >Up to 5 files. JPG, PNG, WebP, PDF, Excel, Word, CSV or ZIP;
                  maximum 5 MB per file and 20 MB combined.</span
                >
              </label>
              <label class="hm-rfq-full"
                >Additional Message<textarea
                  name="details"
                  rows="4"
                  placeholder="Add technical, commercial, packing or inspection requirements."
                ></textarea></label
              >
            </div>
          </fieldset>
          <input
            type="hidden"
            name="source"
            value={isContact
              ? "Hydraulic Match contact page"
              : "Hydraulic Match complete RFQ"}
          />
          <input type="hidden" name="message" />
          <div class="hp-field" aria-hidden="true">
            <label
              >Leave empty<input
                name="website"
                tabindex="-1"
                autocomplete="off"
              /></label>
          </div>
          <div class="hm-rfq-submit">
            <button type="submit">Send Match Request</button>
            <p>
              Response timing depends on inquiry completeness, supplier
              confirmation and time zone. A quotation is not a compatibility
              guarantee until the required technical confirmation is complete.
            </p>
          </div>
          <div class="form-result" aria-live="polite"></div>
        </form>
      </div>
      <aside>
        <div class="hm-rfq__aside-card hm-rfq__aside-card--dark">
          <p class="hm-kicker">WHAT HAPPENS NEXT</p>
          <ol>
            {
              steps.map((step, index) => (
                <li>
                  <>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <div>
                      <>
                        <strong>{step.name}</strong>
                        <p>{step.text}</p>
                      </>
                    </div>
                  </>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="hm-rfq__aside-card">
          <h3>Minimum useful information</h3>
          <ul>
            <li>Original brand</li><li>Complete model code</li><li>
              Quantity
            </li><li>Destination country</li><li>Nameplate or photos</li>
          </ul>
        </div>
        <div class="hm-rfq__aside-card">
          <h3>Prefer email?</h3>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <p>
            Attach the same model, quantity, destination and technical files.
          </p>
        </div>
      </aside>
    </div>
  </section>
  {
    !isContact && (
      <section class="hm-rfq-guidance">
        <div class="container">
          <header>
            <p class="hm-kicker">BEFORE YOU SUBMIT</p>
            <h2>What a responsible quotation should make visible.</h2>
            <p>
              A submitted form starts a review; it does not create a supply
              commitment. The response should separate confirmed facts from
              assumptions and open questions.
            </p>
          </header>
          <div class="hm-rfq-guidance__grid">
            <article>
              <>
                <strong>Original reference</strong>
                <p>
                  The manufacturer, complete code and source files used for
                  identification.
                </p>
              </>
            </article>
            <article>
              <>
                <strong>Offered route</strong>
                <p>
                  The proposed manufacturer or supply condition, rather than an
                  ambiguous “replacement” label.
                </p>
              </>
            </article>
            <article>
              <>
                <strong>Technical status</strong>
                <p>
                  Matched fields, known differences and confirmations still
                  required before release.
                </p>
              </>
            </article>
            <article>
              <>
                <strong>Commercial scope</strong>
                <p>
                  Price, MOQ, lead time, warranty, inspection, packing, Incoterm
                  and quote validity.
                </p>
              </>
            </article>
          </div>
          <div class="hm-rfq-guidance__boundary">
            <div>
              <strong>Possible response states</strong>
              <p>
                Ready to quote, technical clarification required, conditional
                candidate, or no responsible supply route.
              </p>
            </div>
            <div>
              <strong>File and privacy boundary</strong>
              <p>
                Upload only files you are authorized to share. Inquiry files may
                be reviewed with relevant suppliers for quotation and
                verification as described in the{" "}
                <a href="/privacy/">privacy policy</a>.
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }
  {
    isContact && (
      <section
        class="hm-contact-details"
        aria-labelledby="contact-details-heading"
      >
        <div class="container">
          <header>
            <p class="hm-kicker">DIRECT CONTACT</p>
            <h2 id="contact-details-heading">
              Contact our hydraulic sourcing team.
            </h2>
            <p>
              Use email, phone or WhatsApp for inventory checks, direct
              replacement review, warranty questions and urgent hydraulic
              requirements.
            </p>
          </header>
          <div class="hm-contact-details__grid">
            <article>
              <span>EMAIL</span>
              <h3>Sales and technical inquiries</h3>
              <a href={`mailto:${site.email}`}>{site.email}</a>
              <p>
                Attach the complete model code, nameplate, quantity and
                destination.
              </p>
            </article>
            <article>
              <span>PHONE &amp; WHATSAPP</span>
              <h3>Fast commercial communication</h3>
              <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>
              <a href={whatsappHref} target="_blank" rel="noopener noreferrer">
                Open WhatsApp
              </a>
            </article>
            <article>
              <span>SUPPLY OFFICE</span>
              <h3>China hydraulic sourcing</h3>
              <p>
                Inventory coordination, supplier qualification, supply-route
                review, inspection, export packing and international shipping
                support.
              </p>
              <a href="/about/">About Hydraulic Match</a>
            </article>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  const rfqForm = document.querySelector<HTMLFormElement>(
    "#hydraulic-rfq-form",
  );
  if (rfqForm) {
    const params = new URLSearchParams(window.location.search);
    ["brand", "model"].forEach((name) => {
      const value = params.get(name);
      const field = rfqForm.querySelector<HTMLInputElement>(
        `input[name="${name}"]`,
      );
      if (value && field) field.value = value;
    });
    const source = params.get("source");
    const sourceField = rfqForm.querySelector<HTMLInputElement>(
      'input[name="source"]',
    );
    if (source && sourceField) sourceField.value = source;
  }
  rfqForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const result = rfqForm.querySelector<HTMLElement>(".form-result");
    const submit = rfqForm.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    const data = new FormData(rfqForm);
    const attachments = data
      .getAll("attachments")
      .filter((entry) => entry instanceof File && entry.size > 0) as File[];
    const model = data.get("model")?.toString().trim() ?? "";
    const fileError =
      attachments.length > 5
        ? "Please upload no more than 5 files."
        : attachments.some((file) => file.size > 5 * 1024 * 1024)
          ? "Each file must be 5 MB or smaller."
          : attachments.reduce((total, file) => total + file.size, 0) >
              20 * 1024 * 1024
            ? "The combined attachment size must be 20 MB or smaller."
            : !model && attachments.length === 0
              ? "Enter the full model code or upload at least one clear reference file."
              : "";
    if (fileError) {
      if (result) {
        result.className = "form-result is-visible is-error";
        result.textContent = fileError;
      }
      return;
    }
    const lines = [
      `Original manufacturer: ${data.get("brand")}`,
      `Full model code: ${model || "See attachment"}`,
      `Order / part number: ${data.get("part_number") || "-"}`,
      `Product type: ${data.get("product_type") || "-"}`,
      `Quantity: ${data.get("quantity")}`,
      `Required delivery date: ${data.get("deadline") || "-"}`,
      "",
      `Working pressure: ${data.get("working_pressure") || "-"}`,
      `Flow / displacement: ${data.get("flow_displacement") || "-"}`,
      `Voltage / connector: ${data.get("voltage_connector") || "-"}`,
      `Mounting / ports: ${data.get("mounting_ports") || "-"}`,
      `Rotation / shaft: ${data.get("rotation_shaft") || "-"}`,
      `Fluid / temperature: ${data.get("fluid_temperature") || "-"}`,
      `Machine / application: ${data.get("application") || "-"}`,
      `Failure / replacement reason: ${data.get("replacement_reason") || "-"}`,
      "",
      `Additional message: ${data.get("details") || "-"}`,
    ];
    data.set("message", lines.join("\n"));
    submit?.setAttribute("disabled", "true");
    if (submit) submit.textContent = "Sending...";
    try {
      const response = await fetch(rfqForm.dataset.endpoint ?? "/api/rfq/", {
        method: "POST",
        body: data,
        headers: { Accept: "application/json" },
      });
      if (!response.ok) throw new Error("Request failed");
      window.location.href = "/thank-you/?source=rfq";
    } catch {
      if (result) {
        result.className = "form-result is-visible is-error";
        result.innerHTML = `<strong>The form could not be sent.</strong> Please email <a href="mailto:${rfqForm.dataset.fallbackEmail}">${rfqForm.dataset.fallbackEmail}</a> with your files.`;
      }
      submit?.removeAttribute("disabled");
      if (submit) submit.textContent = "Send Match Request";
    }
  });
</script>

<style>
  .hm-rfq {
    padding: 80px 0 100px;
    background: #f5f7fa;
  }
  .hm-rfq__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 28px;
    align-items: start;
  }
  .hm-rfq__form-card {
    background: #fff;
    border: 1px solid var(--color-stroke);
    padding: 38px;
  }
  .hm-rfq__form-card header {
    max-width: 760px;
    margin-bottom: 36px;
  }
  .hm-kicker {
    color: var(--color-primary);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.13em;
  }
  .hm-rfq__form-card h2 {
    margin: 10px 0;
  }
  .hm-rfq__form-card header p:last-child {
    color: #596575;
  }
  .hm-rfq-form {
    display: grid;
    gap: 30px;
  }
  .hm-rfq-form fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .hm-rfq-form legend {
    width: 100%;
    padding: 0 0 12px;
    border-bottom: 1px solid var(--color-stroke);
    font: 600 20px var(--font-title);
    margin-bottom: 20px;
  }
  .hm-rfq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .hm-rfq-form label {
    display: grid;
    gap: 8px;
    color: #2b333d;
    font-size: 14px;
    font-weight: 600;
  }
  .hm-rfq-form input,
  .hm-rfq-form select,
  .hm-rfq-form textarea {
    width: 100%;
    min-height: 50px;
    padding: 12px 13px;
    border: 1px solid #d5dbe4;
    background: #fbfcfd;
    color: var(--color-title);
    font: 400 15px var(--font-primary);
  }
  .hm-rfq-form textarea {
    resize: vertical;
  }
  .hm-rfq-form input:focus-visible,
  .hm-rfq-form select:focus-visible,
  .hm-rfq-form textarea:focus-visible {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(20, 110, 245, 0.14);
  }
  .hm-rfq-full {
    grid-column: 1/-1;
  }
  .hm-file-label {
    padding: 18px;
    border: 1px dashed #aeb8c5;
    background: #f7f9fc;
  }
  .hm-file-label input {
    border: 0;
    background: transparent;
    padding: 6px 0;
    min-height: auto;
  }
  .hm-file-label span {
    color: #6b7480;
    font-size: 12px;
    font-weight: 400;
  }
  .hm-rfq-submit {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .hm-rfq-submit button {
    min-width: 220px;
    min-height: 54px;
    border: 0;
    background: var(--color-primary);
    color: #fff;
    font: 600 16px var(--font-title);
    cursor: pointer;
  }
  .hm-rfq-submit button:focus-visible {
    outline: 3px solid rgba(20, 110, 245, 0.35);
    outline-offset: 3px;
  }
  .hm-rfq-submit button:disabled {
    opacity: 0.65;
    cursor: wait;
  }
  .hm-rfq-submit p {
    margin: 0;
    color: #687280;
    font-size: 12px;
    line-height: 1.5;
  }
  .hp-field {
    position: absolute;
    left: -9999px;
  }
  .hm-rfq aside {
    display: grid;
    gap: 16px;
  }
  .hm-rfq__aside-card {
    padding: 26px;
    background: #fff;
    border: 1px solid var(--color-stroke);
  }
  .hm-rfq__aside-card h3 {
    margin-top: 0;
  }
  .hm-rfq__aside-card ul {
    padding-left: 20px;
  }
  .hm-rfq__aside-card li,
  .hm-rfq__aside-card p {
    font-size: 14px;
    line-height: 1.6;
    color: #596575;
  }
  .hm-rfq__aside-card a {
    color: var(--color-primary);
    font-weight: 600;
  }
  .hm-rfq__aside-card--dark {
    background: var(--color-title);
    border: 0;
    color: #fff;
  }
  .hm-rfq__aside-card--dark ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .hm-rfq__aside-card--dark li {
    display: flex;
    gap: 14px;
    padding: 18px 0;
    border-bottom: 1px solid #303743;
  }
  .hm-rfq__aside-card--dark li:last-child {
    border: 0;
  }
  .hm-rfq__aside-card--dark li > span {
    color: #75aaff;
    font: 600 12px var(--font-title);
  }
  .hm-rfq__aside-card--dark strong {
    color: #fff;
  }
  .hm-rfq__aside-card--dark p {
    color: #adb6c3;
    margin: 5px 0 0;
  }
  .form-result {
    grid-column: 1/-1;
  }
  @media (max-width: 991px) {
    .hm-rfq__layout {
      grid-template-columns: 1fr;
    }
    .hm-rfq aside {
      grid-template-columns: 1fr 1fr;
    }
    .hm-rfq__aside-card--dark {
      grid-column: 1/-1;
    }
  }
  @media (max-width: 600px) {
    .hm-rfq-grid {
      grid-template-columns: 1fr;
    }
    .hm-rfq-full {
      grid-column: auto;
    }
    .hm-rfq__form-card {
      padding: 22px;
    }
    .hm-rfq-submit {
      align-items: flex-start;
      flex-direction: column;
    }
    .hm-rfq-submit button {
      width: 100%;
    }
    .hm-rfq aside {
      grid-template-columns: 1fr;
    }
    .hm-rfq {
      padding: 60px 0;
    }
  }
  .hm-contact-details {
    padding: 80px 0 100px;
    background: #fff;
  }
  .hm-contact-details header {
    max-width: 820px;
    margin-bottom: 30px;
  }
  .hm-contact-details header h2 {
    margin: 10px 0 12px;
    font-size: 38px;
    text-transform: none;
  }
  .hm-contact-details header > p:last-child {
    color: #596575;
    line-height: 1.7;
  }
  .hm-contact-details__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-stroke);
    border-left: 1px solid var(--color-stroke);
  }
  .hm-contact-details__grid article {
    min-height: 250px;
    padding: 30px;
    border-right: 1px solid var(--color-stroke);
    border-bottom: 1px solid var(--color-stroke);
  }
  .hm-contact-details__grid article > span {
    color: var(--color-primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .hm-contact-details__grid h3 {
    margin: 42px 0 14px;
    font-size: 22px;
    text-transform: none;
  }
  .hm-contact-details__grid a {
    display: block;
    width: max-content;
    max-width: 100%;
    margin-top: 8px;
    color: var(--color-primary);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .hm-contact-details__grid p {
    color: #596575;
    line-height: 1.65;
  }
  .hm-contact-details__grid a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  @media (max-width: 800px) {
    .hm-contact-details__grid {
      grid-template-columns: 1fr;
    }
    .hm-contact-details header h2 {
      font-size: 31px;
    }
  }
  .hm-rfq-guidance {
    padding: 76px 0 90px;
    background: #fff;
  }
  .hm-rfq-guidance header {
    max-width: 850px;
    margin-bottom: 26px;
  }
  .hm-rfq-guidance h2 {
    margin: 8px 0 12px;
    font-size: 36px;
    text-transform: none;
  }
  .hm-rfq-guidance header > p:last-child,
