---
import { site } from '../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const isActive = (path: string) => currentPath === path || (path !== '/' && currentPath.startsWith(path));
const productsActive = isActive('/products');
const alternativesActive = isActive('/alternatives') || isActive('/cross-reference');
const resourcesActive = isActive('/resources');
---

<header class="header">
  <div class="container">
    <nav class="navbar" aria-label="Main navigation">
      <div class="navbar-wrapper">
        <a href="/" class="navbar-brand hydraulic-wordmark" aria-label="Hydraulic Match home">
          <span class="hydraulic-wordmark__mark" aria-hidden="true">HM</span>
          <span class="hydraulic-wordmark__text">
            <strong>HYDRAULIC</strong>
            <span>MATCH</span>
          </span>
        </a>

        <div class="nav-menu-block" id="nav-menu">
          <div class="nav-mobile-brand">
            <a href="/" class="navbar-brand hydraulic-wordmark" aria-label="Hydraulic Match home">
              <span class="hydraulic-wordmark__mark" aria-hidden="true">HM</span>
              <span class="hydraulic-wordmark__text"><strong>HYDRAULIC</strong><span>MATCH</span></span>
            </a>
            <button class="nav-close-btn" aria-label="Close menu" id="nav-close">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
              </svg>
            </button>
          </div>

          <ul class="nav-menu">
            <li class="nav-menu-list nav-desktop-hide">
              <div class="nav-menu-link-wrapper">
                <a href="/" class:list={['nav-menu-link', { active: isActive('/') }]}>Home</a>
                <div class="nav-link-line-shape"></div>
              </div>
            </li>

            <li class="nav-menu-list">
              <div class="nav-dropdown">
                <button class="nav-dropdown-toggle" aria-expanded="false" aria-haspopup="true">
                  <span class:list={['nav-menu-link', { active: productsActive }]}>Products</span>
                  <svg class="nav-dropdown-icon" width="14" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true">
                    <path d="M13 1S8.581 7 7 7 1 1 1 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  <div class="nav-link-line-shape"></div>
                </button>
                <div class="nav-dropdown-list nav-dropdown-list--grid">
                  <div class="nav-dropdown-panel">
                    <a href="/products/hydraulic-valves/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">Hydraulic Valves</span></a>
                    <a href="/products/hydraulic-valves/solenoid-directional-valves/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">Directional Valves</span></a>
                    <a href="/products/hydraulic-valves/pressure-control-valves/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">Pressure Control Valves</span></a>
                    <a href="/products/hydraulic-valves/modular-valves/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">Modular Valves</span></a>
                    <a href="/products/hydraulic-pumps/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">Hydraulic Pumps</span></a>
                    <a href="/products/hydraulic-pumps/axial-piston-pumps/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">Axial Piston Pumps</span></a>
                    <a href="/products/hydraulic-cylinders/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">Hydraulic Cylinders</span></a>
                    <a href="/products/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">All Product Categories</span></a>
                  </div>
                </div>
              </div>
            </li>

            <li class="nav-menu-list">
              <div class="nav-dropdown">
                <button class="nav-dropdown-toggle" aria-expanded="false" aria-haspopup="true">
                  <span class:list={['nav-menu-link', { active: alternativesActive }]}>Alternatives</span>
                  <svg class="nav-dropdown-icon" width="14" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true">
                    <path d="M13 1S8.581 7 7 7 1 1 1 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  <div class="nav-link-line-shape"></div>
                </button>
                <div class="nav-dropdown-list">
                  <div class="nav-dropdown-panel">
                    <a href="/alternatives/rexroth/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">Bosch Rexroth Alternatives</span></a>
                    <a href="/alternatives/rexroth/4we6/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">4WE6 Valve Alternatives</span></a>
                    <a href="/alternatives/rexroth/a10vso/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">A10VSO Pump Options</span></a>
                    <a href="/alternatives/vickers/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">Eaton / Vickers Alternatives</span></a>
                    <a href="/alternatives/parker/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">Parker Alternatives</span></a>
                  </div>
                </div>
              </div>
            </li>

            <li class="nav-menu-list">
              <div class="nav-menu-link-wrapper">
                <a href="/matching-process/" class:list={['nav-menu-link', { active: isActive('/matching-process') }]}>How It Works</a>
                <div class="nav-link-line-shape"></div>
              </div>
            </li>

            <li class="nav-menu-list">
              <div class="nav-dropdown">
                <button class="nav-dropdown-toggle" aria-expanded="false" aria-haspopup="true">
                  <span class:list={['nav-menu-link', { active: resourcesActive }]}>Resources</span>
                  <svg class="nav-dropdown-icon" width="14" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true">
                    <path d="M13 1S8.581 7 7 7 1 1 1 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  <div class="nav-link-line-shape"></div>
                </button>
                <div class="nav-dropdown-list">
                  <div class="nav-dropdown-panel">
                    <a href="/resources/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">Technical Guides</span></a>
                    <a href="/quality/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">Quality & Verification</span></a>
                    <a href="/distributor-support/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">Distributor Support</span></a>
                    <a href="/about/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">About Hydraulic Match</span></a>
                  </div>
                </div>
              </div>
            </li>
          </ul>
        </div>

        <div class="contact-number-block">
          <a href="/request-a-quote/" class:list={['nav-menu-link', 'nav-menu-link--cta', { active: isActive('/request-a-quote') || isActive('/contact') }]}>Request a Match</a>
          <a href={`mailto:${site.email}`} class="contact-number-block contact-number-block--compact" aria-label={`Email ${site.email}`}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16v12H4V6Z" stroke="currentColor" stroke-width="1.7"></path><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.7"></path></svg>
          </a>
        </div>

        <button class="menu-button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu" id="nav-open">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>
  </div>
</header>

<style>
  .hydraulic-wordmark { display:flex; align-items:center; gap:10px; text-decoration:none; width:max-content; }
  .hydraulic-wordmark__mark { display:grid; place-items:center; width:42px; height:42px; border:2px solid var(--color-title); border-radius:50%; color:var(--color-primary); font:600 14px/1 var(--font-title); letter-spacing:-.04em; position:relative; }
  .hydraulic-wordmark__mark::after { content:""; position:absolute; inset:5px; border:2px solid var(--color-primary); border-left-color:transparent; border-radius:50%; }
  .hydraulic-wordmark__text { display:flex; flex-direction:column; font:600 16px/0.95 var(--font-title); letter-spacing:.08em; color:var(--color-title); }
  .hydraulic-wordmark__text span { color:var(--color-primary); letter-spacing:.2em; font-size:11px; margin-top:5px; }
  @media (max-width:479px) { .hydraulic-wordmark__text { font-size:14px; } }
</style>
