---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="The requested Hydraulic Match page was not found." noindex hideFloatingCta>
  <section class="hm-404"><div class="container"><p>404</p><h1>We could not find that page.</h1><span>Search by product category or send the model code and nameplate for identification help.</span><div><a href="/products/" class="secondary-button"><span class="button-text">Browse Products</span></a><a href="/request-a-quote/" class="primary-button"><span class="button-text">Request a Match</span></a></div></div></section>
</BaseLayout>
<style>.hm-404{padding:130px 0;text-align:center;background:#f5f7fa}.hm-404 p{color:var(--color-primary);font:600 18px var(--font-title)}.hm-404 h1{margin:12px 0}.hm-404>div>span{display:block;color:#596575;margin-bottom:32px}.hm-404>div>div{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}</style>
