---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import { hydraulicPages } from '../../data/hydraulic-pages';
import { breadcrumbSchema, itemListSchema, site } from '../../data/site';

const guides = hydraulicPages.filter((page) => page.slug.startsWith('resources/'));
---
<BaseLayout
  title="Hydraulic Model Code and Replacement Guides"
  description="Practical hydraulic valve, pump and cylinder identification, selection and replacement guides for distributors, repair shops and MRO buyers."
  currentPath="/resources"
  jsonLd={[
    breadcrumbSchema([{ name: 'Home', url: site.url }, { name: 'Resources', url: `${site.url}/resources/` }]),
    itemListSchema(guides.map((guide) => ({ name: guide.title, url: `${site.url}/${guide.slug}/` }))),
  ]}
>
  <BreadcrumbHero title="Hydraulic Technical Guides" trail={[{ label: 'Home', href: '/' }, { label: 'Resources' }]} variant="3" />
  <section class="hm-guides">
    <div class="container">
      <header>
        <p>MODEL CODES · IDENTIFICATION · REPLACEMENT</p>
        <h2>Guides for preparing a safer hydraulic component RFQ</h2>
        <span>Each guide addresses a real purchasing question and links back to the relevant product and quotation workflow.</span>
      </header>
      <div class="hm-guides__grid">
        {guides.map((guide, index) => (
          <a href={`/${guide.slug}/`}>
            <span class="hm-guides__num">{String(index + 1).padStart(2, '0')}</span>
            <p>{guide.kicker}</p>
            <h2>{guide.title}</h2>
            <span class="hm-guides__desc">{guide.description}</span>
            <strong>Read guide →</strong>
          </a>
        ))}
      </div>
      <div class="hm-guides__cta"><div><h2>Need help identifying a part?</h2><p>Upload the nameplate or product photo. We will identify the missing information.</p></div><a href="/request-a-quote/" class="primary-button"><span class="button-text">Request Identification Help</span></a></div>
    </div>
  </section>
</BaseLayout>
<style>
  .hm-guides{padding:85px 0 100px;background:#f7f8fa}.hm-guides header{max-width:840px;margin-bottom:45px}.hm-guides header>p{color:var(--color-primary);font-size:12px;font-weight:600;letter-spacing:.13em}.hm-guides header h2{margin:12px 0}.hm-guides header>span{color:#596575}.hm-guides__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.hm-guides__grid>a{display:flex;flex-direction:column;min-height:360px;padding:28px;background:#fff;border:1px solid var(--color-stroke);color:inherit;text-decoration:none;cursor:pointer;transition:border-color .2s,box-shadow .2s,transform .2s}.hm-guides__grid>a:hover{border-color:var(--color-primary);box-shadow:0 12px 32px rgba(15,23,42,.08);transform:translateY(-2px)}.hm-guides__num{color:var(--color-primary);font:600 12px var(--font-title)}.hm-guides__grid p{font-size:11px;letter-spacing:.1em;color:#667181;margin:44px 0 12px}.hm-guides__grid h2{font-size:24px;margin:0 0 14px}.hm-guides__desc{font-size:14px;line-height:1.6;color:#596575}.hm-guides__grid strong{margin-top:auto;color:var(--color-primary);font-size:14px}.hm-guides__cta{display:flex;align-items:center;justify-content:space-between;gap:30px;margin-top:28px;padding:32px;background:#dce9fa}.hm-guides__cta h2{margin:0 0 7px;font-size:25px}.hm-guides__cta p{margin:0;font-size:15px;color:#536071}@media(max-width:991px){.hm-guides__grid{grid-template-columns:1fr 1fr}}@media(max-width:600px){.hm-guides__grid{grid-template-columns:1fr}.hm-guides__cta{align-items:flex-start;flex-direction:column}.hm-guides{padding:65px 0}}@media(prefers-reduced-motion:reduce){.hm-guides__grid>a{transition:none}.hm-guides__grid>a:hover{transform:none}}
</style>
