---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbHero from "../../components/BreadcrumbHero.astro";
import DetailPageShell from "../../components/DetailPageShell.astro";
import DetailRfqStrip from "../../components/DetailRfqStrip.astro";
import HydraulicProductSidebar from "../../components/HydraulicProductSidebar.astro";
import {
  modelRecords,
  modelSearchIntent,
} from "../../data/model-records";
import { seriesRecords } from "../../data/series-records";
import { articleSchema, breadcrumbSchema, site } from "../../data/site";
import "../../styles/resource-page.css";

export function getStaticPaths() {
  return modelRecords.map((record) => ({
    params: { slug: record.slug },
    props: { record },
  }));
}

const { record } = Astro.props;
const pageUrl = `${site.url}/models/${record.slug}/`;
const seriesContext = seriesRecords.find(
  (item) => item.series === record.series,
);
const quoteHref = `/contact/?source=model-${record.slug}&brand=${encodeURIComponent(record.brand)}&model=${encodeURIComponent(record.model)}`;
const searchIntent = modelSearchIntent(record);
const seoTitle = searchIntent.title;
const h1Title = searchIntent.heading;
const isD1vw020 = record.slug === "parker-d1vw020bnjw";
const reviewer = site.technicalReviewer;
const hasNamedReviewer = Boolean(reviewer.name && reviewer.jobTitle);
const seoDescription =
  searchIntent.level === "identification-reviewed"
    ? `${record.brand} ${record.model} specifications and identification record covering the exact code, source basis and application evidence required before replacement sourcing.`
    : searchIntent.level === "catalog-reference"
      ? `${record.brand} ${record.model} external catalog reference retained for sourcing research and requiring independent technical and commercial confirmation.`
      : record.description;
const isRotatingUnit =
  record.productType.toLowerCase().includes("pump") ||
  record.productType.toLowerCase().includes("motor");
const unresolvedParameterRows = isRotatingUnit
  ? [
      {
        label: "Displacement",
        value: "Confirm for the exact code",
        basis: "Do not infer from the series name",
      },
      {
        label: "Pressure",
        value: "Working and peak pressure required",
        basis: "Application and exact datasheet review",
      },
      {
        label: "Rotation",
        value: "Confirm viewed from the shaft end",
        basis: "Nameplate, code and installation review",
      },
      {
        label: "Mounting / shaft / ports",
        value: "Drawing comparison required",
        basis: "Exact offered-unit drawing",
      },
    ]
  : [
      {
        label: "Pressure and flow",
        value: "Confirm for the exact code and circuit",
        basis: "Exact datasheet and application review",
      },
      {
        label: "Function",
        value: "Confirm spool, position or control function",
        basis: "Model code and hydraulic schematic",
      },
      {
        label: "Electrical configuration",
        value: "Confirm voltage, connector and duty where applicable",
        basis: "Nameplate and exact datasheet",
      },
      {
        label: "Mounting / ports",
        value: "Interface comparison required",
        basis: "Exact offered-unit drawing",
      },
    ];
const procurementSpecs = record.procurementSpecs ?? [
  {
    label: "Original model",
    value: record.model,
    basis: record.sourceLabel,
  },
  ...(record.materialNumber
    ? [
        {
          label: "Material / part number",
          value: record.materialNumber,
          basis: record.sourceLabel,
        },
      ]
    : []),
  {
    label: "Brand reference",
    value: record.brand,
    basis: "Published source record",
  },
  {
    label: "Series",
    value: record.series,
    basis: "Model-code identification",
  },
  {
    label: "Product type",
    value: record.productType,
    basis: "Published source record",
  },
  ...unresolvedParameterRows,
];
const inquiryFields = record.inquiryFields ?? record.requiredChecks;
const usesRepresentativeFamilyImage =
  record.image.startsWith("/images/hydraulic/");
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  currentPath="/alternatives"
  image={record.image}
  jsonLd={[
    breadcrumbSchema([
      { name: "Home", url: site.url },
      { name: "Model Records", url: `${site.url}/models/` },
      { name: record.model, url: pageUrl },
    ]),
    articleSchema({
      title: `${record.brand} ${record.model} identification review`,
      description: record.description,
      url: pageUrl,
      image: `${site.url}${record.image}`,
      authorName: hasNamedReviewer
        ? reviewer.name
        : "Hydraulic Match Editorial Review",
      authorUrl: `${site.url}/authors/technical-review-team/`,
      authorJobTitle: hasNamedReviewer ? reviewer.jobTitle : undefined,
      authorSameAs:
        hasNamedReviewer && reviewer.linkedin ? [reviewer.linkedin] : undefined,
      authorType: hasNamedReviewer ? "Person" : "Organization",
    }),
  ]}
>
  <BreadcrumbHero
    title={h1Title}
    trail={[
      { label: "Home", href: "/" },
      { label: "Model Records", href: "/models/" },
      { label: record.model },
    ]}
    variant={record.productType.includes("pump") ? "3" : "2"}
  />
  <DetailPageShell intro={seoDescription}>
    <img
      slot="hero"
      src={record.image}
      alt={`${record.brand} ${record.model} hydraulic ${record.productType} reference family`}
      width="1200"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <div class="resource-meta">
      <span><strong>Brand reference</strong> {record.brand}</span>
      <span><strong>Series</strong> {record.series}</span>
      <span><strong>Product</strong> {record.productType}</span>
      <span
        ><strong>Alternative</strong>
        {record.alternativeReview?.status ?? "No public alternative"}</span
      >
      <span><strong>Record maturity</strong> {searchIntent.label}</span>
    </div>
    {
      usesRepresentativeFamilyImage && (
        <p class="model-media-boundary">
          <strong>Image scope:</strong> this is a representative product-family
          image, not evidence of the exact model, current stock or offered unit.
          Exact-item photos should be requested with the quotation.
        </p>
      )
    }

    <section class="procurement-panel" aria-labelledby="procurement-heading">
      <div class="procurement-panel__heading">
        <p>PROCUREMENT SUMMARY</p>
        <h2 id="procurement-heading">
          {record.model} replacement inquiry data
        </h2>
        <span>
          Values below are tied to the cited record. Blank replacement fields
          are an invitation to review—not proof that a similar suffix will fit.
        </span>
      </div>
      <div class="resource-table-wrap">
        <table class="resource-table procurement-table">
          <thead>
            <tr>
              <th scope="col">Parameter</th>
              <th scope="col">Original reference</th>
              <th scope="col">Evidence basis</th>
            </tr>
          </thead>
          <tbody>
            {
              procurementSpecs.map((spec) => (
                <tr>
                  <th scope="row">{spec.label}</th>
                  <td>{spec.value}</td>
                  <td>{spec.basis}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="procurement-panel__source">
        Source: <a
          href={record.sourceUrl}
          target="_blank"
          rel="noopener noreferrer">{record.sourceLabel}</a
        >
      </p>
      {
        (record.sourceDocument ||
          record.sourceRevision ||
          record.sourceReviewedAt) && (
          <dl class="source-record-meta">
            {record.sourceDocument && (
              <div>
                <dt>Document</dt>
                <dd>{record.sourceDocument}</dd>
              </div>
            )}
            {record.sourceRevision && (
              <div>
                <dt>Revision</dt>
                <dd>{record.sourceRevision}</dd>
              </div>
            )}
            {record.sourceReviewedAt && (
              <div>
                <dt>Source reviewed</dt>
                <dd>{record.sourceReviewedAt}</dd>
              </div>
            )}
          </dl>
        )
      }
    </section>

    <section
      class="replacement-comparison"
      aria-labelledby="comparison-heading"
    >
      <p>MODEL COMPARISON</p>
      <h2 id="comparison-heading">
        {
          searchIntent.level === "comparison-ready" ||
          searchIntent.level === "verified-case"
            ? "Original model and proposed replacement"
            : `Replacement status for ${record.model}`
        }
      </h2>
      <div class="resource-table-wrap">
        <table class="resource-table">
          <thead>
            <tr>
              <th scope="col">Decision field</th>
              <th scope="col">Original</th>
              <th scope="col">Proposed replacement</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Model</th>
              <td>{record.model}</td>
              <td>
                {record.alternativeReview?.proposedModel ?? "Not yet published"}
              </td>
            </tr>
            <tr>
              <th scope="row">Relationship</th>
              <td>Reference to be replaced</td>
              <td>{record.alternativeReview?.status}</td>
            </tr>
            <tr>
              <th scope="row">Technical position</th>
              <td>{record.originalReference}</td>
              <td>{record.alternativeReview?.note}</td>
            </tr>
            <tr>
              <th scope="row">Order status</th>
              <td>Identification supported by cited source</td>
              <td>Quotation and interface approval required</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="model-application">
      <div>
        <p>COMPATIBLE APPLICATION</p>
        <h2>Where the {record.model} configuration may be relevant</h2>
        <p>
          {
            record.compatibleApplication ??
              `Applications associated with the ${record.series} family include ${record.applications.join(", ")}. The exact machine, circuit, operating data and interfaces still control replacement approval.`
          }
        </p>
      </div>
      <aside>
        <h3>Send these details with the inquiry</h3>
        <ul>
          {inquiryFields.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </section>

    {
      seriesContext && (
        <section class="model-series-context">
          <p>IDENTIFICATION CONTEXT</p>
          <h2>{record.series} series context for this model</h2>
          <p>{seriesContext.summary}</p>
          <ul class="resource-list">
            {seriesContext.reviewFocus.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <p>
            The {record.model} record sits inside the {record.series} series
            identification hub, which documents the series scope, model-code
            evidence and configuration fields used before a quotation.
          </p>
          <a href={`/series/${seriesContext.slug}/`} class="model-series-link">
            Open the {record.series} series identification hub
          </a>
        </section>
      )
    }

    {
      record.replacementCase ? (
        <section class="replacement-case">
          <p>DOCUMENTED REPLACEMENT CASE</p>
          <h2>{record.replacementCase.title}</h2>
          <dl>
            <div>
              <dt>Original model</dt>
              <dd>{record.replacementCase.originalModel}</dd>
            </div>
            <div>
              <dt>Replacement model</dt>
              <dd>{record.replacementCase.replacementModel}</dd>
            </div>
            <div>
              <dt>Application</dt>
              <dd>{record.replacementCase.application}</dd>
            </div>
            <div>
              <dt>Verification</dt>
              <dd>{record.replacementCase.verification}</dd>
            </div>
            <div>
              <dt>Outcome</dt>
              <dd>{record.replacementCase.outcome}</dd>
            </div>
          </dl>
          <p>{record.replacementCase.disclosure}</p>
        </section>
      ) : (
        <aside class="resource-note">
          <strong>
            No completed replacement case is published for this exact code.
          </strong>
          A case will be added only when the original model, supplied model,
          application, checked interfaces and outcome can be documented without
          exposing the customer.
        </aside>
      )
    }

    {
      record.knownDifferences?.length ? (
        <section>
          <h2>Known Differences Requiring Approval</h2>
          <ul class="resource-list">
            {record.knownDifferences.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ) : null
    }

    {
      record.incompatibleApplications?.length ? (
        <section>
          <h2>Applications Not Yet Supported</h2>
          <ul class="resource-list">
            {record.incompatibleApplications.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ) : null
    }

    {
      record.evidenceAssets?.length ? (
        <section>
          <h2>Record-Specific Evidence</h2>
          <div class="resource-checklist-grid">
            {record.evidenceAssets.map((asset) => (
              <article class="resource-checklist-card">
                <span>{asset.kind}</span>
                <h3>
                  <a href={asset.url}>{asset.label}</a>
                </h3>
                {asset.disclosure && <p>{asset.disclosure}</p>}
              </article>
            ))}
          </div>
        </section>
      ) : null
    }

    <DetailRfqStrip
      quoteHref={quoteHref}
      title={`Request a ${record.series} replacement review`}
      text={`Send the complete ${record.model} nameplate, application and required quantity. The reply will separate matched parameters, differences, open checks and the proposed supply route.`}
      modalContext={`${record.model} exact model inquiry`}
      modalSource={`model-${record.slug}`}
    />

    <section class="model-summary">
      <p class="model-summary__kicker">MODEL RECORD</p>
      <h2>{record.originalReference}</h2>
      <dl>
        <div><dt>Proposed route</dt><dd>{record.matchedRoute}</dd></div>
        <div>
          <dt>Compatibility status</dt><dd>{record.compatibilityStatus}</dd>
        </div>
        <div><dt>Warranty route</dt><dd>{record.warranty}</dd></div>
      </dl>
      <p>
        {
          record.recordKind === "external-catalog-reference" ||
          record.recordKind === "owned-site-catalog"
            ? record.evidenceNote
            : "This page is an independent identification and sourcing record. It is not an original manufacturer product listing and does not state that an unnamed alternative is compatible."
        }
      </p>
    </section>

    {
      isD1vw020 && (
        <section class="resource-note">
          <h2>D1VW020BNJW purchasing intent</h2>
          <p>
            This record supports exact-code inquiries for the Parker D1VW020BNJW
            directional valve. The quotation confirms spool function, mounting
            interface, pressure and flow, solenoid voltage, connector, exact
            availability, supplier identity, lead time, compatibility status and
            any written warranty scope.
          </p>
          <p>
            Related routes: <a href="/series/d1vw/">D1VW series</a>,{" "}
            <a href="/brands/parker/">Parker hydraulic valves</a> and{" "}
            <a href="/products/hydraulic-valves/solenoid-directional-valves/">
              directional control valves
            </a>
            .
          </p>
        </section>
      )
    }

    {
      record.commercial && (
        <section class="model-commercial" aria-labelledby="commercial-status">
          <div class="model-commercial__heading">
            <p>SOURCE-SITE CATALOG SNAPSHOT</p>
            <h2 id="commercial-status">
              Commercial fields published by the source
            </h2>
            <span>
              These fields come from the cited external catalog. They are not
              Hydraulic Match inventory or a current offer and must be
              reconfirmed.
            </span>
          </div>
          <dl>
            <div>
              <dt>Status</dt>
              <dd>{record.commercial.status} on source record</dd>
            </div>
            <div>
              <dt>Published price</dt>
              <dd>{record.commercial.price ?? "Quotation required"}</dd>
            </div>
            <div>
              <dt>MOQ</dt>
              <dd>{record.commercial.moq}</dd>
            </div>
            <div>
              <dt>Lead time</dt>
              <dd>{record.commercial.leadTime}</dd>
            </div>
            <div>
              <dt>Condition</dt>
              <dd>{record.commercial.condition}</dd>
            </div>
          </dl>
        </section>
      )
    }

    <section>
      <h2>Complete Model-Code Review</h2>
      <div class="resource-table-wrap">
        <table class="resource-table">
          <thead>
            <tr
              ><th scope="col">Code group</th><th scope="col"
                >Reference meaning</th
              ><th scope="col">What we verify</th></tr
            >
          </thead>
          <tbody>
            {
              record.codeGroups.map((group) => (
                <tr>
                  <>
                    <td>
                      <strong>{group.label}</strong>
                    </td>
                    <td>{group.value}</td>
                    <td>{group.review}</td>
                  </>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>Required Evidence Before Candidate Approval</h2>
      <div class="resource-checklist-grid">
        {
          record.requiredChecks.map((item) => (
            <div class="resource-checklist-card">
              <strong>{item}</strong>
            </div>
          ))
        }
      </div>
      <p class="resource-note">
        A public model record does not approve an unnamed replacement. Any
        direct-fit wording must be limited to the exact offered item, recorded
        application and interfaces supported by the quotation evidence.
      </p>
    </section>

    <section class="model-context-grid">
      <article class="resource-checklist-card">
        <h2>Common applications for {record.series} references</h2>
        <ul class="resource-list">
          {record.applications.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="resource-checklist-card">
        <h2>Order Approval Basis</h2>
        <p>
          The physical nameplate, complete model code, confirmed interfaces and
          approved quotation control the final order.
        </p>
        <p>
          Any difference affecting installation or operation is stated before
          order acceptance.
        </p>
      </article>
    </section>

    <p class="resource-related">
      <a href={record.relatedHref}>{record.series} series review</a>
      <span aria-hidden="true">·</span>
      <a href="/models/">All model records</a>
      <span aria-hidden="true">·</span>
      <a href="/matching-process/">Matching process</a>
      <span aria-hidden="true">·</span>
      <a href="/commercial-proof/">Inventory and credentials</a>
    </p>
    <HydraulicProductSidebar
      slot="sidebar"
      activeSlug=""
      quoteHref={quoteHref}
    />
  </DetailPageShell>
</BaseLayout>

<style>
  .procurement-panel {
    overflow: hidden;
    border: 1px solid rgba(20, 110, 245, 0.24);
    background: #fff;
  }
  .model-series-context {
    margin: 36px 0 0;
    padding: 26px;
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-left: 3px solid var(--color-primary);
    border-radius: 12px;
    background: #f8fafc;
  }
  .model-series-context > p:first-child {
    margin: 0 0 8px;
    color: var(--color-primary);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .model-series-context h2 {
    margin: 0 0 12px;
    color: #0f172a;
    font-size: 1.35rem;
  }
  .model-series-context p {
    margin: 0 0 12px;
    color: #334155;
    line-height: 1.7;
  }
  .model-series-context .resource-list {
    margin: 0 0 14px;
    padding-left: 20px;
  }
  .model-series-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
  }
  .model-series-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .procurement-panel__heading {
    padding: 26px;
    color: #fff;
    background: #0f2742;
  }
  .procurement-panel__heading p,
  .replacement-comparison > p,
  .model-application > div > p:first-child,
  .replacement-case > p:first-child {
    margin: 0 0 8px;
    color: #79aef7;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .procurement-panel__heading h2 {
    margin: 0 0 10px;
    color: #fff;
    font-size: clamp(25px, 3vw, 36px);
    text-transform: none;
  }
  .procurement-panel__heading span {
    color: #c5d2e1;
    line-height: 1.65;
  }
  .procurement-table {
    margin: 0;
  }
  .procurement-table th[scope="row"] {
    width: 25%;
    color: #334155;
    background: #f8fafc;
  }
  .procurement-table td:nth-child(2) {
    color: #0f172a;
    font-weight: 700;
  }
  .procurement-panel__source {
    margin: 0;
    padding: 14px 18px;
    border-top: 1px solid var(--color-stroke);
    color: #64748b;
    font-size: 13px;
  }
  .procurement-panel__source a {
    color: var(--color-primary);
    font-weight: 700;
  }
  .source-record-meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    border-top: 1px solid var(--color-stroke);
  }
  .source-record-meta > div {
    padding: 14px 18px;
  }
  .source-record-meta dt {
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .source-record-meta dd {
    margin: 5px 0 0;
    color: var(--color-title);
  }
  .replacement-comparison {
    padding: 26px;
    border: 1px solid var(--color-stroke);
    background: #f7f9fc;
  }
  .replacement-comparison > p,
  .model-application > div > p:first-child,
  .replacement-case > p:first-child {
    color: var(--color-primary);
  }
  .replacement-comparison > h2,
  .model-application h2,
  .replacement-case h2 {
    margin: 0 0 18px;
    text-transform: none;
  }
  .model-application {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 18px;
  }
  .model-application > div,
  .model-application aside {
    padding: 26px;
    border: 1px solid var(--color-stroke);
    background: #fff;
  }
  .model-application > div > p:last-child {
    margin: 0;
    color: #334155;
    line-height: 1.75;
  }
  .model-application aside {
    background: #f1f6fd;
  }
  .model-application h3 {
    margin: 0 0 12px;
    font-size: 18px;
    text-transform: none;
  }
  .model-application ul {
    margin: 0;
    padding-left: 18px;
  }
  .model-application li {
    margin: 0 0 8px;
    color: #334155;
    line-height: 1.55;
  }
  .replacement-case {
    padding: 26px;
    border-left: 4px solid var(--color-primary);
    background: #f8fafc;
  }
  .replacement-case dl {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .replacement-case dl > div {
    padding: 15px;
    border: 1px solid var(--color-stroke);
    background: #fff;
  }
  .replacement-case dt {
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .replacement-case dd {
    margin: 6px 0 0;
    line-height: 1.55;
  }
  .model-summary {
    padding: 26px;
    border: 1px solid rgba(20, 110, 245, 0.18);
    background: linear-gradient(180deg, rgba(20, 110, 245, 0.06), #fff);
  }
  .model-summary__kicker {
    margin: 0;
    color: var(--color-primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .model-summary h2 {
    margin: 9px 0 18px;
    font-size: 28px;
    overflow-wrap: anywhere;
    text-transform: none;
  }
  .model-summary dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 0 0 16px;
  }
  .model-summary dl > div {
    padding: 15px;
    background: #fff;
    border: 1px solid var(--color-stroke);
  }
  .model-summary dt {
