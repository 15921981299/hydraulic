---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbHero from "../../components/BreadcrumbHero.astro";
import DetailRfqStrip from "../../components/DetailRfqStrip.astro";
import {
  modelRecords,
  modelSearchIntent,
} from "../../data/model-records";
import { brandCoverage } from "../../data/brand-coverage";
import { seriesRecords } from "../../data/series-records";
import { breadcrumbSchema, itemListSchema, site } from "../../data/site";
import "../../styles/resource-page.css";

const pageUrl = `${site.url}/models/`;
const normalizeKey = (value: string) =>
  value.toLowerCase().replace(/[^a-z0-9]/g, "");
const brandFor = (brand: string) => {
  const key = normalizeKey(brand);
  return brandCoverage.find((candidate) =>
    [candidate.name, ...candidate.aliases].some((name) => {
      const candidateKey = normalizeKey(name);
      return key.includes(candidateKey) || candidateKey.includes(key);
    }),
  );
};
const seriesFor = (brand: string, series: string) => {
  const brandKey = normalizeKey(brand);
  const seriesKey = normalizeKey(series);
  return seriesRecords.find(
    (candidate) =>
      normalizeKey(candidate.series) === seriesKey &&
      (normalizeKey(candidate.brand).includes(brandKey) ||
        brandKey.includes(normalizeKey(candidate.brand)) ||
        brandFor(brand)?.slug === brandFor(candidate.brand)?.slug),
  );
};
const databaseRows = modelRecords.map((record) => ({
  record,
  searchIntent: modelSearchIntent(record),
  brandPage: brandFor(record.brand),
  seriesPage: seriesFor(record.brand, record.series),
  searchKey: [
    record.brand,
    record.series,
    record.model,
    record.materialNumber,
    record.productType,
    record.alternativeReview?.status,
    record.alternativeReview?.proposedModel,
  ]
    .filter(Boolean)
    .join(" ")
    .toLowerCase(),
}));
const modelRows = databaseRows;
const representedBrands = new Set(
  databaseRows.map(({ brandPage, record }) => brandPage?.slug ?? record.brand),
).size;
const representedSeries = new Set(
  databaseRows.map(({ record }) => `${record.brand}:${record.series}`),
).size;
const publishedAlternativeCount = modelRecords.filter(
  (record) => record.alternativeReview?.proposedModel,
).length;
---

<BaseLayout
  title="Hydraulic Model Database & Alternative Status"
  description="Browse hydraulic brands, series and exact model records with source evidence, review requirements and an explicit published or not-yet-published alternative status."
  currentPath="/alternatives"
  jsonLd={[
    breadcrumbSchema([
      { name: "Home", url: site.url },
      { name: "Model Records", url: pageUrl },
    ]),
    itemListSchema(
      modelRows.map(({ record }) => ({
        name: `${record.brand} ${record.model}`,
        url: `${pageUrl}${record.slug}/`,
      })),
    ),
  ]}
>
  <BreadcrumbHero
    title="Hydraulic Model Code Records"
    trail={[{ label: "Home", href: "/" }, { label: "Model Records" }]}
    variant="2"
  />
  <section class="model-index">
    <div class="container">
      <header class="model-index__intro">
        <p>BRAND → SERIES → MODEL → ALTERNATIVE STATUS</p>
        <h2>A model database, not a category-page collection.</h2>
        <span>
          Each row preserves the original reference, connects it to a brand and
          series, and states whether an alternative model has actually been
          published. “No public alternative” is intentional: a plausible
          cross-reference is not promoted to a replacement until the evidence
          supports it.
        </span>
      </header>
      <div class="model-index__notice">
        <strong>{modelRows.length} model records published for search</strong>
        <p>
          {representedBrands} brand groups · {representedSeries} series groups ·
          {" "}{publishedAlternativeCount} public alternatives.
          Every published record is eligible for search indexing.
        </p>
      </div>
      <section
        class="database-method"
        aria-labelledby="database-method-heading"
      >
        <div>
          <p>HOW A RECORD EARNS A RELATIONSHIP</p>
          <h2 id="database-method-heading">
            The hierarchy keeps different claims separate.
          </h2>
        </div>
        <ol>
          <li>
            <strong>Brand</strong><span>Who issued the original reference?</span
            >
          </li>
          <li>
            <strong>Series</strong><span
              >Which product family and code logic apply?</span
            >
          </li>
          <li>
            <strong>Model</strong><span
              >What does the complete identifier describe?</span
            >
          </li>
          <li>
            <strong>Alternative</strong><span
              >Is a proposed model documented, conditional or not published?</span
            >
          </li>
        </ol>
      </section>

      <section
        class="database-browser"
        aria-labelledby="database-browser-heading"
      >
        <div class="database-browser__heading">
          <div>
            <p>STRUCTURED MODEL LIBRARY</p>
            <h2 id="database-browser-heading">Search the relationship table</h2>
          </div>
          <label>
            <span>Search brand, series or model</span>
            <input
              id="model-database-search"
              type="search"
              placeholder="e.g. Rexroth, A10VO, R900..."
              autocomplete="off"
            />
          </label>
        </div>
        <p
          id="model-database-result"
          class="database-browser__result"
          aria-live="polite"
        >
          Showing all {databaseRows.length} records.
        </p>
        <div class="database-table-wrap">
          <table class="database-table">
            <thead>
              <tr>
                <th scope="col">Brand</th>
                <th scope="col">Record status</th>
                <th scope="col">Series</th>
                <th scope="col">Original model</th>
                <th scope="col">Alternative status</th>
                <th scope="col">Proposed alternative</th>
              </tr>
            </thead>
            <tbody>
              {
                databaseRows.map(
                  ({
                    record,
                    brandPage,
                    seriesPage,
                    searchKey,
                    searchIntent,
                  }) => (
                    <tr data-model-record data-search-key={searchKey}>
                      <td>
                        {brandPage ? (
                          <a href={`/brands/${brandPage.slug}/`}>
                            {record.brand}
                          </a>
                        ) : (
                          record.brand
                        )}
                      </td>
                      <td>
                        <span
                          class:list={[
                            "database-status",
                            "database-status--reviewed",
                          ]}
                        >
                          {searchIntent.label}
                        </span>
                      </td>
                      <td>
                        {seriesPage ? (
                          <a href={`/series/${seriesPage.slug}/`}>
                            {record.series}
                          </a>
                        ) : (
                          record.series
                        )}
                      </td>
                      <td>
                        <a href={`/models/${record.slug}/`}>{record.model}</a>
                        {record.materialNumber && (
                          <small>{record.materialNumber}</small>
                        )}
                      </td>
                      <td>
                        <span class="database-status">
                          {record.alternativeReview?.status ??
                            "No public alternative"}
                        </span>
                      </td>
                      <td>{record.alternativeReview?.proposedModel ?? "—"}</td>
                    </tr>
                  ),
                )
              }
            </tbody>
          </table>
        </div>
      </section>

      <h2 class="model-grid-heading">Detailed model review records</h2>
      <div class="model-grid">
        {
          modelRows.map(({ record, searchKey, searchIntent }) => (
            <article
              class="model-card"
              data-model-card
              data-search-key={searchKey}
            >
              <div class="model-card__image">
                <img
                  src={record.image}
                  alt={`${record.brand} ${record.model} reference product family`}
                  width="1200"
                  height="900"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="model-card__body">
                <p>
                  {record.brand} · {record.productType}
                </p>
                <h2>
                  <a href={`/models/${record.slug}/`}>{record.model}</a>
                </h2>
                {record.materialNumber && (
                  <span>Material number: {record.materialNumber}</span>
                )}
                <dl>
                  <div>
                    <dt>Evidence status</dt>
                    <dd>{searchIntent.label}</dd>
                  </div>
                  <div>
                    <dt>Series</dt>
                    <dd>{record.series}</dd>
                  </div>
                  <div>
                    <dt>Alternative status</dt>
                    <dd>{record.alternativeReview?.status}</dd>
                  </div>
                  <div>
                    <dt>Review note</dt>
                    <dd>{record.alternativeReview?.note}</dd>
                  </div>
                </dl>
                <a class="model-card__link" href={`/models/${record.slug}/`}>
                  Open reviewed record →
                </a>
              </div>
            </article>
          ))
        }
      </div>
      <DetailRfqStrip
        quoteHref="/contact/?source=model-index"
        title="Cannot find the exact model?"
        text="Send the complete code or upload the nameplate. New model records are published as the reference and review fields are completed."
        modalContext="Exact model inquiry"
        modalSource="model-index"
      />
    </div>
  </section>
</BaseLayout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>(
    "#model-database-search",
  );
  const resultText = document.querySelector<HTMLElement>(
    "#model-database-result",
  );
  const tableRows = Array.from(
    document.querySelectorAll<HTMLElement>("[data-model-record]"),
  );
  const modelCards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-model-card]"),
  );

  searchInput?.addEventListener("input", () => {
    const query = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    tableRows.forEach((row) => {
      const matches = !query || row.dataset.searchKey?.includes(query);
      row.hidden = !matches;
      if (matches) visibleCount += 1;
    });
    modelCards.forEach((card) => {
      card.hidden = Boolean(query) && !card.dataset.searchKey?.includes(query);
    });
    if (resultText) {
      resultText.textContent = query
        ? `${visibleCount} matching record${visibleCount === 1 ? "" : "s"}.`
        : `Showing all ${tableRows.length} records.`;
    }
  });
</script>

<style>
  .model-index {
    padding: 80px 0 100px;
    background: #f5f7fa;
  }
  .model-index__intro {
    max-width: 920px;
    margin-bottom: 28px;
  }
  .model-index__intro > p {
    margin: 0;
    color: var(--color-primary);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .model-index__intro h2 {
    margin: 10px 0 14px;
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.12;
    text-transform: none;
  }
  .model-index__intro span {
    color: #536071;
    line-height: 1.75;
  }
  .model-index__notice {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 20px;
    margin-bottom: 28px;
    padding: 20px 22px;
    border-left: 3px solid var(--color-primary);
    background: #fff;
  }
  .model-index__notice p {
    margin: 0;
    color: #536071;
    line-height: 1.6;
  }
  .database-method {
    display: grid;
    grid-template-columns: minmax(250px, 0.8fr) 1.6fr;
    gap: 28px;
    margin: 0 0 28px;
    padding: clamp(24px, 4vw, 38px);
    color: #fff;
    background: #0f2742;
  }
  .database-method p,
  .database-browser__heading p {
    margin: 0 0 8px;
    color: #79aef7;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .database-method h2,
  .database-browser h2,
  .model-grid-heading {
    margin: 0;
    text-transform: none;
  }
  .database-method h2 {
    color: #fff;
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.2;
  }
  .database-method ol {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: database-step;
  }
  .database-method li {
    position: relative;
    min-height: 105px;
    padding: 18px 18px 18px 52px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.05);
    counter-increment: database-step;
  }
  .database-method li::before {
    position: absolute;
    top: 18px;
    left: 18px;
    color: #79aef7;
    font-weight: 800;
    content: counter(database-step, decimal-leading-zero);
  }
  .database-method strong,
  .database-method span {
    display: block;
  }
  .database-method span {
    margin-top: 6px;
    color: #c5d2e1;
    font-size: 13px;
    line-height: 1.55;
  }
  .database-browser {
    margin-bottom: 34px;
    padding: 26px;
    border: 1px solid var(--color-stroke);
    background: #fff;
  }
  .database-browser__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }
  .database-browser__heading p {
    color: var(--color-primary);
  }
  .database-browser__heading label {
    display: grid;
    gap: 7px;
    min-width: min(100%, 340px);
    color: #475569;
    font-size: 12px;
    font-weight: 700;
  }
  .database-browser__heading input {
    min-height: 46px;
    padding: 10px 13px;
    border: 1px solid #b8c4d2;
    border-radius: 4px;
    background: #fff;
    color: #0f172a;
    font: inherit;
    font-size: 14px;
  }
  .database-browser__heading input:focus {
    border-color: var(--color-primary);
    outline: 3px solid rgba(20, 110, 245, 0.14);
  }
  .database-browser__result {
    margin: 16px 0 10px;
    color: #64748b;
    font-size: 13px;
  }
  .database-table-wrap {
    overflow-x: auto;
  }
  .database-table {
    width: 100%;
    min-width: 860px;
    border-collapse: collapse;
    font-size: 13px;
  }
  .database-table th,
  .database-table td {
    padding: 13px 12px;
    border: 1px solid var(--color-stroke);
    text-align: left;
    vertical-align: top;
  }
  .database-table th {
    color: #334155;
    background: #f1f5f9;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .database-table a {
    color: var(--color-title);
    font-weight: 700;
    text-decoration: none;
  }
  .database-table a:hover {
    color: var(--color-primary);
  }
  .database-table small {
    display: block;
    margin-top: 4px;
    color: #64748b;
  }
  .database-status {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 999px;
    color: #92400e;
    background: #fff7ed;
    font-size: 11px;
    font-weight: 700;
  }
  .database-status--reviewed {
    color: #075985;
    background: #e0f2fe;
  }
  .model-grid-heading {
    margin-bottom: 18px;
    font-size: clamp(25px, 3vw, 34px);
  }
  .model-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-bottom: 32px;
  }
  .model-card {
    display: grid;
    grid-template-columns: 210px 1fr;
    min-height: 330px;
    border: 1px solid var(--color-stroke);
    background: #fff;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .model-card:hover {
    border-color: rgba(20, 110, 245, 0.35);
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.06);
  }
  .model-card__image {
    overflow: hidden;
  }
  .model-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .model-card__body {
    display: flex;
    flex-direction: column;
    padding: 24px;
  }
  .model-card__body > p {
    margin: 0;
    color: var(--color-primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .model-card h2 {
    margin: 12px 0 6px;
    font-size: 22px;
    text-transform: none;
    overflow-wrap: anywhere;
  }
  .model-card h2 a {
    color: var(--color-title);
    text-decoration: none;
  }
  .model-card__body > span {
    color: #64748b;
    font-size: 12px;
  }
  .model-card dl {
    margin: 18px 0;
  }
  .model-card dl > div {
    padding: 9px 0;
    border-top: 1px solid var(--color-stroke);
  }
  .model-card dt {
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .model-card dd {
    margin: 4px 0 0;
    color: #334155;
    font-size: 13px;
    line-height: 1.5;
  }
  .model-card__link {
    width: max-content;
    margin-top: auto;
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }
  .model-card__link:hover {
    text-decoration: underline;
  }
  .model-card a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }
  @media (max-width: 1050px) {
    .database-method {
      grid-template-columns: 1fr;
    }
    .model-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 620px) {
    .model-index {
      padding: 60px 0 72px;
    }
    .model-index__notice {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .database-method ol {
      grid-template-columns: 1fr;
    }
    .database-browser {
      padding: 20px 16px;
    }
    .database-browser__heading {
      align-items: stretch;
      flex-direction: column;
    }
    .model-card {
      grid-template-columns: 1fr;
    }
    .model-card__image {
      height: 220px;
    }
  }
</style>
