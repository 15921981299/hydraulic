---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbHero from "../../components/BreadcrumbHero.astro";
import DetailRfqStrip from "../../components/DetailRfqStrip.astro";
import { modelRecords } from "../../data/model-records";
import { breadcrumbSchema, itemListSchema, site } from "../../data/site";
import "../../styles/resource-page.css";

const pageUrl = `${site.url}/models/`;
const commercialCount = modelRecords.filter((record) => record.commercial).length;
---

<BaseLayout
  title="Hydraulic Model Codes & Replacement Records"
  description="Browse exact hydraulic model references with code-group explanations, commercial availability and conditional replacement review requirements."
  currentPath="/alternatives"
  jsonLd={[
    breadcrumbSchema([
      { name: "Home", url: site.url },
      { name: "Model Records", url: pageUrl },
    ]),
    itemListSchema(
      modelRecords.map((record) => ({
        name: `${record.brand} ${record.model}`,
        url: `${pageUrl}${record.slug}/`,
      })),
    ),
  ]}
>
  <BreadcrumbHero
    title="Hydraulic Model Code Records"
    trail={[{ label: "Home", href: "/" }, { label: "Model Records" }]}
    variant="2"
  />
  <section class="model-index">
    <div class="container">
      <header class="model-index__intro">
        <p>EXACT REFERENCE SEARCH</p>
        <h2>Model-level pages for high-intent hydraulic inquiries.</h2>
        <span>
          Each record starts with a complete manufacturer reference. It
          explains what the code identifies, which commercial and technical
          details still require confirmation and when a matched product can be
          described as directly compatible.
        </span>
      </header>
      <div class="model-index__notice">
        <strong>{modelRecords.length} exact records</strong>
        <p>
          {commercialCount} records include commercial availability details.
          Exact physical inventory, price and lead time are reconfirmed against
          the submitted code before order acceptance.
        </p>
      </div>
      <div class="model-grid">
        {
          modelRecords.map((record) => (
            <article class="model-card">
              <div class="model-card__image">
                <img
                  src={record.image}
                  alt={`${record.brand} ${record.model} reference product family`}
                  width="1200"
                  height="900"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="model-card__body">
                <p>
                  {record.brand} · {record.productType}
                </p>
                <h2>
                  <a href={`/models/${record.slug}/`}>{record.model}</a>
                </h2>
                {record.materialNumber && (
                  <span>Material number: {record.materialNumber}</span>
                )}
                <dl>
                  {record.commercial && (
                    <div>
                      <dt>Commercial status</dt>
                      <dd>
                        {record.commercial.status}
                        {record.commercial.price
                          ? ` · ${record.commercial.price}`
                          : " · price on request"}
                      </dd>
                    </div>
                  )}
                  <div>
                    <>
                      <dt>Matched route</dt>
                      <dd>{record.matchedRoute}</dd>
                    </>
                  </div>
                  <div>
                    <>
                      <dt>Compatibility</dt>
                      <dd>{record.compatibilityStatus}</dd>
                    </>
                  </div>
                </dl>
                <a class="model-card__link" href={`/models/${record.slug}/`}>
                  Open model review →
                </a>
              </div>
            </article>
          ))
        }
      </div>
      <DetailRfqStrip
        quoteHref="/contact/?source=model-index"
        title="Cannot find the exact model?"
        text="Send the complete code or upload the nameplate. New model records are published only after the reference and review fields can be documented."
        modalContext="Exact model inquiry"
        modalSource="model-index"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .model-index {
    padding: 80px 0 100px;
    background: #f5f7fa;
  }
  .model-index__intro {
    max-width: 920px;
    margin-bottom: 28px;
  }
  .model-index__intro > p {
    margin: 0;
    color: var(--color-primary);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .model-index__intro h2 {
    margin: 10px 0 14px;
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.12;
    text-transform: none;
  }
  .model-index__intro span {
    color: #536071;
    line-height: 1.75;
  }
  .model-index__notice {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 20px;
    margin-bottom: 28px;
    padding: 20px 22px;
    border-left: 3px solid var(--color-primary);
    background: #fff;
  }
  .model-index__notice p {
    margin: 0;
    color: #536071;
    line-height: 1.6;
  }
  .model-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-bottom: 32px;
  }
  .model-card {
    display: grid;
    grid-template-columns: 210px 1fr;
    min-height: 330px;
    border: 1px solid var(--color-stroke);
    background: #fff;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .model-card:hover {
    border-color: rgba(20, 110, 245, 0.35);
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.06);
  }
  .model-card__image {
    overflow: hidden;
  }
  .model-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .model-card__body {
    display: flex;
    flex-direction: column;
    padding: 24px;
  }
  .model-card__body > p {
    margin: 0;
    color: var(--color-primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .model-card h2 {
    margin: 12px 0 6px;
    font-size: 22px;
    text-transform: none;
    overflow-wrap: anywhere;
  }
  .model-card h2 a {
    color: var(--color-title);
    text-decoration: none;
  }
  .model-card__body > span {
    color: #64748b;
    font-size: 12px;
  }
  .model-card dl {
    margin: 18px 0;
  }
  .model-card dl > div {
    padding: 9px 0;
    border-top: 1px solid var(--color-stroke);
  }
  .model-card dt {
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .model-card dd {
    margin: 4px 0 0;
    color: #334155;
    font-size: 13px;
    line-height: 1.5;
  }
  .model-card__link {
    width: max-content;
    margin-top: auto;
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }
  .model-card__link:hover {
    text-decoration: underline;
  }
  .model-card a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }
  @media (max-width: 1050px) {
    .model-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 620px) {
    .model-index {
      padding: 60px 0 72px;
    }
    .model-index__notice {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .model-card {
      grid-template-columns: 1fr;
    }
    .model-card__image {
      height: 220px;
    }
  }
</style>
