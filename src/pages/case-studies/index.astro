---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbHero from "../../components/BreadcrumbHero.astro";
import DetailRfqStrip from "../../components/DetailRfqStrip.astro";
import { hydraulicCaseStudies } from "../../data/case-studies";
import { breadcrumbSchema, itemListSchema, site } from "../../data/site";

const pageUrl = `${site.url}/case-studies/`;
const evidenceReadyStudies = hydraulicCaseStudies.filter(
  (study) => study.indexReady,
);
---

<BaseLayout
  title="Hydraulic Matching and Export Case Studies"
  description="Review anonymized hydraulic component identification, replacement, mixed RFQ and export cases with the evidence, checks and outcomes shown."
  currentPath="/resources"
  image="/images/hydraulic/hydraulic-inspection-packing.webp"
  jsonLd={[
    breadcrumbSchema([
      { name: "Home", url: site.url },
      { name: "Case Studies", url: pageUrl },
    ]),
    ...(evidenceReadyStudies.length
      ? [
          itemListSchema(
            evidenceReadyStudies.map((study) => ({
              name: study.title,
              url: `${pageUrl}${study.slug}/`,
            })),
          ),
        ]
      : []),
  ]}
>
  <BreadcrumbHero
    title="Hydraulic Matching Case Studies"
    trail={[{ label: "Home", href: "/" }, { label: "Case Studies" }]}
    variant="4"
  />
  <section class="case-index">
    <div class="container">
      <header class="case-index__intro">
        <p>ANONYMIZED PROCESS RECORDS</p>
        <h2>
          How references, missing information and buyer requirements were
          handled.
        </h2>
        <span>
          These records explain how incomplete references and buyer requirements
          were handled without exposing customer identity or confidential order
          data. They document a workflow; they are not public proof of customer
          identity, product performance or a universal outcome.
        </span>
      </header>
      <div class="case-grid">
        {
          hydraulicCaseStudies.map((study) => (
            <article class="case-card">
              <a class="case-card__image" href={`/case-studies/${study.slug}/`}>
                <img
                  src={study.image}
                  alt={`${study.industry} hydraulic matching case`}
                  width="1200"
                  height="900"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="case-card__body">
                <p>
                  {study.industry} · {study.region}
                </p>
                <small>
                  {study.indexReady
                    ? "Evidence-ready case"
                    : "Private-evidence process example"}
                </small>
                <h2>
                  <a href={`/case-studies/${study.slug}/`}>{study.title}</a>
                </h2>
                <span>{study.description}</span>
                <dl>
                  <div>
                    <>
                      <dt>Reference</dt>
                      <dd>{study.reference}</dd>
                    </>
                  </div>
                  <div>
                    <>
                      <dt>Outcome</dt>
                      <dd>{study.result}</dd>
                    </>
                  </div>
                </dl>
                <a
                  class="case-card__link"
                  href={`/case-studies/${study.slug}/`}
                >
                  Review process record →
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <section class="case-index__method">
        <header>
          <p>HOW TO READ THESE RECORDS</p>
          <h2>Separate the documented method from the private transaction.</h2>
          <span>
            Each record identifies the input problem, review actions, decision
            and evidence boundary. Customer names, original files, prices and
            order documents remain private, so the page does not present them as
            independently verifiable endorsements.
          </span>
        </header>
        <div class="case-index__matrix">
          <table>
            <thead>
              <tr>
                <th scope="col">Process record</th>
                <th scope="col">Method demonstrated</th>
                <th scope="col">Public evidence boundary</th>
              </tr>
            </thead>
            <tbody>
              {
                hydraulicCaseStudies.map((study) => (
                  <tr>
                    <td>
                      <a href={`/case-studies/${study.slug}/`}>
                        {study.reference}
                      </a>
                    </td>
                    <td>{study.takeaway}</td>
                    <td>{study.evidenceBoundary}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <aside class="case-index__boundary">
        <strong>What these pages can support</strong>
        <p>
          They support an explanation of Hydraulic Match's review procedure and
          the types of records used. They do not establish sales volume,
          manufacturer authorization, current inventory, customer satisfaction
          or suitability for another machine. A new inquiry starts with its own
          evidence and may reach a different result.
        </p>
      </aside>

      <DetailRfqStrip
        quoteHref="/contact/?source=case-studies"
        title="Have a similar identification or replacement problem?"
        text="Send the available reference and files. We will state what can be confirmed and what evidence is still missing."
        modalContext="Case study inquiry"
        modalSource="case-studies"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .case-index {
    padding: 80px 0 100px;
    background: #f5f7fa;
  }
  .case-index__intro {
    max-width: 930px;
    margin-bottom: 30px;
  }
  .case-index__intro > p {
    margin: 0;
    color: var(--color-primary);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .case-index__intro h2 {
    margin: 10px 0 14px;
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.12;
    text-transform: none;
  }
  .case-index__intro span {
    color: #536071;
    line-height: 1.75;
  }
  .case-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 32px;
  }
  .case-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-stroke);
    background: #fff;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .case-card:hover {
    border-color: rgba(20, 110, 245, 0.35);
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.06);
  }
  .case-card__image {
    display: block;
    height: 230px;
    overflow: hidden;
  }
  .case-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .case-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 24px;
  }
  .case-card__body > p {
    margin: 0;
    color: var(--color-primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .case-card h2 {
    margin: 12px 0;
    font-size: 22px;
    line-height: 1.3;
    text-transform: none;
  }
  .case-card h2 a {
    color: var(--color-title);
    text-decoration: none;
  }
  .case-card__body > span {
    color: #536071;
    font-size: 14px;
    line-height: 1.65;
  }
  .case-card dl {
    margin: 20px 0;
  }
  .case-card dl > div {
    padding: 9px 0;
    border-top: 1px solid var(--color-stroke);
  }
  .case-card dt {
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .case-card dd {
    margin: 4px 0 0;
    color: #334155;
    font-size: 13px;
    line-height: 1.5;
  }
  .case-card__link {
    width: max-content;
    margin-top: auto;
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }
  .case-card__link:hover {
    text-decoration: underline;
  }
  .case-card a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }
  .case-index__method {
    margin: 42px 0 20px;
  }
  .case-index__method header {
    max-width: 900px;
    margin-bottom: 20px;
  }
  .case-index__method header > p {
    margin: 0;
    color: var(--color-primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.11em;
  }
  .case-index__method h2 {
    margin: 8px 0 12px;
    font-size: 30px;
    text-transform: none;
  }
  .case-index__method header span,
  .case-index__boundary p {
    color: #536071;
    line-height: 1.7;
  }
  .case-index__matrix {
    overflow-x: auto;
  }
  .case-index__matrix table {
    width: 100%;
    min-width: 800px;
    border-collapse: collapse;
    background: #fff;
  }
  .case-index__matrix th,
  .case-index__matrix td {
    padding: 16px;
    border: 1px solid var(--color-stroke);
    text-align: left;
    vertical-align: top;
    line-height: 1.55;
  }
  .case-index__matrix th {
    background: #eef2f7;
  }
  .case-index__matrix td {
    color: #536071;
  }
  .case-index__matrix a {
    color: var(--color-primary);
    font-weight: 700;
  }
  .case-index__boundary {
    margin: 20px 0 32px;
    padding: 22px;
    border-left: 3px solid var(--color-primary);
    background: #fff;
  }
  .case-index__boundary p {
    margin: 7px 0 0;
  }
  @media (max-width: 950px) {
    .case-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 620px) {
    .case-index {
      padding: 60px 0 72px;
    }
    .case-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
