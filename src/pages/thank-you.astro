---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="Your Match Request Was Received" description="Hydraulic Match received your hydraulic component inquiry." noindex hideFloatingCta>
  <section class="hm-thanks"><div class="container"><p>REQUEST RECEIVED</p><h1>Thank you. We will review the model and files.</h1><span>We check inquiry completeness first. If a model suffix, photo, drawing or application detail is missing, we will ask for it before preparing a sourcing option.</span><div class="hm-thanks__steps"><div><strong>01</strong><p>Completeness check</p></div><div><strong>02</strong><p>Technical review</p></div><div><strong>03</strong><p>Supplier confirmation</p></div><div><strong>04</strong><p>Quote and open points</p></div></div><p class="hm-thanks__contact">Questions? Email <a href={`mailto:${site.email}`}>{site.email}</a>.</p><a href="/" class="primary-button"><span class="button-text">Return Home</span></a></div></section>
</BaseLayout>
<style>.hm-thanks{padding:110px 0;text-align:center;background:#f5f7fa}.hm-thanks>div>p:first-child{color:var(--color-primary);font-size:12px;font-weight:600;letter-spacing:.13em}.hm-thanks h1{max-width:900px;margin:14px auto 20px}.hm-thanks>div>span{display:block;max-width:780px;margin:0 auto;color:#596575;line-height:1.7}.hm-thanks__steps{display:grid;grid-template-columns:repeat(4,1fr);max-width:900px;margin:50px auto 30px;border-top:1px solid var(--color-stroke);border-left:1px solid var(--color-stroke)}.hm-thanks__steps div{padding:24px;border-right:1px solid var(--color-stroke);border-bottom:1px solid var(--color-stroke);background:#fff}.hm-thanks__steps strong{color:var(--color-primary)}.hm-thanks__steps p{font-size:14px}.hm-thanks__contact{font-size:14px;margin-bottom:28px}.hm-thanks__contact a{color:var(--color-primary)}@media(max-width:650px){.hm-thanks__steps{grid-template-columns:1fr 1fr}}</style>
