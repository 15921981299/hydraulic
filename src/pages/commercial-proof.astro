---
import BaseLayout from "../layouts/BaseLayout.astro";
import BreadcrumbHero from "../components/BreadcrumbHero.astro";
import DetailRfqStrip from "../components/DetailRfqStrip.astro";
import {
  compatibilityReviewRows,
  credentials,
  evidenceGaps,
  inventoryMetrics,
  inventoryRows,
  operationalEvidence,
  ownedNetworkEvidence,
  verificationLevels,
  warranty,
} from "../data/commercial-proof";
import { breadcrumbSchema, site } from "../data/site";
import "../styles/resource-page.css";
---

<BaseLayout
  title="Commercial Evidence Status and RFQ Boundaries"
  description="Review what Hydraulic Match currently publishes, which commercial facts require order-specific evidence, and which credentials or claims are not publicly established."
  currentPath="/commercial-proof"
  jsonLd={breadcrumbSchema([
    { name: "Home", url: site.url },
    {
      name: "Commercial Evidence Status",
      url: `${site.url}/commercial-proof/`,
    },
  ])}
>
  <BreadcrumbHero
    title="Commercial Evidence Status"
    trail={[{ label: "Home", href: "/" }, { label: "Commercial Evidence" }]}
    variant="5"
  />

  <section class="proof-page">
    <div class="container">
      <header class="proof-intro">
        <p>PRE-LAUNCH DISCLOSURE</p>
        <h2>Separate published site content from transaction evidence.</h2>
        <span>
          Hydraulic Match currently publishes research pages, review methods and
          inquiry tools. The website does not by itself prove legal identity,
          warehouse ownership, live inventory, manufacturer authorization,
          certification, customer endorsements or completed transactions.
        </span>
      </header>

      <nav class="resource-nav proof-nav" aria-label="Evidence sections">
        <a href="#published" class="resource-nav-link">Published</a>
        <a href="#availability" class="resource-nav-link">Availability</a>
        <a href="#credentials" class="resource-nav-link">Credentials</a>
        <a href="#claims" class="resource-nav-link">Claim Thresholds</a>
        <a href="#warranty" class="resource-nav-link">Warranty</a>
        <a href="#compatibility" class="resource-nav-link">Compatibility</a>
      </nav>

      <section id="published" class="proof-section">
        <header>
          <p>PUBLISHED SITE EVIDENCE</p>
          <h2>What a visitor can inspect now</h2>
          <span>
            These records demonstrate the structure and limitations of the
            website. They are not substitutes for business, supplier or order
            documents.
          </span>
        </header>
        <div class="proof-metrics">
          {
            inventoryMetrics.map((metric) => (
              <article>
                <strong>{metric.value}</strong>
                <span>{metric.label}</span>
                <small>Public page coverage</small>
              </article>
            ))
          }
        </div>
        <div class="proof-grid">
          {
            ownedNetworkEvidence.map((item) => (
              <article>
                <p>{item.status}</p>
                <h3>{item.site}</h3>
                <span>{item.contribution}</span>
                <strong>{item.evidence}</strong>
                <a href={item.sourceUrl}>Inspect record →</a>
              </article>
            ))
          }
        </div>

        <h3 class="proof-subheading">Current public evidence status</h3>
        <div class="resource-table-wrap">
          <table class="resource-table">
            <thead>
              <tr>
                <th scope="col">Evidence type</th>
                <th scope="col">Current record</th>
                <th scope="col">Requirement</th>
              </tr>
            </thead>
            <tbody>
              {
                operationalEvidence.map((item) => (
                  <tr>
                    <td>
                      <strong>{item.type}</strong>
                    </td>
                    <td>{item.record}</td>
                    <td>{item.proof}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <h3 class="proof-subheading">Evidence levels</h3>
        <div class="resource-table-wrap">
          <table class="resource-table">
            <thead>
              <tr>
                <th scope="col">Level</th>
                <th scope="col">Meaning</th>
                <th scope="col">Permitted use</th>
              </tr>
            </thead>
            <tbody>
              {
                verificationLevels.map((row) => (
                  <tr>
                    {row.map((cell) => (
                      <td>{cell}</td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section id="availability" class="proof-section">
        <header>
          <p>AVAILABILITY BOUNDARY</p>
          <h2>Published coverage is not live inventory</h2>
          <span>
            Exact stock, condition, quantity, location and dispatch time must be
            checked for the individual RFQ.
          </span>
        </header>
        <div class="resource-table-wrap">
          <table class="resource-table">
            <thead>
              <tr>
                <th scope="col">Product group</th>
                <th scope="col">Public availability</th>
                <th scope="col">Published coverage</th>
                <th scope="col">RFQ confirmation</th>
              </tr>
            </thead>
            <tbody>
              {
                inventoryRows.map((row) => (
                  <tr>
                    {row.map((cell) => (
                      <td>{cell}</td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="resource-note">
          The quotation must identify the exact model, quantity, condition,
          supplier route, checked date and lead-time basis. A category or model
          page is not an inventory feed.
        </p>
      </section>

      <section id="credentials" class="proof-section">
        <header>
          <p>CREDENTIAL DISCLOSURE</p>
          <h2>Claims that require genuine third-party documents</h2>
          <span>
            Placeholder numbers, generic issuers and self-created authorization
            records are not evidence.
          </span>
        </header>
        <div class="credential-grid">
          {
            credentials.map((credential) => (
              <article>
                <p>{credential.type}</p>
                <h3>{credential.title}</h3>
                <dl>
                  <div>
                    <>
                      <dt>Holder</dt>
                      <dd>{credential.holder}</dd>
                    </>
                  </div>
                  <div>
                    <>
                      <dt>Issuer</dt>
                      <dd>{credential.issuer}</dd>
                    </>
                  </div>
                  <div>
                    <>
                      <dt>Reference</dt>
                      <dd>{credential.reference}</dd>
                    </>
                  </div>
                  <div>
                    <>
                      <dt>Validity</dt>
                      <dd>{credential.validity}</dd>
                    </>
                  </div>
                  <div>
                    <>
                      <dt>Scope</dt>
                      <dd>{credential.scope}</dd>
                    </>
                  </div>
                </dl>
              </article>
            ))
          }
        </div>
      </section>

      <section id="claims" class="proof-section">
        <header>
          <p>PUBLICATION THRESHOLDS</p>
          <h2>Evidence required before a commercial claim goes public</h2>
          <span>
            Anonymous scenarios and internally written quotes are not customer
            reviews. Until source evidence exists, the correct status is “not
            publicly established.”
          </span>
        </header>
        <div class="claim-grid">
          {
            evidenceGaps.map((item) => (
              <article>
                <h3>{item.claim}</h3>
                <p>{item.publishWhen}</p>
                <strong>{item.currentStatus}</strong>
              </article>
            ))
          }
        </div>
      </section>

      <section id="warranty" class="proof-section">
        <header>
          <p>ORDER-SPECIFIC WARRANTY</p>
          <h2>Website language does not create a fixed warranty</h2>
          <span>
            Duration, eligible items, start point, claim timing, exclusions and
            remedies must be stated in the accepted quotation or warranty
            document.
          </span>
        </header>
        <div class="warranty-grid">
          <article>
            <span>Duration</span><strong>{warranty.duration}</strong>
          </article>
          <article>
            <span>Start point</span><strong>{warranty.starts}</strong>
          </article>
          <article>
            <span>Claim timing</span><strong>{warranty.response}</strong>
          </article>
          <article>
            <span>Possible remedies</span><strong>{warranty.remedies}</strong>
          </article>
        </div>
        <h3 class="proof-subheading">
          Typical boundaries requiring written terms
        </h3>
        <ul class="resource-list">
          {warranty.exclusions.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section id="compatibility" class="proof-section">
        <header>
          <p>COMPATIBILITY LANGUAGE</p>
          <h2>Wording becomes stronger only when evidence becomes stronger</h2>
          <span>
            A public page can identify a family or describe comparison
            requirements. Only an order-specific review can approve an offered
            item for the recorded conditions.
          </span>
        </header>
        <div class="resource-table-wrap">
          <table class="resource-table">
            <thead>
              <tr>
                <th scope="col">Evidence available</th>
                <th scope="col">Permitted status</th>
                <th scope="col">Permitted action</th>
                <th scope="col">Commercial boundary</th>
              </tr>
            </thead>
            <tbody>
              {
                compatibilityReviewRows.map((row) => (
                  <tr>
                    {row.map((cell) => (
                      <td>{cell}</td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="resource-note">
          Avoid “identical,” “genuine,” “authorized,” “in stock” and “direct
          replacement” unless the exact claim is supported and its scope is
          visible. Referenced manufacturer names remain identification terms.
        </p>
      </section>

      <DetailRfqStrip
        quoteHref="/request-a-quote/?source=commercial-evidence"
        title="Request order-specific evidence."
        text="Submit the exact code and quantity. A responsible response will state what is confirmed, what remains conditional and which commercial documents are available."
        modalContext="Commercial evidence inquiry"
        modalSource="commercial-evidence"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .proof-page {
    padding: 72px 0 96px;
    background: #fff;
  }
  .proof-intro,
  .proof-section > header {
    max-width: 920px;
  }
  .proof-intro {
    margin-bottom: 28px;
  }
  .proof-intro > p,
  .proof-section > header > p,
  .proof-grid article > p,
  .credential-grid article > p {
    margin: 0;
    color: var(--color-primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.11em;
  }
  .proof-intro h2 {
    margin: 9px 0 12px;
    font-size: clamp(32px, 4vw, 48px);
    text-transform: none;
  }
  .proof-intro span,
  .proof-section > header > span,
  .proof-grid article > span {
    color: #536071;
    line-height: 1.7;
  }
  .proof-nav {
    position: sticky;
    top: 72px;
    z-index: 10;
    padding: 12px 0;
    background: rgba(255, 255, 255, 0.96);
  }
  .proof-section {
    scroll-margin-top: 145px;
    padding: 52px 0;
    border-bottom: 1px solid var(--color-stroke);
  }
  .proof-section > header {
    margin-bottom: 24px;
  }
  .proof-section > header h2 {
    margin: 8px 0 10px;
    font-size: 34px;
    text-transform: none;
  }
  .proof-metrics,
  .proof-grid,
  .claim-grid,
  .warranty-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .proof-metrics article,
  .proof-grid article,
  .claim-grid article,
  .warranty-grid article {
    padding: 22px;
    border: 1px solid var(--color-stroke);
    background: #f7f9fc;
  }
  .proof-metrics strong {
    font-size: 32px;
    color: var(--color-title);
  }
  .proof-metrics span,
  .proof-metrics small {
    display: block;
    margin-top: 7px;
    color: #536071;
  }
  .proof-metrics small {
    color: #8a6500;
    font-weight: 700;
  }
  .proof-grid {
    grid-template-columns: repeat(2, 1fr);
    margin-top: 18px;
  }
  .proof-grid h3,
  .claim-grid h3 {
    margin: 8px 0;
    font-size: 22px;
    text-transform: none;
  }
  .proof-grid strong {
    display: block;
    margin: 18px 0;
    color: #334155;
    line-height: 1.55;
  }
  .proof-grid a {
    color: var(--color-primary);
    font-weight: 700;
  }
  .proof-subheading {
    margin: 30px 0 12px;
    font-size: 21px;
  }
  .credential-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .credential-grid article {
    padding: 24px;
    border: 1px solid var(--color-stroke);
  }
  .credential-grid h3 {
    margin: 9px 0 18px;
    font-size: 22px;
    text-transform: none;
  }
  .credential-grid dl {
    margin: 0;
  }
  .credential-grid dl > div {
    display: grid;
    grid-template-columns: 75px 1fr;
    gap: 10px;
    padding: 8px 0;
    border-top: 1px solid var(--color-stroke);
  }
  .credential-grid dt {
    color: #64748b;
    font-size: 12px;
    font-weight: 700;
  }
  .credential-grid dd {
    margin: 0;
    color: #334155;
    line-height: 1.5;
  }
  .claim-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .claim-grid p {
    color: #536071;
    line-height: 1.65;
  }
  .claim-grid strong {
    display: block;
    color: #8a6500;
    line-height: 1.55;
  }
  .warranty-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .warranty-grid span {
    display: block;
    margin-bottom: 8px;
    color: var(--color-primary);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .warranty-grid strong {
    line-height: 1.55;
  }
  @media (max-width: 900px) {
    .proof-metrics,
    .credential-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 700px) {
    .proof-page {
      padding: 52px 0 72px;
    }
    .proof-nav {
      top: 60px;
      flex-wrap: nowrap;
      overflow-x: auto;
    }
    .proof-grid,
    .claim-grid,
    .warranty-grid {
      grid-template-columns: 1fr;
    }
    .proof-section > header h2 {
      font-size: 29px;
    }
  }
  @media (max-width: 480px) {
    .proof-metrics,
    .credential-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
