---
import BaseLayout from "../layouts/BaseLayout.astro";
import BreadcrumbHero from "../components/BreadcrumbHero.astro";
import DetailPageShell from "../components/DetailPageShell.astro";
import DetailRfqStrip from "../components/DetailRfqStrip.astro";
import HydraulicProductSidebar from "../components/HydraulicProductSidebar.astro";
import { hydraulicPages } from "../data/hydraulic-pages";
import {
  articleSchema,
  breadcrumbSchema,
  serviceSchema,
  site,
} from "../data/site";
import "../styles/resource-page.css";

export function getStaticPaths() {
  return hydraulicPages.map((page) => ({
    params: { importedPage: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const reviewer = site.technicalReviewer;
const hasNamedReviewer = Boolean(reviewer.name && reviewer.jobTitle);
const pageUrl = `${site.url}/${page.slug}/`;
const trail = page.slug.split("/");
const isResource = trail[0] === "resources";
const isAlternative = trail[0] === "alternatives";
const isIndustry = trail[0] === "industries";
const hasSectionParent = trail.length > 1;
const parentLabel = isResource
  ? "Resources"
  : isAlternative && hasSectionParent
    ? "Alternatives"
    : isIndustry && hasSectionParent
      ? "Industries"
      : "";
const parentHref = isResource
  ? "/resources/"
  : isAlternative
    ? "/alternatives/"
    : isIndustry
      ? "/industries/"
      : "";
const quoteHref = `/request-a-quote/?source=${page.slug.replaceAll("/", "-")}`;
const brandRoot =
  isAlternative && trail.length >= 2 ? trail.slice(0, 2).join("/") : "";
const relatedAlternativePages = brandRoot
  ? hydraulicPages.filter(
      (candidate) =>
        candidate.slug !== page.slug &&
        candidate.slug.startsWith(`${brandRoot}/`) &&
        candidate.slug.split("/").length === 3,
    )
  : [];
const isPumpTopic =
  /pump|a10vso|a4vg|a11vo|a2fo|pvh|pavc|cavitation|suction|power/.test(
    page.slug,
  );
const imagePath = isPumpTopic
  ? "/images/hydraulic/hydraulic-pumps.webp"
  : page.slug.includes("cylinder")
    ? "/images/hydraulic/hydraulic-cylinders.webp"
    : page.slug === "quality"
      ? "/images/hydraulic/hydraulic-inspection-packing.webp"
      : "/images/hydraulic/hydraulic-valves.webp";
const breadcrumb = breadcrumbSchema([
  { name: "Home", url: site.url },
  ...(parentLabel
    ? [{ name: parentLabel, url: `${site.url}${parentHref}` }]
    : []),
  { name: page.title, url: pageUrl },
]);
const pageSchema = isResource
  ? articleSchema({
      title: page.title,
      description: page.description,
      url: pageUrl,
      image: `${site.url}${imagePath}`,
      datePublished: page.published,
      dateModified: page.modified,
      authorName: hasNamedReviewer
        ? reviewer.name
        : "Hydraulic Match Editorial Review",
      authorUrl: `${site.url}/authors/technical-review-team/`,
      authorJobTitle: hasNamedReviewer ? reviewer.jobTitle : undefined,
      authorSameAs:
        hasNamedReviewer && reviewer.linkedin ? [reviewer.linkedin] : undefined,
      authorType: hasNamedReviewer ? "Person" : "Organization",
    })
  : isAlternative
    ? serviceSchema({
        name: page.title,
        description: page.description,
        url: pageUrl,
        image: `${site.url}${imagePath}`,
      })
    : undefined;
const trustLinks = [
  {
    href: "/about/",
    title: "Business identity",
    text: "Understand the platform role and how contracting details are confirmed.",
  },
  {
    href: "/matching-process/",
    title: "Compatibility process",
    text: "See the six-step review and risk-grading workflow.",
  },
  {
    href: "/quality/",
    title: "Quality verification",
    text: "Define order-specific inspection and evidence requirements.",
  },
  {
    href: "/shipping/",
    title: "Shipping support",
    text: "Review packing, documents and transport options.",
  },
  {
    href: "/warranty/",
    title: "Warranty review",
    text: "Understand claim evidence and quotation-specific scope.",
  },
  {
    href: "/editorial-policy/",
    title: "Editorial policy",
    text: "See how technical content is prepared, reviewed and corrected.",
  },
];
---

<BaseLayout
  title={page.seoTitle}
  description={page.description}
  currentPath={`/${trail[0]}`}
  image={imagePath}
  noindex={page.excludeFromIndex ?? false}
  jsonLd={pageSchema ? [breadcrumb, pageSchema] : breadcrumb}
  ogType={isResource ? "article" : "website"}
  articlePublishedTime={isResource ? page.published : undefined}
>
  <BreadcrumbHero
    title={page.title}
    trail={[
      { label: "Home", href: "/" },
      ...(parentLabel ? [{ label: parentLabel, href: parentHref }] : []),
      { label: page.title },
    ]}
    variant={isResource ? "3" : isAlternative ? "2" : isIndustry ? "4" : "5"}
  />

  <DetailPageShell intro={page.intro}>
    <img
      slot="hero"
      src={imagePath}
      alt={`${page.title} hydraulic technical reference illustration`}
      width="1536"
      height="1024"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <div class="resource-meta">
      <span><strong>Topic</strong> {page.kicker}</span>
      {
        isResource ? (
          <>
            <span>
              <strong>Format</strong> Technical guide
            </span>
            {page.published && (
              <span>
                <strong>Published</strong> {page.published}
              </span>
            )}
            {page.readingTime && (
              <span>
                <strong>Reading time</strong> {page.readingTime}
              </span>
            )}
            <span>
              <strong>Reviewed by</strong>{" "}
              <a href="/authors/technical-review-team/">
                {hasNamedReviewer
                  ? `${reviewer.name}, ${reviewer.jobTitle}`
                  : (page.reviewedBy ?? "Hydraulic Match Editorial Review")}
              </a>
            </span>
          </>
        ) : (
          <>
            <span>
              <strong>Review</strong> Technical references
            </span>
            <span>
              <strong>Use</strong> RFQ preparation
            </span>
            <span>
              <strong>Support</strong> Application matching
            </span>
          </>
        )
      }
    </div>

    <DetailRfqStrip
      quoteHref={quoteHref}
      title={page.ctaTitle ?? "Send the original reference"}
      text={page.ctaText ??
        "Include the complete model code, quantity, destination and available photos or drawings."}
      modalContext={`${page.title} inquiry`}
      modalSource={page.slug.replaceAll("/", "-")}
    />

    {
      page.sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          {section.intro && <p>{section.intro}</p>}
          {section.items && (
            <ul class="resource-list">
              {section.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
          {section.table && (
            <div class="resource-table-wrap">
              <table class="resource-table">
                <thead>
                  <tr>
                    {section.table.headers.map((header) => (
                      <th scope="col">{header}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {section.table.rows.map((row) => (
                    <tr>
                      {row.map((cell) => (
                        <td>{cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          {section.note && <p class="resource-note">{section.note}</p>}
        </section>
      ))
    }

    {
      relatedAlternativePages.length > 0 && (
        <section>
          <h2>
            Related{" "}
            {trail[1] === "rexroth"
              ? "Rexroth"
              : trail[1] === "vickers"
                ? "Vickers"
                : "Parker"}{" "}
            series reviews
          </h2>
          <div class="hub-grid">
            {relatedAlternativePages.map((related) => (
              <a class="hub-card" href={`/${related.slug}/`}>
                <div class="hub-card-body">
                  <p class="hub-card-meta">{related.kicker}</p>
                  <h3 class="hub-card-title">{related.title}</h3>
                  <p class="hub-card-summary">{related.description}</p>
                  <span class="hub-card-link">Open review →</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      page.relatedLinks?.length ? (
        <section>
          <h2>Related Product, Series & Technical Pages</h2>
          <div class="hub-grid">
            {page.relatedLinks.map((link) => (
              <a class="hub-card" href={link.href}>
                <div class="hub-card-body">
                  <h3 class="hub-card-title">{link.title}</h3>
                  <p class="hub-card-summary">{link.text}</p>
                  <span class="hub-card-link">Open related page →</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ) : null
    }

    {
      page.slug === "trust" && (
        <section>
          <h2>Verification and policy pages</h2>
          <div class="hub-grid">
            {trustLinks.map((link) => (
              <a class="hub-card" href={link.href}>
                <div class="hub-card-body">
                  <h3 class="hub-card-title">{link.title}</h3>
                  <p class="hub-card-summary">{link.text}</p>
                  <span class="hub-card-link">Open page →</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <p class="resource-note">
      Manufacturer names, trademarks, and model numbers are used for
      identification and cross-reference purposes only. Compatibility must be
      confirmed for each application.
    </p>

    <p class="resource-related">
      <a href="/series/">Brand &amp; series directory</a><span
        aria-hidden="true">·</span
      >
      <a href="/products/">Product categories</a><span aria-hidden="true"
        >·</span
      >
      <a href="/matching-process/">Matching process</a><span aria-hidden="true"
        >·</span
      >
      <a href="/quality/">Quality &amp; verification</a><span aria-hidden="true"
        >·</span
      >
      <a href="/resources/">Technical guides</a>
    </p>

    <HydraulicProductSidebar
      slot="sidebar"
      activeSlug=""
      quoteHref={quoteHref}
    />
  </DetailPageShell>
</BaseLayout>
