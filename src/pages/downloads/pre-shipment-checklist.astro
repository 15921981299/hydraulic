---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbHero from "../../components/BreadcrumbHero.astro";

const checks = [
  [
    "Order Identity",
    [
      "Quotation and PO reference",
      "Original requested model",
      "Approved supplied model",
      "Quantity and serial / batch information",
    ],
  ],
  [
    "Product Condition",
    [
      "Nameplate and markings photographed",
      "Visible casting, machining and finish checked",
      "Ports and openings protected",
      "No visible transit or handling damage",
    ],
  ],
  [
    "Critical Interfaces",
    [
      "Mounting pattern or flange",
      "Shaft or coupling interface",
      "Port size, type and orientation",
      "Voltage, connector or control assembly",
      "Dimensions agreed in the quotation",
    ],
  ],
  [
    "Packing & Documents",
    [
      "Individual protection and rust prevention",
      "Outer packing suitable for weight and route",
      "Quantity matched to packing list",
      "Commercial invoice and packing list",
      "Inspection or test evidence included when agreed",
    ],
  ],
];
---

<BaseLayout
  title="Printable Hydraulic Pre-Shipment Release Checklist"
  description="Printable pre-shipment checklist for hydraulic model, quantity, condition, interfaces, packing and agreed export documents."
  currentPath="/resources"
  noindex
  hideFloatingCta
>
  <BreadcrumbHero
    title="Hydraulic Pre-Shipment Checklist"
    trail={[
      { label: "Home", href: "/" },
      { label: "Downloads", href: "/downloads/" },
      { label: "Pre-Shipment Checklist" },
    ]}
    variant="5"
  />
  <main class="print-checklist">
    <div class="container">
      <header>
        <p>HYDRAULIC MATCH</p><h2>Pre-Shipment Inspection Checklist</h2><span
          >Agree the applicable scope before order placement and record evidence
          before release.</span
        >
      </header>
      <div class="print-meta">
        <p>PO / quotation: __________________________</p><p>
          Inspector: __________________
        </p><p>Date: __________________</p>
      </div>
      <div class="print-grid">
        {
          checks.map(([title, items]) => (
            <section>
              <h2>{title}</h2>
              <ul>
                {(items as string[]).map((item) => (
                  <li>
                    <span aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
              <p>
                Evidence / notes:
                _______________________________________________________
              </p>
            </section>
          ))
        }
      </div>
      <aside>
        <strong>Release status</strong><p>
          Approved / Conditional / Hold &nbsp;&nbsp;&nbsp; Authorized by:
          ______________________________
        </p>
      </aside>
      <button type="button" class="print-button" onclick="window.print()"
        >Print checklist</button
      >
    </div>
  </main>
</BaseLayout>

<style>
  .print-checklist {
    padding: 70px 0 90px;
    background: #fff;
  }
  .print-checklist header {
    max-width: 850px;
    margin-bottom: 25px;
  }
  .print-checklist header > p {
    margin: 0;
    color: var(--color-primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .print-checklist header h2 {
    margin: 8px 0;
    font-size: 34px;
    text-transform: none;
  }
  .print-checklist header span {
    color: #536071;
  }
  .print-meta {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 15px;
    padding: 18px;
    border: 1px solid var(--color-stroke);
    background: #f5f7fa;
  }
  .print-meta p {
    margin: 0;
    font-size: 13px;
  }
  .print-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--color-stroke);
    border-left: 1px solid var(--color-stroke);
    margin-top: 22px;
  }
  .print-grid section {
    padding: 24px;
    border-right: 1px solid var(--color-stroke);
    border-bottom: 1px solid var(--color-stroke);
  }
  .print-grid h2 {
    margin: 0 0 16px;
    font-size: 20px;
    text-transform: none;
  }
  .print-grid ul {
    display: grid;
    gap: 11px;
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
  }
  .print-grid li {
    display: flex;
    gap: 10px;
    color: #334155;
    font-size: 14px;
  }
  .print-grid li span {
    width: 15px;
    height: 15px;
    flex: none;
    border: 1px solid #64748b;
  }
  .print-grid section > p {
    margin: 0;
    color: #64748b;
    font-size: 12px;
  }
  .print-checklist aside {
    display: flex;
    gap: 18px;
    margin-top: 20px;
    padding: 18px;
    border-left: 3px solid var(--color-primary);
    background: #f5f7fa;
  }
  .print-checklist aside p {
    margin: 0;
    color: #536071;
  }
  .print-button {
    margin-top: 20px;
    padding: 12px 18px;
    border: 0;
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
    cursor: pointer;
  }
  .print-button:focus-visible {
    outline: 2px solid var(--color-title);
    outline-offset: 3px;
  }
  @media (max-width: 700px) {
    .print-meta,
    .print-grid {
      grid-template-columns: 1fr;
    }
    .print-checklist aside {
      flex-direction: column;
      gap: 5px;
    }
  }
  @media print {
    .header,
    .footer-section,
    .breadcrumb-section,
    .whatsapp-float,
    .floating-quote,
    .rfq-modal,
    .print-button {
      display: none !important;
    }
    .print-checklist {
      padding: 0;
    }
    .print-checklist .container {
      max-width: none;
    }
    .print-grid section {
      break-inside: avoid;
    }
  }
</style>
