---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import { products } from '../../data/products';
import { breadcrumbSchema, itemListSchema, site } from '../../data/site';
import '../../styles/resource-page.css';
---

<BaseLayout
  title="Hydraulic Valves, Pumps and Cylinders from China"
  description="Browse hydraulic valves, pumps, cylinders and selected pump parts. Every inquiry is reviewed by model code, technical parameters and application."
  currentPath="/products"
  jsonLd={[
    breadcrumbSchema([{ name: 'Home', url: site.url }, { name: 'Products', url: `${site.url}/products/` }]),
    itemListSchema(products.map((product) => ({ name: product.title, url: `${site.url}/products/${product.slug}/` }))),
  ]}
>
  <BreadcrumbHero title="Hydraulic Product Categories" trail={[{ label: 'Home', href: '/' }, { label: 'Products' }]} variant="1" />
  <section class="hm-hub">
    <div class="container">
      <header class="hm-hub__intro">
        <p class="hm-kicker">FOCUSED PRODUCT SCOPE</p>
        <h2>Choose a category, then send the complete reference.</h2>
        <p>These pages help you understand the relevant parameters and prepare a qualified RFQ. They do not replace model-specific technical confirmation.</p>
      </header>
      <div class="hm-hub__grid">
        {products.map((product, index) => (
          <a href={`/products/${product.slug}/`} class="hm-hub__card">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h2>{product.title}</h2>
            <p>{product.summary}</p>
            <ul>
              {product.subcategories.slice(0, 4).map((subcategory) => <li>{subcategory.title}</li>)}
            </ul>
            <strong>View category →</strong>
          </a>
        ))}
      </div>
      <div class="hm-hub__cta">
        <div><strong>Not sure which category fits?</strong><p>Upload a nameplate or product photo and tell us the application.</p></div>
        <a href="/request-a-quote/" class="primary-button"><span class="button-text">Request Identification Help</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hm-hub { padding:90px 0; background:#f7f8fa; }
  .hm-hub__intro { max-width:820px; margin-bottom:44px; }
  .hm-kicker { color:var(--color-primary); font-size:13px; font-weight:600; letter-spacing:.13em; margin:0 0 15px; }
  .hm-hub__intro h2 { margin:0 0 16px; }
  .hm-hub__intro p:last-child { color:#536071; line-height:1.65; }
  .hm-hub__grid { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; }
  .hm-hub__card { min-height:390px; padding:34px; background:#fff; border:1px solid var(--color-stroke); color:inherit; text-decoration:none; cursor:pointer; transition:border-color .2s,box-shadow .2s,transform .2s; }
  .hm-hub__card:hover { border-color:var(--color-primary); box-shadow:0 16px 38px rgba(15,23,42,.08); transform:translateY(-2px); }
  .hm-hub__card > span { color:var(--color-primary); font:600 12px var(--font-title); }
  .hm-hub__card h2 { font-size:32px; margin:52px 0 14px; }
  .hm-hub__card p { color:#536071; font-size:16px; line-height:1.6; }
  .hm-hub__card ul { display:flex; flex-wrap:wrap; gap:8px; list-style:none; padding:0; margin:24px 0; }
  .hm-hub__card li { padding:7px 10px; background:#eef3fa; color:#445164; font-size:12px; }
  .hm-hub__card strong { color:var(--color-primary); font-size:15px; }
  .hm-hub__cta { display:flex; justify-content:space-between; align-items:center; gap:30px; margin-top:30px; padding:30px 34px; background:#dce9fa; }
  .hm-hub__cta p { margin:5px 0 0; font-size:15px; color:#536071; }
  @media(max-width:767px){.hm-hub__grid{grid-template-columns:1fr}.hm-hub__cta{align-items:flex-start;flex-direction:column}.hm-hub{padding:70px 0}}
  @media(prefers-reduced-motion:reduce){.hm-hub__card{transition:none}.hm-hub__card:hover{transform:none}}
</style>
