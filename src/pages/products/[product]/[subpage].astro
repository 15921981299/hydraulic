---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../../components/BreadcrumbHero.astro';
import DetailRfqStrip from '../../../components/DetailRfqStrip.astro';
import { productSubpages } from '../../../data/product-subpages';
import { products } from '../../../data/products';
import { breadcrumbSchema, site } from '../../../data/site';
import '../../../styles/resource-page.css';

export function getStaticPaths() {
  return productSubpages.map((subpage) => ({ params: { product: subpage.productSlug, subpage: subpage.slug }, props: { subpage } }));
}

const { subpage } = Astro.props;
const parent = products.find((item) => item.slug === subpage.productSlug)!;
const pageUrl = `${site.url}/products/${subpage.productSlug}/${subpage.slug}/`;
---

<BaseLayout
  title={subpage.seoTitle}
  description={subpage.summary}
  currentPath="/products"
  jsonLd={breadcrumbSchema([{ name: 'Home', url: site.url }, { name: 'Products', url: `${site.url}/products/` }, { name: parent.title, url: `${site.url}/products/${parent.slug}/` }, { name: subpage.title, url: pageUrl }])}
>
  <BreadcrumbHero title={subpage.h1Title} trail={[{ label: 'Home', href: '/' }, { label: 'Products', href: '/products/' }, { label: parent.title, href: `/products/${parent.slug}/` }, { label: subpage.title }]} variant="2" />
  <section class="hm-subpage">
    <div class="container hm-subpage__inner">
      <p class="hm-subpage__lead">{subpage.summary}</p>
      <DetailRfqStrip
        quoteHref={`/request-a-quote/?product=${subpage.slug}`}
        title={`Request ${subpage.title.toLowerCase()} review`}
        text="Send the complete model code, quantity, destination and a clear nameplate photo. We will identify the remaining confirmation points."
      />
      <h2>What must be reviewed</h2>
      <div class="hm-subpage__table">
        {subpage.parameterGroups.map((item, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><strong>{item}</strong><p>Confirm from the original code, datasheet, nameplate, drawing or measured part as applicable.</p></div>)}
      </div>
      <div class="hm-subpage__columns">
        <section><h2>Typical Applications</h2><ul>{subpage.applications.map((item) => <li>{item}</li>)}</ul></section>
        <section><h2>Reference Brands</h2><ul>{subpage.brandReferences.map((item) => <li>{item}</li>)}</ul><p>Names are used for identification only. No affiliation or authorization is implied.</p></section>
      </div>
      <section class="hm-subpage__warning">
        <h2>Required confirmation</h2>
        <ol>{subpage.verification.map((item) => <li>{item}</li>)}</ol>
        <p><strong>Important:</strong> A functional alternative may still require customer review of dimensions, connectors, ports or system settings. Known differences are stated in the quotation.</p>
      </section>
      <p class="hm-subpage__back"><a href={`/products/${parent.slug}/`}>← Back to {parent.title}</a> · <a href="/matching-process/">Matching process</a> · <a href="/request-a-quote/">Request a Match</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .hm-subpage{padding:80px 0 100px;background:#fff}.hm-subpage__inner{max-width:1000px}.hm-subpage__lead{font:500 25px/1.5 var(--font-title);margin:0 0 30px}.hm-subpage h2{margin:58px 0 22px}.hm-subpage__table{border-top:1px solid var(--color-stroke)}.hm-subpage__table>div{display:grid;grid-template-columns:48px 260px 1fr;gap:18px;padding:20px 12px;border-bottom:1px solid var(--color-stroke);align-items:start}.hm-subpage__table span{color:var(--color-primary);font:600 12px var(--font-title)}.hm-subpage__table strong{font-size:16px}.hm-subpage__table p{font-size:15px;color:#596575;margin:0}.hm-subpage__columns{display:grid;grid-template-columns:1fr 1fr;gap:50px}.hm-subpage__columns li,.hm-subpage__warning li{font-size:16px;line-height:1.8;color:#536071}.hm-subpage__columns p{font-size:14px;color:#667181}.hm-subpage__warning{margin-top:60px;padding:34px;background:#eef3fa;border-left:4px solid var(--color-primary)}.hm-subpage__warning h2{margin-top:0}.hm-subpage__warning p{font-size:15px;color:#485568}.hm-subpage__back{margin-top:40px;font-size:15px}.hm-subpage__back a{color:var(--color-primary)}@media(max-width:650px){.hm-subpage__table>div{grid-template-columns:36px 1fr}.hm-subpage__table p{grid-column:2}.hm-subpage__columns{grid-template-columns:1fr}.hm-subpage{padding:60px 0}}
</style>
