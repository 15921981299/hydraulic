---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BreadcrumbHero from "../../../components/BreadcrumbHero.astro";
import DetailPageShell from "../../../components/DetailPageShell.astro";
import DetailRfqStrip from "../../../components/DetailRfqStrip.astro";
import HydraulicProductSidebar from "../../../components/HydraulicProductSidebar.astro";
import { brandCoverage } from "../../../data/brand-coverage";
import { productSubpages } from "../../../data/product-subpages";
import { products } from "../../../data/products";
import { breadcrumbSchema, faqSchema, site } from "../../../data/site";
import "../../../styles/resource-page.css";

export function getStaticPaths() {
  return productSubpages.map((subpage) => ({
    params: { product: subpage.productSlug, subpage: subpage.slug },
    props: { subpage },
  }));
}

const { subpage } = Astro.props;
const parent = products.find((item) => item.slug === subpage.productSlug)!;
const pageUrl = `${site.url}/products/${subpage.productSlug}/${subpage.slug}/`;
const quoteHref = `/request-a-quote/?product=${subpage.slug}`;
const brandHrefFor = (name: string) => {
  const normalized = name.toLowerCase();
  const match = brandCoverage.find((brand) =>
    [brand.name, ...brand.aliases].some((label) => {
      const candidate = label.toLowerCase();
      return normalized.includes(candidate) || candidate.includes(normalized);
    }),
  );
  return match ? `/brands/${match.slug}/` : "";
};
---

<BaseLayout
  title={subpage.seoTitle}
  description={subpage.description}
  currentPath="/products"
  image={parent.image}
  jsonLd={[
    breadcrumbSchema([
      { name: "Home", url: site.url },
      { name: "Products", url: `${site.url}/products/` },
      { name: parent.title, url: `${site.url}/products/${parent.slug}/` },
      { name: subpage.title, url: pageUrl },
    ]),
    ...(subpage.faqs.length ? [faqSchema(subpage.faqs)] : []),
  ]}
>
  <BreadcrumbHero
    title={subpage.h1Title}
    trail={[
      { label: "Home", href: "/" },
      { label: "Products", href: "/products/" },
      { label: parent.title, href: `/products/${parent.slug}/` },
      { label: subpage.title },
    ]}
    variant="2"
  />

  <DetailPageShell intro={subpage.summary}>
    <img
      slot="hero"
      src={parent.image}
      alt={`${subpage.title} reference products for technical matching`}
      width="1536"
      height="1024"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <div class="resource-meta">
      <span><strong>Category</strong> {parent.title}</span>
      <span><strong>Review</strong> Model code and nameplate</span>
      <span><strong>Fit</strong> Ports, mounting, and controls</span>
      <span><strong>Delivery</strong> Global export support</span>
    </div>

    <DetailRfqStrip
      quoteHref={quoteHref}
      title={`Request ${subpage.title.toLowerCase()} review`}
      text="Send the complete model code, quantity, destination and a clear nameplate photo. We will identify the remaining confirmation points."
    />

    {
      subpage.selectionGuide.length > 0 && (
        <section>
          <h2>{subpage.title} Selection Guide</h2>
          <div class="resource-checklist-grid">
            {subpage.selectionGuide.map((item) => (
              <article class="resource-checklist-card">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <h2>What Must Be Reviewed</h2>
    <div class="resource-checklist-grid">
      {
        subpage.parameterGroups.map((item) => (
          <div class="resource-checklist-card">
            <h2>{item}</h2>
            <p>
              Confirm from the original code, datasheet, nameplate, drawing, or
              measured part as applicable.
            </p>
          </div>
        ))
      }
    </div>

    <div class="subpage-context-grid">
      <section class="resource-checklist-card">
        <h2>Typical Applications</h2>
        <ul class="resource-list">
          {subpage.applications.map((item) => <li>{item}</li>)}
        </ul>
      </section>
      <section class="resource-checklist-card">
        <h2>Reference Brands</h2>
        <ul class="resource-list">
          {
            subpage.brandReferences.map((item) => {
              const href = brandHrefFor(item);
              return <li>{href ? <a href={href}>{item}</a> : item}</li>;
            })
          }
        </ul>
        <p>
          Names are used for identification only. No affiliation or
          authorization is implied.
        </p>
      </section>
    </div>

    <section class="resource-note">
      <h2>Required Confirmation</h2>
      <ol class="resource-olist">
        {subpage.verification.map((item) => <li>{item}</li>)}
      </ol>
      <p>
        <strong>Important:</strong> A functional alternative may still require customer
        review of dimensions, connectors, ports, or system settings. Known differences
        are stated in the quotation.
      </p>
    </section>

    {
      subpage.faqs.length > 0 && (
        <section>
          <h2>Frequently Asked Questions</h2>
          <div class="subpage-faq">
            {subpage.faqs.map((faq) => (
              <details>
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    {
      subpage.relatedLinks.length > 0 && (
        <section>
          <h2>Related Technical & Product Pages</h2>
          <div class="subpage-related">
            {subpage.relatedLinks.map((link) => (
              <a href={link.href}>{link.title} →</a>
            ))}
          </div>
        </section>
      )
    }

    <p class="resource-note detail-page-back">
      <a href={`/products/${parent.slug}/`}>Back to {parent.title}</a> ·
      <a href="/matching-process/">Matching process</a> ·
      <a href={quoteHref}>Request a match</a>
    </p>

    <HydraulicProductSidebar
      slot="sidebar"
      activeSlug={parent.slug}
      quoteHref={quoteHref}
    />
  </DetailPageShell>
</BaseLayout>

<style>
  .subpage-context-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 28px;
  }
  .subpage-context-grid h2 {
    margin-top: 0;
  }
  .subpage-faq {
    display: grid;
    gap: 10px;
  }
  .subpage-faq details {
    padding: 16px 18px;
    border: 1px solid var(--color-stroke);
    background: #fff;
  }
  .subpage-faq summary {
    color: var(--color-title);
    font-weight: 700;
    cursor: pointer;
  }
  .subpage-faq p {
    margin: 12px 0 0;
  }
  .subpage-related {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .subpage-related a {
    padding: 11px 14px;
    border: 1px solid var(--color-stroke);
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
  }
  @media (max-width: 768px) {
    .subpage-context-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
