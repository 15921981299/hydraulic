---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbHero from "../../components/BreadcrumbHero.astro";
import DetailPageShell from "../../components/DetailPageShell.astro";
import DetailRfqStrip from "../../components/DetailRfqStrip.astro";
import FunnelPageView from "../../components/FunnelPageView.astro";
import HydraulicProductSidebar from "../../components/HydraulicProductSidebar.astro";
import { brandCoverage } from "../../data/brand-coverage";
import { products } from "../../data/products";
import {
  breadcrumbSchema,
  itemListSchema,
  serviceSchema,
  site,
} from "../../data/site";
import "../../styles/resource-page.css";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const pageUrl = `${site.url}/products/${product.slug}/`;
const quoteHref = `/request-a-quote/?product=${product.slug}`;
const brandHrefFor = (name: string) => {
  const normalized = name.toLowerCase();
  const match = brandCoverage.find((brand) =>
    [brand.name, ...brand.aliases].some((label) => {
      const candidate = label.toLowerCase();
      return normalized.includes(candidate) || candidate.includes(normalized);
    }),
  );
  return match ? `/brands/${match.slug}/` : "";
};
---

<BaseLayout
  title={product.seoTitle}
  description={product.summary}
  currentPath="/products"
  image={product.image}
  jsonLd={[
    breadcrumbSchema([
      { name: "Home", url: site.url },
      { name: "Products", url: `${site.url}/products/` },
      { name: product.title, url: pageUrl },
    ]),
    serviceSchema({
      name: product.title,
      description: product.summary,
      url: pageUrl,
      image: `${site.url}${product.image}`,
    }),
    itemListSchema(
      product.subcategories.map((item) => ({
        name: item.title,
        url: `${pageUrl}${item.slug}/`,
      })),
    ),
  ]}
>
  <FunnelPageView stage="selection" label={`product-${product.slug}`} />
  <BreadcrumbHero
    title={product.h1Title}
    trail={[
      { label: "Home", href: "/" },
      { label: "Products", href: "/products/" },
      { label: product.title },
    ]}
    variant="2"
  />

  <DetailPageShell intro={product.summary}>
    <img
      slot="hero"
      src={product.image}
      alt={`${product.title} reference products for technical matching`}
      width="1536"
      height="1024"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <div class="resource-meta">
      <span><strong>Review</strong> Complete model code</span>
      <span><strong>Fit</strong> Mechanical and hydraulic details</span>
      <span><strong>Application</strong> Operating conditions</span>
      <span><strong>Delivery</strong> Export sourcing support</span>
    </div>

    <p>{product.intro}</p>

    {
      product.buyingGuidance?.length ? (
        <section>
          <h2>{product.title} Buying Guidance</h2>
          <div class="resource-checklist-grid">
            {product.buyingGuidance.map((item) => (
              <article class="resource-checklist-card">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </section>
      ) : null
    }

    <DetailRfqStrip
      quoteHref={quoteHref}
      title={`Request a ${product.title.toLowerCase()} match`}
      text="Send the original brand, complete model code, quantity, destination and a nameplate photo when available."
      modalContext={`${product.title} matching request`}
      modalSource={`product-${product.slug}`}
    />

    {
      product.subcategories.length > 0 && (
        <section class="subpage-links">
          <h2>{product.title} Categories</h2>
          <div class="hub-grid product-subgrid">
            {product.subcategories.map((item) => (
              <a
                href={`/products/${product.slug}/${item.slug}/`}
                class="hub-card subpage-link-card"
              >
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
                <span class="hub-card-link">View selection points →</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section>
      <h2>Parameters We Review</h2>
      <div class="resource-checklist-grid">
        {
          product.parameterGroups.map((item) => (
            <div class="resource-checklist-card">
              <strong>{item}</strong>
            </div>
          ))
        }
      </div>
    </section>

    <section class="product-context-grid">
      <div class="resource-checklist-card">
        <h2>Common Applications</h2>
        <ul class="resource-list">
          {product.applications.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="resource-checklist-card">
        <h2>Reference Brands</h2>
        <p>
          Brand names identify the customer's original component. They do not
          imply affiliation or authorization.
        </p>
        <ul class="resource-list">
          {
            product.brandReferences.map((item) => {
              const href = brandHrefFor(item);
              return <li>{href ? <a href={href}>{item}</a> : item}</li>;
            })
          }
        </ul>
      </div>
    </section>

    <section class="resource-note">
      <h2>Information Required for Technical Review</h2>
      <ol class="resource-olist">
        {product.verification.map((item) => <li>{item}</li>)}
      </ol>
      <p>
        Compatibility is confirmed only after reviewing the complete model code,
        technical parameters, and application conditions.
      </p>
    </section>

    {
      product.relatedLinks?.length ? (
        <section>
          <h2>Related Product, Brand & Series Pages</h2>
          <div class="hub-grid product-related-grid">
            {product.relatedLinks.map((item) => (
              <a href={item.href} class="hub-card">
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
                <span class="hub-card-link">Open related page →</span>
              </a>
            ))}
          </div>
        </section>
      ) : null
    }

    <p class="resource-note detail-page-back">
      <a href="/products/">All products</a> ·
      <a href="/matching-process/">Matching process</a> ·
      <a href={quoteHref}>Request a match</a>
    </p>

    <HydraulicProductSidebar
      slot="sidebar"
      activeSlug={product.slug}
      quoteHref={quoteHref}
    />
  </DetailPageShell>
</BaseLayout>

<style>
  .product-subgrid {
    grid-template-columns: repeat(2, 1fr);
  }
  .product-context-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 28px;
  }
  .product-related-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  .product-context-grid h2 {
    margin-top: 0;
  }
  @media (max-width: 768px) {
    .product-subgrid,
    .product-context-grid,
    .product-related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
