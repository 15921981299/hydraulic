---
import BaseLayout from "../layouts/BaseLayout.astro";
import BreadcrumbHero from "../components/BreadcrumbHero.astro";
import FunnelPageView from "../components/FunnelPageView.astro";
import SectionHeading from "../components/SectionHeading.astro";
import {
  aboutPageSchema,
  breadcrumbSchema,
  howToSchema,
  site,
} from "../data/site";
import {
  credentials,
  inventoryMetrics,
  ownedNetworkEvidence,
  warranty,
} from "../data/commercial-proof";

const pageUrl = `${site.url}/about/`;
const pageTitle = "About Hydraulic Match | Hydraulic Parts Sourcing";
const pageDescription =
  "Learn how Hydraulic Match structures model verification, supplier review, inspection requirements and export inquiries for hydraulic distributors, repair companies and MRO buyers.";
const phoneHref = `tel:${site.phone.replace(/\D/g, "")}`;
const whatsappHref = `https://wa.me/${site.whatsapp.replace(/\D/g, "")}`;
const hasPublishedLegalIdentity = Boolean(
  site.company.verifiedLegalName && site.company.registrationNumber,
);
const publishedAddress = [
  site.company.streetAddress,
  site.company.addressLocality,
  site.company.addressRegion,
  site.company.postalCode,
  site.company.addressCountry,
]
  .filter(Boolean)
  .join(", ");

const inquirySteps = [
  {
    name: "Receive the reference",
    text: "Send the original brand, complete model code, quantity, destination and available nameplate, product or drawing files.",
  },
  {
    name: "Verify the configuration",
    text: "We compare model-code positions, interfaces and operating parameters before classifying a candidate or listing open checks.",
  },
  {
    name: "Confirm the supply route",
    text: "Stock, supplier identity, authorization evidence when relevant, lead time, inspection, warranty and shipping terms are reviewed for the specific quotation.",
  },
  {
    name: "Quote with clear conditions",
    text: "The reply separates confirmed facts, proposed supply, known differences and any buyer confirmation still required.",
  },
];

const companyStandards = [
  "Every quotation identifies the requested reference, proposed model, supply status, lead-time basis and open confirmation items.",
  "Original, manufacturer-authorized and independent aftermarket routes are labelled only when the quoted product and supporting evidence justify that wording.",
  "Compatibility language remains conditional until the complete code, relevant interfaces and recorded application have been reviewed.",
  `Warranty is ${warranty.duration.toLowerCase()} and starts ${warranty.starts}; the accepted quotation must state duration, evidence and exclusions.`,
  "Packing, inspection scope, destination, Incoterm and shipping route are checked before order release when applicable.",
];

const buyerScenarios = [
  {
    title: "Hydraulic distributors",
    text: "Line-by-line RFQ review, neutral packing, repeat sourcing and supporting files for resale and customer approval.",
  },
  {
    title: "Repair and service companies",
    text: "Identification from old nameplates and installation photos, plus interface checks before a controlled replacement.",
  },
  {
    title: "Factory MRO teams",
    text: "Urgent replacement and obsolete-model sourcing with downtime deadline, technical risk and destination considered together.",
  },
  {
    title: "Equipment manufacturers",
    text: "Sample review, application parameters, repeatability and documentation for approved production or service supply.",
  },
];

const differentiators = [
  {
    title: "Verification Before Price",
    text: "We review the full model code, nameplate, interfaces and application before treating a component as ready to quote.",
  },
  {
    title: "Visible Compatibility Conditions",
    text: "Compatibility status, differences, adaptations and unresolved parameters are stated before order confirmation.",
  },
  {
    title: "Commercial Proof With the Order",
    text: "Relevant stock, supplier, authorization, inspection, packing and warranty evidence must be tied to the quoted supply route.",
  },
];

const proofCards = [
  {
    kicker: "Published Coverage",
    title: `${ownedNetworkEvidence.length} evidence groups`,
    text: "Public model, series, resource and review-process records with stated limitations.",
    href: "/commercial-proof/#network",
    link: "Review operating capabilities",
  },
  {
    kicker: "Model Research",
    title: inventoryMetrics[0].value,
    text: `${inventoryMetrics[0].label}; this is content coverage, not live stock.`,
    href: "/commercial-proof/#inventory",
    link: "Review inventory evidence",
  },
  {
    kicker: "Credentials",
    title: "Evidence status",
    text: `${credentials.length} disclosure records explain which authorization, certification and business-identity evidence is not yet public.`,
    href: "/commercial-proof/#credentials",
    link: "Review authorization scope",
  },
  {
    kicker: "Customer Proof",
    title: "No invented reviews",
    text: "Anonymous process examples are not presented as attributed customer testimonials or independent endorsements.",
    href: "/commercial-proof/#credentials",
    link: "Review certifications",
  },
  {
    kicker: "Warranty",
    title: warranty.duration,
    text: `Duration, start point, claim handling and remedies must be stated in the accepted quotation.`,
    href: "/warranty/",
    link: "Read warranty terms",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  currentPath="/about"
  image="/images/hydraulic/hydraulic-match-hero.webp"
  jsonLd={[
    breadcrumbSchema([
      { name: "Home", url: site.url },
      { name: "About Us", url: pageUrl },
    ]),
    aboutPageSchema({
      name: pageTitle,
      description: pageDescription,
      url: pageUrl,
    }),
    howToSchema({
      name: "How Hydraulic Match handles a hydraulic component inquiry",
      description:
        "Send the component reference, complete technical verification, confirm the supply route and receive a conditional quotation.",
      steps: inquirySteps,
    }),
  ]}
>
  <FunnelPageView stage="awareness" label="about" />
  <BreadcrumbHero
    title="About Hydraulic Match — Hydraulic Parts Sourcing"
    trail={[{ label: "Home", href: "/" }, { label: "About Us" }]}
    variant="1"
    image="/images/hydraulic/hydraulic-match-hero.webp"
  />

  <section
    class="about-seo-intro fade-in"
    aria-labelledby="about-intro-heading"
  >
    <div class="container about-seo-intro-inner">
      <p class="about-seo-kicker">
        China hydraulic supply · Technical matching · Global delivery
      </p>
      <h2 id="about-intro-heading" class="about-seo-intro-title">
        A practical sourcing desk for hydraulic component buyers
      </h2>
      <p class="about-seo-intro-text">
        Hydraulic Match helps distributors, repair companies, MRO teams and
        equipment manufacturers source <a href="/products/hydraulic-valves/"
          >hydraulic valves</a
        >,
        <a href="/products/hydraulic-pumps/">hydraulic pumps</a>,
        <a href="/products/hydraulic-pump-parts/">pump parts</a>,
        <a href="/products/hydraulic-motors/">hydraulic motors</a>,
        <a href="/products/hydraulic-repair-kits/">repair kits</a> and
        <a href="/products/hydraulic-cylinders/">hydraulic cylinders</a> with model-code
        verification, documented supply and export support from China.
      </p>
    </div>
  </section>

  <nav
    class="about-resource-links fade-in"
    aria-label="Related company resources"
  >
    <a href="/commercial-proof/">Commercial Evidence Status</a>
    <a href="/series/">Supported Series</a>
    <a href="/cross-reference/">Cross-Reference Review</a>
    <a href="/quality/">Quality Control</a>
    <a href="/warranty/">Warranty Terms</a>
    <a href="/contact/?source=about">Contact Us</a>
  </nav>

  <section
    id="about-mission"
    class="mission-and-vision-section about-section"
    aria-labelledby="about-mission-heading"
  >
    <div class="section-gap">
      <div class="container">
        <div class="mission-and-vision-wrapper">
          <div id="about-mission-heading">
            <SectionHeading
              title="A Technical Supply Desk for Hydraulic Buyers"
              subtitle="Who We Are"
            />
          </div>

          <ul class="about-trust-meta" aria-label="Company capabilities">
            <li>
              <strong>Products</strong> Valves, pumps, pump parts, cylinders
            </li>
            <li>
              <strong>Evidence</strong> Public model and series research records
            </li>
            <li>
              <strong>Supply</strong> Supplier route documented per quotation
            </li>
            <li>
              <strong>Protection</strong> Written order-specific warranty scope
            </li>
          </ul>

          <div class="about-legal-block fade-in">
            <p class="about-legal-kicker">
              Brand identity &amp; public contact
            </p>
            <p class="about-legal-name">
              {
                hasPublishedLegalIdentity
                  ? site.company.verifiedLegalName
                  : site.company.legalNameEn
              }
            </p>
            <p class="about-legal-aka">
              {
                hasPublishedLegalIdentity
                  ? `Registration: ${site.company.registrationNumber}`
                  : "Pre-launch website brand — legal entity details not yet published"
              }
            </p>
            {
              hasPublishedLegalIdentity ? (
                <p class="about-legal-detail">
                  Contracting identity verified for public display. The
                  beneficiary, Incoterm and order-specific conditions remain
                  controlled by the formal quotation and order documents.
                </p>
              ) : (
                <p class="about-legal-detail">
                  Hydraulic Match currently describes a China-based sourcing
                  workflow. It does not yet publish a verified legal entity
                  name, registration number or office address. These details
                  must be confirmed in the formal quotation before payment or
                  order release.
                </p>
              )
            }
            <address class="about-nap">
              <a href={`mailto:${site.email}`}>{site.email}</a>
              <span aria-hidden="true">·</span>
              <a href={phoneHref}>{site.phone}</a>
              <span aria-hidden="true">·</span>
              <a href={whatsappHref} rel="noopener noreferrer" target="_blank"
                >WhatsApp</a
              >
              <span class="about-nap-address">
                {
                  publishedAddress ||
                    "China-based sourcing contact · supplier, inspection and export coordination"
                }
              </span>
            </address>
          </div>

          <div class="about-scope-grid fade-in">
            <article class="about-scope-card">
              <span class="about-scope-kicker">Main Focus</span>
              <h3 class="about-scope-title">
                <a href="/products/">Hydraulic component sourcing</a>
              </h3>
              <p>
                Valves, pumps, pump parts and cylinders for industrial machinery
                and mobile equipment.
              </p>
            </article>
            <article class="about-scope-card">
              <span class="about-scope-kicker">Core Method</span>
              <h3 class="about-scope-title">
                <a href="/matching-process/"
                  >Model-code and interface verification</a
                >
              </h3>
              <p>
                Configuration, pressure, flow, displacement, mounting, ports,
                shaft and electrical checks.
              </p>
            </article>
            <article class="about-scope-card">
              <span class="about-scope-kicker">Best Fit</span>
              <h3 class="about-scope-title">
                <a href="/contact/?source=about-scope">Reference-driven RFQs</a>
              </h3>
              <p>
                Single urgent items, obsolete models, repeat line-item orders
                and multi-line Excel inquiries.
              </p>
            </article>
          </div>

          <section
            id="about-origin"
            class="about-origin-panel fade-in"
            aria-labelledby="about-origin-heading"
          >
            <p class="about-seo-kicker">WHY THIS SITE EXISTS</p>
            <h2 id="about-origin-heading">
              Built from the supply-chain side of hydraulic procurement
            </h2>
            <p>
              Hydraulic Match is being built around the work that happens
              between an incomplete buyer RFQ and a defensible purchase
              decision: reading worn nameplates, separating a series from a
              complete model, comparing supplier replies, recording what is
              still unknown and defining the evidence needed before shipment.
            </p>
            <p>
              The recurring problem is simple: a buyer sends a partial code or a
              photo, several sources reply “same,” and critical differences only
              appear after price has taken over the conversation. We started
              this site to keep the original reference, proposed route,
              technical differences and open checks in one reviewable record.
            </p>
            <p>
              The current research base draws on three existing specialist source
              sites: Rexroth Replacements, RestoPower and Hydraulic Pump Supply.
              Because their public pages identify
              different operators and business roles, every imported model keeps
              its source. Their team history, facility, inventory and warranty
              statements are not silently converted into Hydraulic Match company
              claims.
              <a href="/manufacturing-partners/"
                >Review the three-source disclosure</a
              >.
            </p>
            <div class="about-origin-grid">
              <article>
                <h3>Our supply-chain background</h3>
                <p>
                  The working perspective is sourcing coordination: turning
                  nameplates and line-item lists into questions that a supplier
                  must answer, then connecting the answer to inspection, packing
                  and order documents. It is not presented as ownership of every
                  factory or product shown.
                </p>
              </article>
              <article>
                <h3>How we screen a factory</h3>
                <p>
                  We look for a traceable business identity, relevant product
                  capability, model-code literacy, usable technical data,
                  inspection access and a workable corrective-action response. A
                  marketplace listing alone is not enough.
                </p>
                <a href="/manufacturing-partners/"
                  >See the partner review stages →</a
                >
              </article>
              <article>
                <h3>Who the workflow is for</h3>
                <p>
                  Distributors, hydraulic repair companies, factory MRO teams
                  and equipment manufacturers that need the supply route and its
                  limitations documented—not only a fast price.
                </p>
              </article>
            </div>
          </section>

          <nav class="about-jump-nav" aria-label="On this page">
            <a href="#about-mission" class="about-jump-link">Company focus</a>
            <a href="#about-origin" class="about-jump-link">Why we started</a>
            <a href="#about-different" class="about-jump-link">Why choose us</a>
            <a href="#about-proof" class="about-jump-link">Commercial proof</a>
            <a href="#about-standards" class="about-jump-link">Standards</a>
            <a href="#about-process" class="about-jump-link">RFQ process</a>
            <a href="#about-delivery" class="about-jump-link">Global delivery</a
            >
          </nav>

          <div class="mission-and-vision-content">
            <article class="mission-block fade-in">
              <div class="mission-content-block">
                <div class="mission-subtitle-block">
                  <div class="mission-subtitle-text">Our Mission</div>
                </div>
                <div class="mission-text-block">
                  <h3 class="mission-title">
                    A reliable match starts with complete identification
                  </h3>
                  <p class="mission-summary">
                    A hydraulic component is more than a series name. Spool
                    function, displacement, control, rotation, shaft, flange,
                    ports, voltage, connector and seal options can change
                    compatibility. We organize these facts before availability
                    and price are treated as final.
                  </p>
                  <a href="/matching-process/" class="mission-link-button">
                    <span class="link-button-text"
                      >See Our Matching Process</span
                    >
                    <span class="link-button-icon" aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
              <div class="mission-image-block">
                <img
                  src="/images/hydraulic/hydraulic-valves.webp"
                  alt="Hydraulic valves prepared for model-code and interface verification"
                  class="mission-image"
                  width="1200"
                  height="900"
                  loading="lazy"
                  decoding="async"
                />
                <div class="image-overlay"></div>
              </div>
            </article>

            <article class="vision-block fade-in">
              <div class="vision-content-block">
                <div class="vision-subtitle-block">
                  <div class="vision-subtitle-text">Our Vision</div>
                </div>
                <div class="vision-text-block">
                  <h3 class="vision-title">
                    Clear technical and commercial answers for global buyers
                  </h3>
                  <p class="vision-summary">
                    We connect identification, authorized or qualified supply,
                    inventory, inspection, warranty and export delivery in one
                    accountable inquiry workflow. Referenced original trademarks
                    identify buyer requirements; they do not imply affiliation
                    unless a quotation expressly supplies documented authorized
                    goods.
                  </p>
                  <a
                    href="/contact/?source=about-vision"
                    class="vision-link-button"
                  >
                    <span class="link-button-text">Send Hydraulic Inquiry</span>
                    <span class="link-button-icon" aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
              <div class="vision-image-block">
                <img
                  src="/images/hydraulic/hydraulic-inspection-packing.webp"
                  alt="Hydraulic component inspection and export packing"
                  class="vision-image"
                  width="1200"
                  height="900"
                  loading="lazy"
                  decoding="async"
                />
                <div class="image-overlay"></div>
              </div>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    id="about-different"
    class="who-we-are-section about-section"
    aria-labelledby="about-different-heading"
  >
    <div class="section-gap bottom">
      <div class="container">
        <div id="about-different-heading">
          <SectionHeading
            title="What Makes Hydraulic Match Useful"
            subtitle="Why Choose Us"
          />
        </div>
        <div class="funfact-wrapper about-differentiators-grid fade-in">
          {
            differentiators.map((item, index) => (
              <article class="funfact-single-block">
                <div class="funfact-number-block">
                  <div class="chain-character" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </div>
                </div>
                <div class="funfact-text-block">
                  <h3 class="funfact-title">{item.title}</h3>
                  <p class="funfact-summary">{item.text}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section
    id="about-proof"
    class="about-proof about-section"
    aria-labelledby="about-proof-heading"
  >
    <div class="section-gap bottom">
      <div class="container">
        <div id="about-proof-heading">
          <SectionHeading
            title="Evidence Buyers Can Review"
            subtitle="Commercial Proof"
          />
        </div>
        <div class="about-proof-grid fade-in">
          {
            proofCards.map((item) => (
              <article class="about-proof-card">
                <p class="about-proof-kicker">{item.kicker}</p>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <a href={item.href}>{item.link} →</a>
              </article>
            ))
          }
        </div>
        <aside class="about-testimonials fade-in">
          <div class="about-testimonials-heading">
            <p class="about-seo-kicker">EVIDENCE DISCLOSURE</p>
            <h3>No attributed customer reviews are currently published</h3>
          </div>
          <p class="who-we-are-text">
            The case-study pages are anonymized process records. They explain a
            workflow but do not establish customer identity, satisfaction, sales
            volume or an independent endorsement. Attributed feedback should be
            added only with customer permission and a verifiable source.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section
    id="about-standards"
    class="who-we-are-section about-section"
    aria-labelledby="about-standards-heading"
  >
    <div class="section-gap bottom">
      <div class="container">
        <div id="about-standards-heading">
          <SectionHeading
            title="Commercial Standards for Hydraulic Buyers"
            subtitle="How We Work"
          />
        </div>
        <div class="about-standards-layout fade-in">
          <article class="about-standards-panel">
            <h3>What a serious RFQ reply should make clear</h3>
            <ul>
              {companyStandards.map((item) => <li>{item}</li>)}
            </ul>
          </article>
          <div class="about-buyer-scenarios">
            {
              buyerScenarios.map((item) => (
                <article>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    id="about-process"
    class="who-we-are-section about-section"
    aria-labelledby="about-process-heading"
  >
    <div class="section-gap bottom">
      <div class="container">
        <div id="about-process-heading">
          <SectionHeading
            title="How We Handle a Hydraulic Inquiry"
            subtitle="RFQ Process"
          />
        </div>
        <ol class="about-process-layout fade-in">
          {
            inquirySteps.map((step, index) => (
              <li class="about-process-card">
                <span class="about-process-step" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3>{step.name}</h3>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
        <div class="about-rfq-note fade-in">
          <div>
            <h3>What helps us quote faster?</h3>
            <p>
              A complete model code, clear nameplate and product photos,
              quantity, destination, operating parameters and required delivery
              date reduce back-and-forth.
            </p>
          </div>
          <a href="/contact/?source=about-process" class="about-inline-cta">
            Send inquiry details →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section
    id="about-delivery"
    class="who-we-are-section about-section"
    aria-labelledby="about-delivery-heading"
  >
    <div class="section-gap bottom">
      <div class="container">
        <div id="about-delivery-heading">
          <SectionHeading
            title="Hydraulic Supply From China to Global Buyers"
            subtitle="Delivery Support"
          />
        </div>
        <div class="who-we-are-wrapper fade-in">
          <div class="who-we-are-content-block">
            <p class="who-we-are-text">
              Hydraulic Match coordinates availability checks, supplier
              communication, inspection, protective packing and export delivery
              from China. Express, air and freight options are reviewed
              according to product size, urgency and destination. For downtime
              requirements, include the destination and deadline in your first
              <a href="/contact/?source=about-delivery">hydraulic inquiry</a>.
            </p>
            <p class="who-we-are-text about-disclaimer">
              Hydraulic Match is an independent sourcing service. Referenced
              manufacturer names and model numbers are used to identify
              compatibility requirements. Manufacturer authorization is claimed
              only when a current document identifies the legal holder, issuer,
              territory, product scope and validity for the quoted route.
            </p>
            <p class="about-factory-cta-row">
              <a href="/contact/?source=about-delivery" class="about-inline-cta"
                >Send an inquiry →</a
              >
              <a
                href="/shipping/"
                class="about-inline-cta about-inline-cta--secondary"
              >
                Shipping support
              </a>
              <a
                href="/commercial-proof/"
                class="about-inline-cta about-inline-cta--secondary"
              >
                Commercial proof
              </a>
            </p>
          </div>
          <div class="who-we-are-image-block about-factory-image">
            <img
              src="/images/hydraulic/hydraulic-inspection-packing.webp"
              alt="Hydraulic components inspected and packed for international delivery"
              class="who-we-are-image"
              width="1200"
              height="900"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-section {
    scroll-margin-top: 100px;
  }
  .about-seo-intro {
    margin-top: 4rem;
  }
  .about-seo-intro-inner {
    max-width: 850px;
    margin: 0 auto;
    padding: 0 20px 1.15rem;
    text-align: center;
  }
  .about-seo-kicker {
    margin: 0 0 0.45rem;
    color: var(--color-primary);
    font-family: var(--font-title);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .about-seo-intro-title {
    margin: 0 0 0.55rem;
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    font-weight: 700;
    line-height: 1.25;
    text-transform: none;
  }
  .about-seo-intro-text {
    max-width: 72ch;
    margin: 0 auto;
    color: #334155;
    font-size: 15px;
    line-height: 1.75;
  }
  .about-seo-intro-text a,
  .who-we-are-text a {
    color: var(--color-title);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(20, 110, 245, 0.35);
    text-underline-offset: 3px;
  }
  .about-seo-intro-text a:hover,
  .who-we-are-text a:hover {
    color: var(--color-primary);
    text-decoration-color: var(--color-primary);
  }
  .about-resource-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    max-width: 980px;
    margin: 0 auto 0.5rem;
    padding: 0 20px;
  }
  .about-resource-links a,
  .about-jump-link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 14px;
    border: 1px solid rgba(20, 110, 245, 0.2);
    border-radius: 999px;
