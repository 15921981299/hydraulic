---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FunnelPageView from "../components/FunnelPageView.astro";
import { brandCoverage, brandCoverageStats } from "../data/brand-coverage";
import { faqSchema, howToSchema, itemListSchema, site } from "../data/site";

const productCategories = [
  {
    href: "/products/hydraulic-valves/",
    title: "Hydraulic Valves",
    summary:
      "Directional, pressure, flow, modular, check and selected proportional valve sourcing.",
    image: "/images/hydraulic/hydraulic-valves.webp",
    imagePosition: "center",
  },
  {
    href: "/products/hydraulic-pumps/",
    title: "Hydraulic Pumps",
    summary:
      "Axial piston, vane and gear pumps reviewed by complete model code and application.",
    image: "/images/hydraulic/hydraulic-pumps.webp",
    imagePosition: "center",
  },
  {
    href: "/products/hydraulic-cylinders/",
    title: "Hydraulic Cylinders",
    summary:
      "Standard and custom cylinders developed from drawings, samples and operating data.",
    image: "/images/hydraulic/hydraulic-cylinders.webp",
    imagePosition: "center",
  },
  {
    href: "/products/hydraulic-motors/",
    title: "Hydraulic Motors",
    summary:
      "Orbital, piston, radial piston, swing and travel motors reviewed with machine and interface data.",
    image: "/images/hydraulic/hydraulic-pumps.webp",
    imagePosition: "center",
  },
  {
    href: "/products/hydraulic-repair-kits/",
    title: "Repair Kits & Service Parts",
    summary:
      "Seal kits, rotating groups, cartridges and service parts identified from the complete parent-unit code.",
    image: "/images/hydraulic/hydraulic-inspection-packing.webp",
    imagePosition: "center",
  },
];

const workflowSteps = [
  {
    step: "01",
    title: "Send the Model or Nameplate",
    summary:
      "Share the original brand, complete model code, order number, quantity, destination, and available photos or drawings.",
  },
  {
    step: "02",
    title: "We Review Key Parameters",
    summary:
      "We compare function, pressure, flow, voltage, mounting, ports, shaft, rotation and application conditions as applicable.",
  },
  {
    step: "03",
    title: "Receive an Option and Quote",
    summary:
      "The quotation identifies the sourcing route, known differences, open confirmations, MOQ, lead time and commercial terms.",
  },
  {
    step: "04",
    title: "Confirm, Sample and Order",
    summary:
      "For higher-risk items, a sample or first-article review is recommended before batch or repeat purchasing.",
  },
];

const quoteStandards = [
  {
    title: "Model-code review",
    body: "The complete reference, order number and nameplate are checked before a proposed option is treated as ready for quotation.",
  },
  {
    title: "Parameter comparison",
    body: "The relevant hydraulic, electrical and mechanical parameters are compared rather than assuming interchangeability from a series name.",
  },
  {
    title: "Known differences stated",
    body: "Dimensions, connectors, ports, control behavior or application limitations that still require review are shown clearly.",
  },
  {
    title: "Commercial scope labelled",
    body: "MOQ, lead time, inspection, packing, warranty, Incoterm and customer confirmation points are recorded by line item.",
  },
];

const brandReferences = [
  ...brandCoverage.slice(0, 7).map((brand) => ({
    href: `/brands/${brand.slug}/`,
    title: brand.name,
    summary: brand.summary,
  })),
  {
    href: "/brands/",
    title: `All ${brandCoverageStats.brands} Brand Groups`,
    summary: `Browse ${brandCoverageStats.seriesReferences} organized series-level entries before submitting the complete code.`,
  },
];

const applications = [
  { name: "Industrial Machinery", href: "/industries/industrial-machinery/" },
  {
    name: "Construction Equipment",
    href: "/industries/construction-equipment/",
  },
  { name: "Metal Forming", href: "/industries/metal-forming/" },
  { name: "Plastics Machinery", href: "/industries/plastics-machinery/" },
  {
    name: "Mining & Material Handling",
    href: "/request-a-quote/?source=mining-material-handling",
  },
  { name: "MRO & Repair", href: "/distributor-support/" },
];

const technicalChecks = [
  "Complete model code and order number",
  "Pressure, flow or displacement",
  "Spool function or control type",
  "Voltage, connector and coil",
  "Mounting interface and port details",
  "Rotation, flange and shaft",
  "Fluid, seals and temperature",
  "Machine, duty cycle and environment",
];

const guides = [
  {
    href: "/models/",
    title: "Review Exact Model Records",
    subtitle: "See reviewed code groups and required checks.",
  },
  {
    href: "/tools/",
    title: "Use Hydraulic Calculators",
    subtitle: "Estimate flow, power, force and unit conversions.",
  },
  {
    href: "/downloads/",
    title: "Download RFQ Templates",
    subtitle: "Structure model, quantity and inspection requirements.",
  },
  {
    href: "/case-studies/",
    title: "Read Documented Cases",
    subtitle: "Follow evidence, review actions, outcomes and limits.",
  },
  {
    href: "/resources/hydraulic-pump-sizing-flow-pressure-power/",
    title: "Size Pump Flow and Power",
    subtitle: "Use formulas, units and worked examples.",
  },
  {
    href: "/resources/hydraulic-pump-cavitation-suction-line/",
    title: "Diagnose Pump Cavitation",
    subtitle: "Check the inlet system before replacing the pump.",
  },
  {
    href: "/resources/hydraulic-valve-pressure-drop-heat/",
    title: "Compare Valve Pressure Drop",
    subtitle: "Estimate heat and review real flow conditions.",
  },
  {
    href: "/resources/hydraulic-component-pre-shipment-inspection-checklist/",
    title: "Build an Inspection Checklist",
    subtitle: "Define order-linked evidence before purchase.",
  },
];

const faqs = [
  {
    question: "Can a replacement be confirmed from the series name alone?",
    answer:
      "Usually not. The complete model code, technical parameters and application conditions must be reviewed.",
  },
  {
    question: "What if the complete model code is unavailable?",
    answer:
      "Upload the full nameplate and product photos. A drawing, old quotation or datasheet can also help identify the missing information.",
  },
  {
    question: "Are referenced manufacturer names an authorization claim?",
    answer:
      "No. Names and model numbers are used only for identification and cross-reference. Hydraulic Match is independent from the referenced manufacturers.",
  },
];
---

<BaseLayout
  title="Chinese Hydraulic Valves, Pumps & Cylinders | Hydraulic Match"
  description="Send a hydraulic model code, nameplate photo or drawing. Hydraulic Match reviews key parameters and sources suitable Chinese valve, pump and cylinder options."
  currentPath="/"
  jsonLd={[
    itemListSchema(
      productCategories.map((item) => ({
        name: item.title,
        url: `${site.url}${item.href}`,
      })),
    ),
    howToSchema({
      name: "How Hydraulic Match reviews a hydraulic component request",
      description:
        "Four steps from model-code submission to sample and order confirmation.",
      steps: workflowSteps.map((step) => ({
        name: step.title,
        text: step.summary,
      })),
    }),
    faqSchema(faqs),
  ]}
>
  <FunnelPageView stage="selection" label="homepage" />

  <section class="hero-section">
    <div class="container">
      <div class="hero-wrapper">
        <div class="hero-content-block">
          <div class="hero-subtitle-block fade-in">
            <span class="hero-subtitle-icon hm-badge-icon" aria-hidden="true"
              >HM</span
            >
            <div class="hero-subtitle-text">{site.tagline}</div>
          </div>
          <div class="hero-title-block">
            <h1 class="hero-title fade-in">
              Chinese Alternatives for Hydraulic<br /><span
                class="hero-mobile-gap"
                aria-hidden="true">&nbsp;</span
              >Valves, Pumps and Cylinders
            </h1>
          </div>
          <div class="hero-bottom-content-block">
            <div class="hero-summary-block">
              <p class="hero-summary">
                Send the original model code, nameplate photo or technical
                drawing. We review the key parameters and provide suitable
                Chinese sourcing options for your application.
              </p>
            </div>
            <div class="hero-button-block">
              <div class="hero-cta-row">
                <a
                  href="/request-a-quote/?source=homepage"
                  class="secondary-button hero"
                >
                  <div class="button-content-block">
                    <div class="button-text">Request a Match</div><div
                      class="button-text"
                    >
                      Request a Match
                    </div>
                  </div>
                </a>
                <a href="/products/" class="hero-secondary-cta"
                  >Browse Product Categories</a
                >
              </div>
              <ul class="hero-trust-row" aria-label="Key service points">
                <li>Model-code review</li>
                <li>Small-batch RFQs welcome</li>
                <li>Export support from China</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="hero-image-block">
          <img
            src="/images/hydraulic/hydraulic-match-hero.webp"
            alt="Unbranded hydraulic directional valve, piston pump and cylinder arranged for technical sourcing review"
            class="hero-image hm-hero-image"
            width="1536"
            height="1024"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="hero-image-overlay image-overlay fade-in"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="service-section">
    <div class="section-gap bottom">
      <div class="container">
        <div class="service-wrapper">
          <SectionHeading
            title="Hydraulic Product Categories"
            subtitle="What We Source"
          />
          <div class="service-bottom-block fade-in">
            <p class="service-bottom-text service-bottom-hint">
              Not sure which category fits? <a
                href="/request-a-quote/"
                class="service-bottom-link"
                >Send the nameplate or product photo</a
              > and we will identify the information needed.
            </p>
          </div>
          <div class="service-card-sticky-block fade-in">
            {
              productCategories.map((item) => (
                <div class="service-card-item-block">
                  <a href={item.href} class="service-card-image-block">
                    <img
                      src={item.image}
                      alt={`${item.title} reference products for sourcing review`}
                      class="service-card-image hm-service-image"
                      style={`object-position:${item.imagePosition}`}
                      width="1536"
                      height="1024"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="service-card-image-overlay">
                      <div class="service-card-icon-block">
                        <span
                          class="service-hover-icon hm-arrow"
                          aria-hidden="true"
                        >
                          ↗
                        </span>
                      </div>
                    </div>
                  </a>
                  <div class="service-card-content-block">
                    <div class="service-card-text-block">
                      <a href={item.href} class="service-title-link-block">
                        <h3 class="service-card-title">{item.title}</h3>
                      </a>
                      <p class="service-card-summary">{item.summary}</p>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="booking-steps-section">
    <div class="section-gap bottom">
      <div class="container">
        <div class="booking-steps-wrapper">
          <SectionHeading
            title="How It Works"
            subtitle="From Model Code to Order"
          />
          <div class="booking-steps-content-block fade-in">
            <div class="booking-steps-sticky-block">
              {
                workflowSteps.map((item, index) => (
                  <div
                    class:list={["booking-step-card-block", `is-${index + 1}`]}
                  >
                    <div class="booking-step-image-block">
                      <img
                        src={
                          index === 0
                            ? "/images/hydraulic/hydraulic-match-hero.webp"
                            : index === 1
                              ? "/images/hydraulic/hydraulic-inspection-packing.webp"
                              : index === 2
                                ? "/images/hydraulic/hydraulic-valves.webp"
                                : "/images/hydraulic/hydraulic-cylinders.webp"
                        }
                        alt=""
                        aria-hidden="true"
                        class="booking-step-image hm-step-image"
                        width="1536"
                        height="1024"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="booking-step-card-text-block">
                      <span class="booking-step-number" aria-hidden="true">
                        {item.step}
                      </span>
                      <h3 class="booking-step-title">{item.title}</h3>
                      <p class="booking-step-summary">{item.summary}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="quote-standard-section section-gap bottom"
    aria-labelledby="quote-standard-heading"
  >
    <div class="container">
      <SectionHeading
        title="Technical Review & Quotation Standard"
        subtitle="How We Reduce Replacement Risk"
      />
      <div class="quote-standard-grid fade-in">
        {
          quoteStandards.map((item, index) => (
            <article class="quote-standard-card">
              <span class="quote-standard-number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
      <p class="quote-standard-note">
        Hydraulic Match is an independent sourcing service. Manufacturer names
        and model numbers identify the customer's original reference; they do
        not imply affiliation or authorization.
      </p>
    </div>
  </section>

  <section class="pricing-section">
    <div class="section-gap bottom">
      <div class="container">
        <SectionHeading
          title="Reference Brands We Review"
          subtitle="Brand Coverage"
        />
        <div class="materials-grid fade-in">
          {
            brandReferences.map((item) => (
              <a href={item.href} class="material-card material-card--link">
                <h3 class="material-name">{item.title}</h3>
                <p class="material-grades">{item.summary}</p>
              </a>
            ))
          }
        </div>
        <p class="materials-note">
          Brand names are used for identification only. Directory inclusion
          means the reference can enter technical review; stock, authorization
          and compatibility are confirmed per inquiry.
        </p>
      </div>
    </div>
  </section>

  <section class="map-section">
    <div class="section-gap map map-section--flush">
      <div class="container">
        <SectionHeading title="Applications We Serve" subtitle="Your Sector" />
        <div class="industries-grid fade-in">
          {
            applications.map((application, index) => (
              <a href={application.href} class="industry-card">
                <div
                  class="industry-icon hm-industry-number"
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, "0")}
                </div>
                <div class="industry-name">{application.name}</div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section
    class="hm-evidence-section section-gap bottom"
    aria-labelledby="evidence-heading"
  >
    <div class="container hm-evidence-grid">
      <div class="hm-evidence-image">
        <img
          src="/images/hydraulic/hydraulic-inspection-packing.webp"
          alt="Representative illustration of a hydraulic valve dimension check and packing preparation"
          width="1536"
          height="1024"
          loading="lazy"
          decoding="async"
        />
        <p>
          Representative process illustration. It is not evidence of an
          inspection for a specific order.
        </p>
      </div>
      <div class="hm-evidence-copy">
        <p class="hm-kicker">VERIFIABLE BY ORDER</p>
        <h2 id="evidence-heading">
          Ask for the evidence your order actually needs.
        </h2>
        <p>
          Inspection scope depends on the product, supplier capability and
          agreed quotation. We can record model and quantity checks, critical
          dimensions, markings, connector or shaft details, packing photos and
          available test records.
        </p>
        <ul>
          <li>Requirements confirmed before purchase</li>
          <li>Photos and records linked to the quoted item</li>
          <li>Unconfirmed points stated instead of assumed</li>
        </ul>
        <div class="hm-evidence-links">
          <a href="/trust/">Trust center</a><a href="/quality/"
            >Quality &amp; verification</a
          ><a href="/distributor-support/">Distributor support</a>
        </div>
      </div>
    </div>
  </section>

  <section
    class="hm-faq-section section-gap bottom"
    aria-labelledby="faq-heading"
  >
    <div class="container">
      <SectionHeading
        title="Hydraulic Matching Questions"
        subtitle="Before You Request a Quote"
      />
      <div class="hm-faq-list" id="faq-heading">
        {
          faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="hm-technical-section section-gap bottom">
    <div class="container">
      <SectionHeading
        title="Technical Details We Compare"
        subtitle="More Than a Part Number Search"
      />
      <div class="hm-technical-grid fade-in">
        {
          technicalChecks.map((item, index) => (
            <div>
              <>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{item}</strong>
              </>
            </div>
          ))
        }
      </div>
      <p class="materials-note">
        The applicable checks depend on whether the request is a valve, pump,
        pump part or cylinder.
      </p>
    </div>
  </section>

  <section
    class="home-rfq-hub section-gap bottom"
    aria-labelledby="home-rfq-hub-heading"
  >
    <div class="container">
      <div class="home-rfq-hub-card fade-in">
        <h2 id="home-rfq-hub-heading" class="home-rfq-hub-title">
          Need help identifying or replacing a hydraulic component?
        </h2>
        <p class="home-rfq-hub-lead">
          Send the original model, nameplate or drawing. We will explain what
          can be reviewed and which confirmation points are still open.
        </p>
        <div class="home-rfq-hub-actions">
          <a
            href="/request-a-quote/?source=homepage-hub"
            class="secondary-button hero home-rfq-hub-primary"
          >
            <div class="button-content-block">
              <div class="button-text">Request a Match</div><div
                class="button-text"
              >
                Request a Match
              </div>
            </div>
          </a>
          <a href="/matching-process/" class="home-rfq-hub-secondary"
            >See matching process →</a
          >
        </div>
        <div class="home-rfq-hub-catalog">
          <div class="home-rfq-hub-catalog-label">Technical Guides</div>
          <div class="home-rfq-hub-catalog-grid" role="list">
            {
              guides.map((guide) => (
                <a href={guide.href} class="catalog-hub-card" role="listitem">
                  <div class="catalog-hub-card-body">
                    <>
                      <h3 class="catalog-hub-card-title">{guide.title}</h3>
                      <p class="catalog-hub-card-subtitle">{guide.subtitle}</p>
                    </>
                  </div>
                  <span class="catalog-hub-card-arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hm-badge-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--color-primary);
    border-radius: 50%;
    color: var(--color-primary);
    font: 600 9px var(--font-title);
    flex: none;
  }
  .hero-mobile-gap {
    display: none;
  }
  .hm-hero-image {
    object-position: center;
    filter: saturate(0.9);
  }
  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 20px;
  }
  .hero-secondary-cta {
    font-family: var(--font-title);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-title);
    text-decoration: none;
    padding: 12px 4px;
    border-bottom: 2px solid transparent;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .hero-secondary-cta:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
  .hero-trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    color: #475569;
  }
  .hero-trust-row li::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
    margin-right: 8px;
    vertical-align: middle;
  }
  .hm-service-image {
    object-fit: cover;
  }
  .hm-arrow {
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 24px;
  }
  .hm-step-image {
    object-fit: cover;
  }
  .quote-standard-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .quote-standard-card {
    padding: 26px 24px;
    border: 1px solid var(--color-stroke);
    background: #fff;
  }
  .quote-standard-number {
    font: 600 12px var(--font-title);
    color: var(--color-primary);
  }
  .quote-standard-card h3 {
    font-size: 20px;
    margin: 46px 0 12px;
  }
  .quote-standard-card p {
    font-size: 15px;
    line-height: 1.6;
    color: #536071;
    margin: 0;
  }
  .quote-standard-note,
  .materials-note {
    margin: 24px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: #64748b;
  }
  .materials-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .material-card {
    padding: 28px;
    border: 1px solid var(--color-stroke);
    background: #fff;
  }
  .material-card--link {
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .material-card--link:hover {
    border-color: rgba(20, 110, 245, 0.45);
    box-shadow: 0 5px 18px rgba(20, 110, 245, 0.08);
  }
  .material-card--link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .material-name {
    font-size: 22px;
    margin: 0 0 14px;
  }
  .material-grades {
    font-size: 14px;
    line-height: 1.6;
    color: #536071;
    margin: 0;
  }
  .industries-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .industry-card {
    min-height: 150px;
    padding: 24px;
    border: 1px solid var(--color-stroke);
    background: #fff;
    display: flex;
    align-items: center;
    gap: 18px;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .industry-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }
  .hm-industry-number {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: rgba(20, 110, 245, 0.1);
    color: var(--color-primary);
    font: 600 13px var(--font-title);
    flex: none;
  }
  .industry-name {
    font: 600 18px var(--font-title);
  }
  .hm-technical-section {
    padding-top: 60px;
  }
  .hm-technical-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--color-stroke);
    border-left: 1px solid var(--color-stroke);
  }
  .hm-technical-grid > div {
    min-height: 118px;
