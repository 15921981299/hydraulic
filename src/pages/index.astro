---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FunnelPageView from "../components/FunnelPageView.astro";
import { brandCoverage, brandCoverageStats } from "../data/brand-coverage";
import { faqSchema, howToSchema, itemListSchema, site } from "../data/site";

const productCategories = [
  {
    href: "/products/hydraulic-valves/",
    title: "Hydraulic Valves",
    summary:
      "Directional, pressure, flow, modular, check and selected proportional or servo valve sourcing.",
    scope:
      "Directional · pressure · flow · modular · check · proportional",
    review:
      "Function, spool, size, pressure, flow, voltage, connector, mounting and seals",
    linkLabel: "Browse hydraulic valve categories",
    image: "/images/hydraulic/hydraulic-valves.webp",
    imagePosition: "center",
  },
  {
    href: "/products/hydraulic-pumps/",
    title: "Hydraulic Pumps",
    summary:
      "Axial piston, vane and gear pumps reviewed by complete model code and application.",
    scope: "Axial piston · vane · gear pumps",
    review:
      "Displacement, control, pressure, rotation, shaft, flange, ports and duty",
    linkLabel: "Browse hydraulic pump categories",
    image: "/images/hydraulic/hydraulic-pumps.webp",
    imagePosition: "center",
  },
  {
    href: "/products/hydraulic-cylinders/",
    title: "Hydraulic Cylinders",
    summary:
      "Standard and custom cylinders developed from drawings, samples and operating data.",
    scope: "Standard industrial · custom · replacement cylinders",
    review:
      "Bore, rod, stroke, mounting, ports, pressure, load, speed and environment",
    linkLabel: "Browse hydraulic cylinder options",
    image: "/images/hydraulic/hydraulic-cylinders.webp",
    imagePosition: "center",
  },
  {
    href: "/products/hydraulic-motors/",
    title: "Hydraulic Motors",
    summary:
      "Orbital, piston, radial piston, swing and travel motors reviewed with machine and interface data.",
    scope: "Orbital · axial piston · radial piston · swing and travel",
    review:
      "Displacement, torque, speed, shaft, flange, ports, brake and machine duty",
    linkLabel: "Browse hydraulic motor categories",
    image: "/images/hydraulic/hydraulic-pumps.webp",
    imagePosition: "center",
  },
  {
    href: "/products/hydraulic-repair-kits/",
    title: "Repair Kits & Service Parts",
    summary:
      "Seal kits, rotating groups, cartridges and service parts identified from the complete parent-unit code.",
    scope: "Seal kits · rotating groups · cartridges · valve and motor parts",
    review:
      "Parent-unit code, part number, revision, dimensions, material and kit scope",
    linkLabel: "Browse hydraulic repair parts",
    image: "/images/hydraulic/hydraulic-inspection-packing.webp",
    imagePosition: "center",
  },
];

const workflowSteps = [
  {
    step: "01",
    stage: "IDENTIFICATION INPUT",
    title: "Submit the Original Hydraulic Reference",
    summary:
      "Send the original brand, complete model or part number, quantity and destination, supported by a nameplate, product photos, drawing or datasheet when available.",
    output:
      "Input: model code · nameplate · photos · quantity · destination",
  },
  {
    step: "02",
    stage: "TECHNICAL REVIEW",
    title: "Identify the Configuration and Compare Parameters",
    summary:
      "The review separates the product family and configuration, then compares the hydraulic, electrical, mechanical and application details relevant to that component.",
    output:
      "Review: function · ratings · controls · interfaces · application",
  },
  {
    step: "03",
    stage: "QUOTATION OUTPUT",
    title: "Receive a Documented Sourcing Option and Quote",
    summary:
      "The quotation identifies the proposed model and supply route, compatibility status, known differences, open checks, condition, MOQ, lead-time basis and commercial terms.",
    output:
      "Output: proposed model · status · differences · price and terms",
  },
  {
    step: "04",
    stage: "APPROVAL & ORDER",
    title: "Approve Differences, Sample When Needed, Then Order",
    summary:
      "The buyer confirms open points and required inspection evidence. Higher-risk or changed models should begin with a sample or first-article review before batch purchasing.",
    output:
      "Decision: approval · inspection · sample/first article · order",
  },
];

const quoteStandards = [
  {
    category: "IDENTIFICATION",
    title: "Requested reference stays traceable",
    body: "The original brand, complete model or part number, nameplate and supporting photos remain attached to the line item being reviewed.",
    output: "Requested reference · evidence reviewed · missing data",
  },
  {
    category: "TECHNICAL COMPARISON",
    title: "Compatibility status is explicit",
    body: "Hydraulic, electrical and mechanical parameters are compared before an option is labelled confirmed, conditional or still open.",
    output: "Confirmed · conditional · open check",
  },
  {
    category: "DIFFERENCES & APPROVAL",
    title: "Known differences remain visible",
    body: "Changes in dimensions, connectors, ports, control behavior, material condition or application limits are not hidden inside a generic equivalent claim.",
    output: "Difference · consequence · customer confirmation",
  },
  {
    category: "COMMERCIAL SCOPE",
    title: "Supply and inspection terms are separated",
    body: "The quotation records the proposed source and condition together with MOQ, lead-time basis, inspection scope, packing, warranty and Incoterm.",
    output: "Source · condition · MOQ · lead time · QC · Incoterm",
  },
];

const brandReferences = [
  ...brandCoverage.slice(0, 7).map((brand) => ({
    href: `/brands/${brand.slug}/`,
    title: brand.name,
    summary: brand.summary,
    meta: `${brand.seriesReferences.length} series-level entries`,
    series: brand.seriesReferences
      .slice(0, 3)
      .map((item) => item.series)
      .join(" · "),
    linkLabel: `Review ${brand.name} references`,
    isDirectory: false,
  })),
  {
    href: "/brands/",
    title: "Complete Hydraulic Brand Directory",
    summary: `Browse all ${brandCoverageStats.brands} manufacturer reference groups and ${brandCoverageStats.seriesReferences} organized series-level entries.`,
    meta: "FULL REFERENCE INDEX",
    series: "Brand groups · series directory · exact model records",
    linkLabel: "Open the complete brand directory",
    isDirectory: true,
  },
];

const applications = [
  {
    name: "Industrial Machinery & Factory MRO",
    href: "/industries/industrial-machinery/",
    summary:
      "Hydraulic valves, pumps, cylinders and service parts for production equipment, power units and maintenance replacement work.",
    focus: "Legacy model codes · duty cycle · installed interfaces",
    linkLabel: "Explore industrial machinery hydraulics",
  },
  {
    name: "Construction & Mobile Equipment",
    href: "/industries/construction-equipment/",
    summary:
      "Main pumps, travel and swing motors, control valves and cylinders reviewed against the machine and operating environment.",
    focus: "Machine model · controls · shaft, ports and rotation",
    linkLabel: "Explore construction equipment hydraulics",
  },
  {
    name: "Hydraulic Presses & Metal Forming",
    href: "/industries/metal-forming/",
    summary:
      "Component review for press and forming functions where force, pressure holding, sequencing and cycle behavior matter.",
    focus: "Pressure-flow cycle · valve logic · cylinder geometry",
    linkLabel: "Explore press and metal-forming hydraulics",
  },
  {
    name: "Injection Molding & Plastics Machinery",
    href: "/industries/plastics-machinery/",
    summary:
      "Hydraulic pumps, proportional valves and related components compared for repeatable pressure, flow and response.",
    focus: "Control signal · feedback · temperature · cycle baseline",
    linkLabel: "Explore plastics machinery hydraulics",
  },
  {
    name: "Mining & Material Handling",
    href: "/request-a-quote/?source=mining-material-handling",
    summary:
      "An inquiry route for pumps, motors, valves and cylinders used in selected high-load mobile and material-handling equipment.",
    focus: "Load and duty · contamination · machine evidence",
    linkLabel: "Submit an application inquiry",
  },
  {
    name: "Hydraulic Repair, MRO & Distribution",
    href: "/distributor-support/",
    summary:
      "Structured support for obsolete references, repair parts, mixed-model RFQ lists and repeat replacement purchasing.",
    focus: "Complete codes · condition · differences · open checks",
    linkLabel: "See distributor and MRO support",
  },
];

const orderEvidenceScopes = [
  {
    category: "IDENTITY & QUANTITY",
    title: "Product identity and order count",
    body: "Photos can record the product, nameplate, model or part number, visible markings, condition and packed quantity against the quoted line item.",
    examples: "Nameplate · model marking · item count · package label",
  },
  {
    category: "DIMENSIONS & INTERFACES",
    title: "Critical fit and connection checks",
    body: "Agreed dimensions and interfaces can be recorded where they affect installation, including mounting, ports, shaft, connector or overall envelope.",
    examples: "Mounting · ports · shaft · connector · key dimensions",
  },
  {
    category: "FUNCTION & TEST RECORDS",
    title: "Available inspection or test results",
    body: "Pressure, leakage, electrical or other functional records must be defined by product and supplier capability; they are included only when stated in the quotation.",
    examples: "Test item · method · acceptance limit · recorded result",
  },
  {
    category: "PACKING & SHIPMENT",
    title: "Protection, labels and packing evidence",
    body: "Pre-shipment photos can document protective caps, inner packaging, labels, carton or crate condition and the final packed quantity.",
    examples: "Protection · labels · cartons/crates · packing count",
  },
];

const technicalChecks = [
  {
    category: "IDENTIFICATION",
    title: "Exact model and material number",
    body: "We compare the complete code, design series, order number and nameplate—not only the brand or family name.",
    examples: "Model suffix · material number · design revision",
  },
  {
    category: "HYDRAULIC PERFORMANCE",
    title: "Pressure, flow and displacement",
    body: "Working and peak pressure, required flow, pump or motor displacement and operating speed are reviewed together.",
    examples: "bar · L/min · cm³/rev · rpm",
  },
  {
    category: "FUNCTION & CONTROL",
    title: "Spool, control and circuit behavior",
    body: "Valve spool function, pump control type, compensator settings and the required de-energized or standby behavior must align.",
    examples: "Spool symbol · DR/DFR control · settings",
  },
  {
    category: "ELECTRICAL",
    title: "Voltage, connector and actuation",
    body: "For solenoid and proportional products, we check voltage, current type, connector, coil arrangement and control electronics.",
    examples: "12/24 VDC · 110/230 VAC · DIN connector",
  },
  {
    category: "MECHANICAL INTERFACE",
    title: "Mounting, ports, shaft and rotation",
    body: "Bolt pattern, flange, shaft, port location, envelope dimensions and rotation are compared against the installed unit.",
    examples: "ISO/CETOP · SAE · clockwise/counter-clockwise",
  },
  {
    category: "APPLICATION CONDITIONS",
    title: "Fluid, seals, temperature and duty",
    body: "Fluid type, seal material, ambient and oil temperature, contamination risk, duty cycle and machine environment affect approval.",
    examples: "NBR/FKM · viscosity · continuous/intermittent duty",
  },
];

const guides = [
  {
    href: "/models/",
    title: "Review Exact Model Records",
    subtitle: "See reviewed code groups and required checks.",
  },
  {
    href: "/tools/",
    title: "Use Hydraulic Calculators",
    subtitle: "Estimate flow, power, force and unit conversions.",
  },
  {
    href: "/downloads/",
    title: "Download RFQ Templates",
    subtitle: "Structure model, quantity and inspection requirements.",
  },
  {
    href: "/case-studies/",
    title: "Read Documented Cases",
    subtitle: "Follow evidence, review actions, outcomes and limits.",
  },
  {
    href: "/resources/hydraulic-pump-sizing-flow-pressure-power/",
    title: "Size Pump Flow and Power",
    subtitle: "Use formulas, units and worked examples.",
  },
  {
    href: "/resources/hydraulic-pump-cavitation-suction-line/",
    title: "Diagnose Pump Cavitation",
    subtitle: "Check the inlet system before replacing the pump.",
  },
  {
    href: "/resources/hydraulic-valve-pressure-drop-heat/",
    title: "Compare Valve Pressure Drop",
    subtitle: "Estimate heat and review real flow conditions.",
  },
  {
    href: "/resources/hydraulic-component-pre-shipment-inspection-checklist/",
    title: "Build an Inspection Checklist",
    subtitle: "Define order-linked evidence before purchase.",
  },
];

const faqs = [
  {
    question:
      "Can a hydraulic pump or valve replacement be confirmed from the series name alone?",
    answer:
      "Usually not. Products in the same series can differ by displacement, control, rotation, spool function, voltage, shaft, mounting flange, ports, seals and design revision. The complete model code and application must be reviewed.",
    href: "/resources/why-the-same-hydraulic-series-may-not-be-interchangeable/",
    linkLabel: "Why the same series may not interchange",
  },
  {
    question: "What information is needed for a hydraulic cross-reference?",
    answer:
      "Start with the original brand, complete model or part number, quantity and destination. Add a clear nameplate photo, product and interface photos, machine model, pressure, flow or displacement, voltage and any available drawing or datasheet.",
    href: "/downloads/model-identification-checklist/",
    linkLabel: "Use the model identification checklist",
  },
  {
    question: "Can you review an obsolete or discontinued hydraulic model?",
    answer:
      "Yes, when enough identification evidence is available. The review may consider an original source, remanufactured unit, documented aftermarket candidate, repair route or service part. The quotation states which route is proposed and what remains conditional.",
    href: "/resources/obsolete-hard-to-find-hydraulic-part-sourcing/",
    linkLabel: "See the obsolete-part sourcing process",
  },
  {
    question: "Is an aftermarket hydraulic replacement always a direct fit?",
    answer:
      "No. “Aftermarket” describes the supply route, not automatic interchangeability. Function, ratings, interfaces, material condition and application limits must be compared for the exact offered model before direct-fit wording is used.",
    href: "/resources/original-vs-aftermarket-hydraulic-sourcing-routes/",
    linkLabel: "Compare original and aftermarket routes",
  },
  {
    question: "What will a replacement quotation show?",
    answer:
      "A useful quotation identifies the requested reference, proposed model and source, compatibility status, known differences, open confirmation points, condition, MOQ, lead-time basis, inspection scope, packing, warranty and Incoterm.",
    href: "/matching-process/",
    linkLabel: "Review the matching and quotation process",
  },
];
---

<BaseLayout
  title="Hydraulic Component Sourcing from China | Hydraulic Match"
  description="Source Chinese hydraulic valves, pumps, cylinders and motors with model-code verification. Hydraulic Match reviews technical parameters, supplier evidence and export documentation for global buyers."
  currentPath="/"
  jsonLd={[
    itemListSchema(
      productCategories.map((item) => ({
        name: item.title,
        url: `${site.url}${item.href}`,
      })),
    ),
    howToSchema({
      name: "How Hydraulic Match reviews a hydraulic component request",
      description:
        "Four steps from model-code submission to sample and order confirmation.",
      steps: workflowSteps.map((step) => ({
        name: step.title,
        text: step.summary,
      })),
    }),
    faqSchema(faqs),
  ]}
>
  <FunnelPageView stage="selection" label="homepage" />

  <section class="hero-section">
    <div class="container">
      <div class="hero-wrapper">
        <div class="hero-content-block">
          <div class="hero-subtitle-block fade-in">
            <span class="hero-subtitle-icon hm-badge-icon" aria-hidden="true"
              >HM</span
            >
            <div class="hero-subtitle-text">{site.tagline}</div>
          </div>
          <div class="hero-title-block">
            <h1 class="hero-title fade-in">
              Chinese Alternatives for Hydraulic<br /><span
                class="hero-mobile-gap"
                aria-hidden="true">&nbsp;</span
              >Valves, Pumps and Cylinders
            </h1>
          </div>
          <div class="hero-bottom-content-block">
            <div class="hero-summary-block">
              <p class="hero-summary">
                Send the original model code, nameplate photo or technical
                drawing. We review the key parameters and provide suitable
                Chinese sourcing options for your application.
              </p>
            </div>
            <div class="hero-button-block">
              <div class="hero-cta-row">
                <a
                  href="/request-a-quote/?source=homepage"
                  class="secondary-button hero"
                >
                  <div class="button-content-block">
                    <div class="button-text">Request a Match</div><div
                      class="button-text"
                    >
                      Request a Match
                    </div>
                  </div>
                </a>
                <a href="/products/" class="hero-secondary-cta"
                  >Browse Product Categories</a
                >
              </div>
              <ul class="hero-trust-row" aria-label="Key service points">
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                    ><path
                      d="M5 12.5 9.5 17 19 7.5"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path></svg
                  >
                  Model-code review
                </li>
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                    ><path
                      d="M5 12.5 9.5 17 19 7.5"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path></svg
                  >
                  Small-batch RFQs welcome
                </li>
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                    ><path
                      d="M5 12.5 9.5 17 19 7.5"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path></svg
                  >
                  Export support from China
                </li>
              </ul>
            </div>
          </div>
        </div>
        <div class="hero-image-block">
          <img
            src="/images/hydraulic/hydraulic-match-hero.webp"
            alt="Unbranded hydraulic directional valve, piston pump and cylinder arranged for technical sourcing review"
            class="hero-image hm-hero-image"
            width="1536"
            height="1024"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="hero-image-overlay image-overlay fade-in"></div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="hm-products-section section-gap bottom"
    aria-labelledby="home-categories-heading"
  >
    <div class="container">
      <div class="hm-products-heading">
        <div>
          <p class="hm-kicker">PRODUCT DIRECTORY</p>
          <h2 id="home-categories-heading">
            Hydraulic Product Categories for Replacement and Sourcing
          </h2>
        </div>
        <div class="hm-products-intro">
          <p>
            Browse hydraulic valves, pumps, cylinders, motors and repair parts
            by product family. Each directory explains the configurations,
            parameters and evidence required before a sourcing option can be
            compared responsibly.
          </p>
          <div>
            <a href="/products/">View the complete product directory</a>
            <a href="/request-a-quote/?source=homepage-products">
              Send an unidentified nameplate or photo
            </a>
          </div>
        </div>
      </div>

      <div class="hm-product-grid fade-in">
        {
          productCategories.map((item, index) => (
            <a href={item.href} class="hm-product-card">
              <div class="hm-product-image">
                <img
                  src={item.image}
                  alt={`${item.title} reference products for technical identification and sourcing review`}
                  style={`object-position:${item.imagePosition}`}
                  width="1536"
                  height="1024"
                  loading="lazy"
                  decoding="async"
                />
                <span>{String(index + 1).padStart(2, "0")}</span>
              </div>
              <div class="hm-product-content">
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
                <div class="hm-product-detail">
                  <strong>Product scope</strong>
                  <span>{item.scope}</span>
                </div>
                <div class="hm-product-detail">
                  <strong>Key review fields</strong>
                  <span>{item.review}</span>
                </div>
                <footer>
                  <span>{item.linkLabel}</span>
                  <span aria-hidden="true">→</span>
                </footer>
              </div>
            </a>
          ))
        }
      </div>

      <p class="hm-products-note">
        Not sure which product family applies? Submit the complete nameplate and
        clear product, connector, port or shaft-side photos. Category routing is
        an identification step and does not by itself confirm compatibility.
      </p>
    </div>
  </section>

  <section
    class="hm-workflow-section section-gap bottom"
    aria-labelledby="home-workflow-heading"
  >
    <div class="container">
      <div class="hm-workflow-heading">
        <div>
          <p class="hm-kicker">FROM MODEL CODE TO ORDER</p>
          <h2 id="home-workflow-heading">
            How Hydraulic Component Matching and Quotation Works
          </h2>
        </div>
        <div class="hm-workflow-intro">
          <p>
            The workflow is designed for distributors, hydraulic repair
            companies, factory MRO teams and equipment manufacturers that need
            differences and open checks documented before purchase.
          </p>
          <a href="/matching-process/">
            See the detailed matching and quotation process
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <ol class="hm-workflow-grid fade-in">
        {
          workflowSteps.map((item) => (
            <li class="hm-workflow-card">
              <header>
                <span aria-hidden="true">{item.step}</span>
                <small>{item.stage}</small>
              </header>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
              <footer>{item.output}</footer>
            </li>
          ))
        }
      </ol>

      <div class="hm-workflow-actions">
        <p>
          A series name or visual similarity is not enough for a direct-fit
          decision. The exact configuration and application remain part of the
          review.
        </p>
        <div>
          <a href="/request-a-quote/?source=homepage-workflow">
            Start a hydraulic matching request
          </a>
          <a href="/downloads/model-identification-checklist/">
            Download the identification checklist
          </a>
        </div>
      </div>
    </div>
  </section>

  <section
    class="quote-standard-section section-gap bottom"
    aria-labelledby="quote-standard-heading"
  >
    <div class="container">
      <div class="hm-standard-heading">
        <div>
          <p class="hm-kicker">BEFORE PURCHASE APPROVAL</p>
          <h2 id="quote-standard-heading">
            Hydraulic Replacement Technical Review &amp; Quotation Standards
          </h2>
        </div>
        <div class="hm-standard-intro">
          <p>
            A useful hydraulic replacement quotation should show what was
            requested, what is being offered, what has been compared and what
            still requires customer confirmation—not only a price and lead time.
          </p>
          <div>
            <a href="/matching-process/">Review the complete matching process</a>
            <a href="/downloads/model-identification-checklist/">
              Prepare identification evidence
            </a>
          </div>
        </div>
      </div>

      <div class="hm-standard-layout">
        <aside class="hm-quote-output" aria-label="Minimum quotation record">
          <p class="hm-kicker">MINIMUM QUOTATION RECORD</p>
          <h3>Five answers a buyer should be able to find.</h3>
          <ol>
            <li><span>01</span><strong>What was requested?</strong></li>
            <li><span>02</span><strong>What model and supply route are proposed?</strong></li>
            <li><span>03</span><strong>What is confirmed, conditional or open?</strong></li>
            <li><span>04</span><strong>What differences need approval?</strong></li>
            <li><span>05</span><strong>What commercial and inspection terms apply?</strong></li>
          </ol>
          <a href="/request-a-quote/?source=homepage-standard">
            Submit a model for review <span aria-hidden="true">→</span>
          </a>
        </aside>

        <div class="quote-standard-grid fade-in">
          {
            quoteStandards.map((item, index) => (
              <article class="quote-standard-card">
                <header>
                  <span class="quote-standard-number" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <small>{item.category}</small>
                </header>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
                <footer>{item.output}</footer>
              </article>
            ))
          }
        </div>
      </div>

      <p class="quote-standard-note">
        The review records available evidence and open confirmation points. It
        does not replace machine-level engineering approval, commissioning or
        safety validation by the equipment owner and qualified personnel.
      </p>
    </div>
  </section>

  <section
    class="hm-brands-section section-gap bottom"
    aria-labelledby="home-brands-heading"
  >
    <div class="container">
      <div class="hm-brands-heading">
        <div>
          <p class="hm-kicker">HYDRAULIC REFERENCE DIRECTORY</p>
          <h2 id="home-brands-heading">
            Hydraulic Brand, Series &amp; Exact Model References We Review
          </h2>
        </div>
        <div class="hm-brands-intro">
          <p>
            Start with one of {brandCoverageStats.brands} manufacturer reference
            groups, narrow the request through {brandCoverageStats.seriesReferences}
            series-level entries, then use the complete model or material number
            for technical review.
          </p>
          <ol aria-label="Reference directory path">
            <li><span>01</span> Brand</li>
            <li><span>02</span> Series</li>
            <li><span>03</span> Exact model</li>
          </ol>
        </div>
      </div>

      <div class="hm-brand-grid fade-in">
        {
          brandReferences.map((item) => (
            <a
              href={item.href}
