---
import BaseLayout from '../layouts/BaseLayout.astro';
import FunnelPageView from '../components/FunnelPageView.astro';
import { breadcrumbSchema, faqSchema, howToSchema, itemListSchema, site } from '../data/site';

const productCategories = [
  {
    href: '/products/hydraulic-valves/',
    eyebrow: 'Priority 01',
    title: 'Hydraulic Valves',
    summary: 'Directional, pressure, flow, modular, check, proportional and servo valve sourcing.',
    details: 'Spool function · Voltage · Mounting · Ports',
  },
  {
    href: '/products/hydraulic-pumps/',
    eyebrow: 'Priority 02',
    title: 'Hydraulic Pumps',
    summary: 'Axial piston, vane and gear pumps plus selected pump replacement parts.',
    details: 'Displacement · Control · Rotation · Shaft',
  },
  {
    href: '/products/hydraulic-cylinders/',
    eyebrow: 'Priority 03',
    title: 'Hydraulic Cylinders',
    summary: 'Standard and custom cylinders developed from a drawing, sample or application data.',
    details: 'Bore · Rod · Stroke · Mounting',
  },
];

const matchingSteps = [
  { number: '01', title: 'Send the Model or Nameplate', text: 'Share the original brand, complete model code, order number, photos or drawing.' },
  { number: '02', title: 'We Review Key Parameters', text: 'We compare function, pressure, flow, voltage, mounting, ports and application conditions.' },
  { number: '03', title: 'Receive an Option and Quote', text: 'We present the sourcing route, known differences, MOQ, lead time and confirmation points.' },
  { number: '04', title: 'Confirm, Sample and Order', text: 'For higher-risk items, sample verification comes before a production or repeat order.' },
];

const capabilities = [
  ['Model-Code Matching', 'Complete model codes, order numbers and nameplates are reviewed before a sourcing recommendation.'],
  ['Parameter Comparison', 'Pressure, flow, displacement, voltage, spool, mounting, ports, shaft and rotation are compared as applicable.'],
  ['Chinese Sourcing Options', 'Suitable Chinese supply routes are reviewed against technical requirements, budget and lead time.'],
  ['Small-Batch & Mixed RFQs', 'Samples, small quantities and mixed valve, pump or cylinder lists are welcome.'],
  ['Pre-Shipment Verification', 'Visible markings, quantity, dimensions, packing and available test documents can be confirmed by order.'],
  ['Export Support', 'Export packing, commercial invoice, packing list and international transport coordination are available.'],
];

const technicalChecks = [
  'Complete model code and order number',
  'Pressure, flow or displacement',
  'Spool function or control type',
  'Voltage, connector and coil',
  'Mounting interface and port details',
  'Rotation, flange and shaft',
  'Fluid, seals and temperature',
  'Machine, duty cycle and environment',
];

const faqs = [
  { question: 'Can you confirm a replacement from the series name alone?', answer: 'Usually not. The complete model code, technical parameters and application conditions must be reviewed before compatibility can be confirmed.' },
  { question: 'What if I do not have the complete model code?', answer: 'Upload the nameplate and product photos. A drawing, old quotation or datasheet also helps identify the information still required.' },
  { question: 'Do you supply original products as well as Chinese alternatives?', answer: 'When a reliable route is available, the quotation can distinguish original, aftermarket or functional-alternative options. Each route is labelled clearly.' },
  { question: 'Can I request a sample or a mixed parts list?', answer: 'Yes. Sample, small-batch, distributor and mixed hydraulic component inquiries are welcome, subject to the actual supplier MOQ.' },
  { question: 'Do model references mean you are an authorized dealer?', answer: 'No. Manufacturer names and model numbers are used only for identification and cross-reference. Hydraulic Match is independent from the referenced manufacturers.' },
];
---

<BaseLayout
  title="Chinese Hydraulic Alternatives for Valves, Pumps and Cylinders | Hydraulic Match"
  description="Send a hydraulic model code, nameplate photo or drawing. Hydraulic Match reviews key parameters and sources suitable Chinese valve, pump and cylinder options."
  currentPath="/"
  jsonLd={[
    breadcrumbSchema([{ name: 'Home', url: site.url }]),
    itemListSchema(productCategories.map((item) => ({ name: item.title, url: `${site.url}${item.href}` }))),
    howToSchema({
      name: 'How Hydraulic Match reviews a hydraulic component request',
      description: 'Four steps from model-code submission to sample and order confirmation.',
      steps: matchingSteps.map((step) => ({ name: step.title, text: step.text })),
    }),
    faqSchema(faqs.map((faq) => ({ question: faq.question, answer: faq.answer }))),
  ]}
>
  <FunnelPageView stage="awareness" label="home" />

  <section class="hm-hero">
    <div class="container hm-hero__grid">
      <div class="hm-hero__content">
        <p class="hm-kicker">MODEL REVIEW · PARAMETER COMPARISON · EXPORT SOURCING</p>
        <h1>Chinese Alternatives for Hydraulic Valves, Pumps and Cylinders</h1>
        <p class="hm-hero__lead">Send the original model code, nameplate photo or technical drawing. We review the key parameters and provide suitable Chinese sourcing options for your application.</p>
        <div class="hm-actions">
          <a href="/request-a-quote/" class="primary-button"><span class="button-text">Request a Match</span></a>
          <a href="/products/" class="secondary-button"><span class="button-text">Browse Product Categories</span></a>
        </div>
        <ul class="hm-proofline" aria-label="Service highlights">
          <li>Response within one business day</li>
          <li>Small quantity inquiries welcome</li>
          <li>Pre-shipment confirmation available</li>
        </ul>
      </div>

      <div class="hm-hero__panel">
        <div class="hm-panel__top">
          <p class="hm-panel__eyebrow">QUICK MATCH REQUEST</p>
          <h2>Start with the model code.</h2>
          <p>No complete code? Upload the nameplate or product photo.</p>
        </div>
        <form class="hm-quick-form" id="home-rfq" data-endpoint="/api/rfq/" data-fallback-email={site.email}>
          <div class="hm-form-row">
            <label>Name <span>*</span><input name="name" autocomplete="name" required /></label>
            <label>Business Email <span>*</span><input name="email" type="email" autocomplete="email" required /></label>
          </div>
          <div class="hm-form-row">
            <label>Original Brand <span>*</span><input name="brand" placeholder="e.g. Rexroth" required /></label>
            <label>Model / Part Number <span>*</span><input name="model" placeholder="Full code if available" required /></label>
          </div>
          <div class="hm-form-row">
            <label>Quantity <span>*</span><input name="quantity" placeholder="e.g. 2 pcs" required /></label>
            <label>Destination Country <span>*</span><input name="country" autocomplete="country-name" required /></label>
          </div>
          <label class="hm-upload">Nameplate photo or file
            <input name="drawing" type="file" accept=".jpg,.jpeg,.png,.pdf,.xls,.xlsx,.csv,.zip" />
          </label>
          <label class="hm-message">Message <span class="hm-optional">(optional)</span><textarea name="details" rows="3" placeholder="Application, pressure, flow, voltage or known replacement reason"></textarea></label>
          <input type="hidden" name="source" value="Homepage quick match" />
          <input type="hidden" name="message" />
          <div class="hp-field" aria-hidden="true"><label>Leave empty<input name="website" tabindex="-1" autocomplete="off" /></label></div>
          <button type="submit" class="hm-submit">Send Match Request</button>
          <p class="hm-form-note">We use your files only to review this inquiry. Compatibility is confirmed after technical review.</p>
          <div class="form-result" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </section>

  <section class="hm-section hm-section--products">
    <div class="container">
      <div class="hm-heading">
        <p class="hm-kicker">CORE PRODUCT SCOPE</p>
        <h2>Focused on three hydraulic product groups</h2>
        <p>We start with categories where the supply route and technical comparison can be documented—then expand only when real product data is available.</p>
      </div>
      <div class="hm-product-grid">
        {productCategories.map((item) => (
          <a href={item.href} class="hm-product-card">
            <span class="hm-card__eyebrow">{item.eyebrow}</span>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            <span class="hm-card__details">{item.details}</span>
            <span class="hm-card__link">Explore category <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="hm-section hm-section--dark">
    <div class="container">
      <div class="hm-heading hm-heading--light">
        <p class="hm-kicker">HOW IT WORKS</p>
        <h2>From part number to a reviewable sourcing option</h2>
        <p>Each step is designed to reduce the risk of quoting from a partial code or an assumed interchange.</p>
      </div>
      <ol class="hm-steps">
        {matchingSteps.map((step) => (
          <li>
            <span class="hm-step__number">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
      <a href="/matching-process/" class="hm-text-link hm-text-link--light">See the complete matching process →</a>
    </div>
  </section>

  <section class="hm-section">
    <div class="container hm-split">
      <div class="hm-heading">
        <p class="hm-kicker">MORE THAN A PART NUMBER SEARCH</p>
        <h2>We compare the details that determine whether an alternative can work.</h2>
        <p>A similar series name is not enough. The proposed option is reviewed against the original reference and the actual machine conditions.</p>
        <a href="/quality/" class="hm-text-link">Review quality and verification scope →</a>
      </div>
      <ul class="hm-check-grid">
        {technicalChecks.map((item, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="hm-section hm-section--tint">
    <div class="container">
      <div class="hm-heading">
        <p class="hm-kicker">WHY HYDRAULIC MATCH</p>
        <h2>A sourcing workflow built around technical confirmation</h2>
      </div>
      <div class="hm-capability-grid">
        {capabilities.map(([title, text], index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="hm-section">
    <div class="container hm-distributor">
      <div>
        <p class="hm-kicker">DISTRIBUTORS · REPAIR SHOPS · MRO</p>
        <h2>Send one model or a mixed RFQ list.</h2>
        <p>We support sample orders, line-by-line Excel inquiries, neutral export packing and sourcing discussions for repeat purchasing programs.</p>
      </div>
      <div class="hm-actions">
        <a href="/distributor-support/" class="secondary-button"><span class="button-text">Distributor Support</span></a>
        <a href="/request-a-quote/" class="primary-button"><span class="button-text">Upload an RFQ List</span></a>
      </div>
    </div>
  </section>

  <section class="hm-section hm-section--faq">
    <div class="container hm-faq-layout">
      <div class="hm-heading">
        <p class="hm-kicker">FREQUENT QUESTIONS</p>
        <h2>Before you request a match</h2>
      </div>
      <div class="hm-faq-list">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="hm-final-cta">
    <div class="container">
      <p class="hm-kicker">READY TO REVIEW A COMPONENT?</p>
      <h2>No complete model code? Send the nameplate and product photos.</h2>
      <p>We will identify the missing information and explain what must be confirmed before a quotation or compatibility decision.</p>
      <a href="/request-a-quote/" class="primary-button"><span class="button-text">Request a Match</span></a>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#home-rfq');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const result = form.querySelector<HTMLElement>('.form-result');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const data = new FormData(form);
    const details = data.get('details')?.toString().trim();
    const message = [
      `Original brand: ${data.get('brand')}`,
      `Model / part number: ${data.get('model')}`,
      `Quantity: ${data.get('quantity')}`,
      `Destination country: ${data.get('country')}`,
      details ? `Message: ${details}` : '',
    ].filter(Boolean).join('\n');
    data.set('message', message);
    submit?.setAttribute('disabled', 'true');
    if (submit) submit.textContent = 'Sending...';
    try {
      const response = await fetch(form.dataset.endpoint ?? '/api/rfq/', { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error('Request failed');
      window.location.href = '/thank-you/?source=homepage';
    } catch {
      if (result) {
        result.className = 'form-result is-visible is-error';
        result.innerHTML = `<strong>We could not send this form.</strong> Please email <a href="mailto:${form.dataset.fallbackEmail}">${form.dataset.fallbackEmail}</a>.`;
      }
      submit?.removeAttribute('disabled');
      if (submit) submit.textContent = 'Send Match Request';
    }
  });
</script>

<style>
  .hm-hero { background:var(--color-body); padding:54px 0 72px; }
  .hm-hero__grid { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(390px,.75fr); gap:40px; align-items:center; }
  .hm-hero__content { padding:52px 0; }
  .hm-kicker { color:var(--color-primary); font-size:13px; line-height:1.4; font-weight:600; letter-spacing:.14em; margin:0 0 18px; }
  .hm-hero h1 { max-width:880px; margin:0 0 24px; line-height:1.02; letter-spacing:-.035em; }
  .hm-hero__lead { max-width:780px; font-size:21px; line-height:1.55; margin:0 0 32px; color:#3e4755; }
  .hm-actions { display:flex; flex-wrap:wrap; gap:12px; align-items:center; }
  .hm-proofline { display:flex; flex-wrap:wrap; gap:10px 26px; padding:0; margin:30px 0 0; list-style:none; color:#46505e; font-size:14px; }
  .hm-proofline li::before { content:""; display:inline-block; width:7px; height:7px; border-radius:50%; background:var(--color-primary); margin-right:9px; }
  .hm-hero__panel { background:#fff; border:1px solid var(--color-stroke); box-shadow:0 24px 70px rgba(8,8,8,.12); }
  .hm-panel__top { padding:28px 30px 22px; background:var(--color-title); color:#fff; }
  .hm-panel__eyebrow { color:#7fb2ff; font-size:12px; letter-spacing:.12em; margin:0 0 8px; }
  .hm-panel__top h2 { color:#fff; font-size:28px; margin:0 0 8px; }
  .hm-panel__top p:last-child { color:#bcc4cf; font-size:15px; margin:0; }
  .hm-quick-form { padding:26px 30px 28px; display:grid; gap:14px; }
  .hm-form-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .hm-quick-form label { display:grid; gap:7px; font-size:13px; font-weight:600; color:#252b34; }
  .hm-quick-form label > span { color:var(--color-primary); }
  .hm-quick-form input,.hm-quick-form textarea { width:100%; border:1px solid #d8dde5; background:#fbfcfd; padding:12px 13px; color:var(--color-title); font:400 15px var(--font-primary); transition:border-color .2s,box-shadow .2s; }
  .hm-quick-form input:focus-visible,.hm-quick-form textarea:focus-visible { outline:none; border-color:var(--color-primary); box-shadow:0 0 0 3px rgba(20,110,245,.15); }
  .hm-upload { padding:12px; border:1px dashed #b7c0cc; background:#f7f9fc; }
  .hm-upload input { padding:7px 0 0; border:0; background:transparent; font-size:13px; }
  .hm-optional { color:#7b8490 !important; font-weight:400; }
  .hm-submit { min-height:52px; border:0; background:var(--color-primary); color:#fff; font:600 16px var(--font-title); cursor:pointer; transition:background .2s; }
  .hm-submit:hover { background:#0b5ed7; }
  .hm-submit:focus-visible { outline:3px solid rgba(20,110,245,.35); outline-offset:3px; }
  .hm-submit:disabled { opacity:.65; cursor:wait; }
  .hm-form-note { margin:0; font-size:12px; line-height:1.5; color:#6a7481; }
  .hp-field { position:absolute; left:-9999px; }
  .hm-section { padding:100px 0; background:#fff; }
  .hm-section--products { background:#f7f8fa; }
  .hm-section--dark { background:var(--color-title); color:#fff; }
  .hm-section--tint { background:#eef3fa; }
  .hm-section--faq { background:#f7f8fa; }
  .hm-heading { max-width:810px; margin-bottom:46px; }
  .hm-heading h2 { margin:0 0 16px; line-height:1.08; letter-spacing:-.025em; }
  .hm-heading > p:last-child { color:#536071; line-height:1.65; margin:0; }
  .hm-heading--light h2 { color:#fff; }
  .hm-heading--light > p:last-child { color:#adb6c3; }
  .hm-product-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
  .hm-product-card { display:flex; flex-direction:column; min-height:360px; padding:34px; background:#fff; border:1px solid var(--color-stroke); color:inherit; text-decoration:none; cursor:pointer; transition:border-color .2s,transform .2s,box-shadow .2s; }
  .hm-product-card:hover { border-color:var(--color-primary); transform:translateY(-3px); box-shadow:0 16px 40px rgba(15,23,42,.08); }
  .hm-card__eyebrow { color:var(--color-primary); font:600 12px var(--font-title); letter-spacing:.1em; margin-bottom:auto; }
  .hm-product-card h3 { font-size:30px; margin:42px 0 14px; }
  .hm-product-card p { color:#596575; font-size:16px; line-height:1.55; margin:0 0 22px; }
  .hm-card__details { padding-top:18px; border-top:1px solid var(--color-stroke); color:#667181; font-size:13px; }
  .hm-card__link { color:var(--color-primary); font-weight:600; margin-top:22px; }
  .hm-steps { display:grid; grid-template-columns:repeat(4,1fr); list-style:none; padding:0; margin:0 0 36px; border-top:1px solid #343a43; border-bottom:1px solid #343a43; }
  .hm-steps li { min-height:260px; padding:30px 26px; border-right:1px solid #343a43; }
  .hm-steps li:last-child { border-right:0; }
  .hm-step__number { color:var(--color-primary); font:500 17px var(--font-title); }
  .hm-steps h3 { color:#fff; font-size:22px; margin:58px 0 12px; }
  .hm-steps p { color:#aeb7c3; font-size:15px; line-height:1.6; margin:0; }
  .hm-text-link { color:var(--color-primary); font-weight:600; text-decoration:none; }
  .hm-text-link:hover { text-decoration:underline; }
  .hm-text-link--light { color:#7eb1ff; }
  .hm-split { display:grid; grid-template-columns:.8fr 1fr; gap:90px; align-items:start; }
  .hm-check-grid { display:grid; grid-template-columns:1fr 1fr; list-style:none; padding:0; margin:0; border-top:1px solid var(--color-stroke); }
  .hm-check-grid li { display:flex; gap:14px; align-items:center; min-height:78px; padding:14px 18px; border-bottom:1px solid var(--color-stroke); font-size:16px; }
  .hm-check-grid li:nth-child(odd) { border-right:1px solid var(--color-stroke); }
  .hm-check-grid span { color:var(--color-primary); font:600 12px var(--font-title); }
  .hm-capability-grid { display:grid; grid-template-columns:repeat(3,1fr); border-top:1px solid #ccd8e8; border-left:1px solid #ccd8e8; }
  .hm-capability-grid article { min-height:250px; padding:30px; border-right:1px solid #ccd8e8; border-bottom:1px solid #ccd8e8; }
  .hm-capability-grid article > span { color:var(--color-primary); font:600 12px var(--font-title); }
  .hm-capability-grid h3 { margin:54px 0 12px; font-size:22px; }
  .hm-capability-grid p { color:#536071; font-size:15px; line-height:1.6; margin:0; }
  .hm-distributor { display:flex; align-items:center; justify-content:space-between; gap:50px; padding-top:12px; padding-bottom:12px; }
  .hm-distributor > div:first-child { max-width:760px; }
  .hm-distributor h2 { margin:0 0 14px; }
  .hm-distributor p:last-child { color:#536071; margin:0; }
  .hm-faq-layout { display:grid; grid-template-columns:.55fr 1fr; gap:80px; }
  .hm-faq-list { border-top:1px solid #cfd5dd; }
  .hm-faq-list details { border-bottom:1px solid #cfd5dd; padding:22px 0; }
  .hm-faq-list summary { font:600 19px var(--font-title); cursor:pointer; color:var(--color-title); }
  .hm-faq-list p { color:#536071; font-size:16px; line-height:1.65; margin:16px 0 0; max-width:760px; }
  .hm-final-cta { padding:100px 0; background:#d9e7fa; text-align:center; }
  .hm-final-cta h2 { max-width:900px; margin:0 auto 18px; }
  .hm-final-cta > .container > p:not(.hm-kicker) { max-width:760px; margin:0 auto 30px; color:#465466; }
  @media (max-width:991px) {
    .hm-hero__grid,.hm-split,.hm-faq-layout { grid-template-columns:1fr; }
    .hm-hero__content { padding:20px 0 0; }
    .hm-product-grid,.hm-capability-grid { grid-template-columns:1fr 1fr; }
    .hm-steps { grid-template-columns:1fr 1fr; }
    .hm-steps li:nth-child(2) { border-right:0; }
    .hm-steps li:nth-child(-n+2) { border-bottom:1px solid #343a43; }
    .hm-distributor { align-items:flex-start; flex-direction:column; }
  }
  @media (max-width:600px) {
    .hm-hero { padding-top:30px; }
    .hm-hero__grid { display:block; }
    .hm-hero__panel { margin-top:42px; }
    .hm-form-row,.hm-product-grid,.hm-capability-grid,.hm-steps,.hm-check-grid { grid-template-columns:1fr; }
    .hm-section { padding:72px 0; }
    .hm-product-card { min-height:300px; }
    .hm-steps li { border-right:0; border-bottom:1px solid #343a43; }
    .hm-steps li:last-child { border-bottom:0; }
    .hm-check-grid li:nth-child(odd) { border-right:0; }
    .hm-capability-grid { border-left:0; }
    .hm-capability-grid article { border-left:1px solid #ccd8e8; }
    .hm-hero__lead { font-size:18px; }
    .hm-panel__top,.hm-quick-form { padding-left:20px; padding-right:20px; }
  }
  @media (prefers-reduced-motion:reduce) {
    .hm-product-card,.hm-quick-form input,.hm-quick-form textarea,.hm-submit { transition:none; }
    .hm-product-card:hover { transform:none; }
  }
</style>
