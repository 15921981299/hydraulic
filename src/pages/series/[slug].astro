---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbHero from "../../components/BreadcrumbHero.astro";
import DetailPageShell from "../../components/DetailPageShell.astro";
import DetailRfqStrip from "../../components/DetailRfqStrip.astro";
import HydraulicProductSidebar from "../../components/HydraulicProductSidebar.astro";
import { seriesModels, seriesRecords } from "../../data/series-records";
import { breadcrumbSchema, itemListSchema, site } from "../../data/site";
import "../../styles/resource-page.css";

export function getStaticPaths() {
  return seriesRecords.map((record) => ({
    params: { slug: record.slug },
    props: { record },
  }));
}

const { record } = Astro.props;
const models = seriesModels(record.series);
const pageUrl = `${site.url}/series/${record.slug}/`;
const quoteHref = `/contact/?source=series-${record.slug}&brand=${encodeURIComponent(record.brand)}&model=${encodeURIComponent(record.series)}`;
const isMcr = record.slug === "mcr";
const isCatPump = record.slug === "cat-piston-pump";
const seoTitle = isMcr
  ? "MCR Replacement Motor & MCR03 Seal Kit"
  : isCatPump
    ? "Caterpillar Hydraulic Pump Replacement"
    : `${record.brand} ${record.series} Specifications`;
const h1Title = isMcr
  ? "MCR Replacement Hydraulic Motors & Seal Kits"
  : isCatPump
    ? "Caterpillar Hydraulic Pump Replacement"
    : `${record.series} Specifications & Model Codes`;
const isValveSeries = /valve/i.test(record.productType);
const isMotorSeries = /motor/i.test(record.productType);
const isServiceSeries = /service|seal|cartridge|repair/i.test(
  record.productType,
);
const sourceIsLink =
  record.sourceUrl.startsWith("/") || /^https?:\/\//.test(record.sourceUrl);
const evidenceForFocus = (focus: string) => {
  if (/voltage|connector|operator|spool|control function/i.test(focus)) {
    return {
      evidence:
        "Complete code, hydraulic symbol, coil or electronics label, connector photo and machine command",
      release:
        "Function, normal state and electrical configuration must be stated in the proposed-model comparison",
    };
  }
  if (/shaft|flange|mounting|port|rotation|through-drive/i.test(focus)) {
    return {
      evidence:
        "Drive-side and port-side photographs, drawing, measured interfaces and defined rotation viewpoint",
      release:
        "Every installation interface must match or the required change must be identified before quotation approval",
    };
  }
  if (/pressure|flow|speed|fluid|duty|displacement/i.test(focus)) {
    return {
      evidence:
        "Operating and peak pressure, flow or speed, fluid, temperature, duty cycle and machine function",
      release:
        "Ratings and expected behavior must cover the recorded operating condition rather than a nominal catalogue point",
    };
  }
  if (/condition|stock|quantity|required date/i.test(focus)) {
    return {
      evidence:
        "Exact part number, requested quantity, required date, acceptable condition and destination",
      release:
        "Condition, quantity, current availability, lead time and warranty must be confirmed in the current quotation",
    };
  }
  if (/assembly|part number|revision|size/i.test(focus)) {
    return {
      evidence:
        "Complete parent-unit and service-part codes, serial or revision evidence, nameplate and dismantled-part photographs",
      release:
        "Kit or service-part scope must be tied to the identified parent unit and revision",
    };
  }
  return {
    evidence:
      "Complete code, manufacturer reference, nameplate, technical document and application details",
    release:
      "The proposed route must state what is confirmed, different and still open",
  };
};
const minimumEvidence = isValveSeries
  ? [
      "Complete valve code and readable coil or electronics label",
      "Hydraulic symbol, normal state and required actuation",
      "Pressure, flow, fluid and operating temperature",
      "Mounting pattern, connector and available installation space",
    ]
  : isMotorSeries
    ? [
        "Complete motor code, machine and required torque-speed duty",
        "Displacement, shaft, pilot, mounting and port arrangement",
        "Brake, flushing, case-drain and control details where applicable",
        "Pressure, flow, fluid, temperature and load behavior",
      ]
    : isServiceSeries
      ? [
          "Complete parent-unit code, size, serial or design revision",
          "Exact service-part number and required kit or assembly scope",
          "Photographs of the nameplate and removed components",
          "Quantity, condition, destination and required date",
        ]
      : [
          "Complete pump code, machine and reason for replacement",
          "Displacement, control, rotation, shaft and mounting flange",
          "Port layout, through-drive and installed-space evidence",
          "Pressure, speed, flow, fluid, temperature and duty cycle",
        ];
---

<BaseLayout
  title={seoTitle}
  description={record.summary}
  currentPath="/series"
  image={record.image}
  jsonLd={[
    breadcrumbSchema([
      { name: "Home", url: site.url },
      { name: "Series Directory", url: `${site.url}/series/` },
      { name: `${record.series} Series`, url: pageUrl },
    ]),
    itemListSchema(
      models.map((model) => ({
        name: `${model.brand} ${model.model}`,
        url: `${site.url}/models/${model.slug}/`,
      })),
    ),
  ]}
>
  <BreadcrumbHero
    title={h1Title}
    trail={[
      { label: "Home", href: "/" },
      { label: "Series Directory", href: "/series/" },
      { label: record.series },
    ]}
    variant={record.productType.includes("valve") ? "2" : "3"}
  />

  <DetailPageShell intro={record.summary}>
    <img
      slot="hero"
      src={record.image}
      alt={`${record.brand} ${record.series} ${record.productType} product family`}
      width="1200"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <div class="resource-meta">
      <span><strong>Brand reference</strong> {record.brand}</span>
      <span><strong>Series</strong> {record.series}</span>
      <span><strong>Type</strong> {record.productType}</span>
      <span><strong>Exact records</strong> {models.length}</span>
    </div>

    <section class="series-evidence">
      <p>SERIES IDENTIFICATION OVERVIEW</p>
      <h2>Identify the family before comparing an exact replacement.</h2>
      <dl>
        <div>
          <dt>Series</dt>
          <dd>{record.series}</dd>
        </div>
        <div>
          <dt>Product type</dt>
          <dd>{record.productType}</dd>
        </div>
        <div>
          <dt>Exact records</dt>
          <dd>{models.length}</dd>
        </div>
      </dl>
      <p>
        This page explains the series-level code and evidence fields. Candidate
        replacements, current availability and order terms belong on exact-model
        records and quotations.
      </p>
    </section>

    <section>
      <h2>What We Verify for {record.series}</h2>
      <div class="resource-checklist-grid">
        {
          record.reviewFocus.map((item) => (
            <div class="resource-checklist-card">
              <strong>{item}</strong>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <h2>{record.series} Evidence Basis and Page Boundary</h2>
      <div class="resource-checklist-grid">
        <article class="resource-checklist-card">
          <h3>Source basis</h3>
          <p>
            This series entry is organized from{" "}
            {
              sourceIsLink ? (
                <a href={record.sourceUrl}>{record.sourceSite}</a>
              ) : (
                record.sourceSite
              )
            }
            , the linked exact records on this site and the review fields shown below.
            {record.sourceNote}
          </p>
        </article>
        <article class="resource-checklist-card">
          <h3>What the series page establishes</h3>
          <p>
            It identifies {record.series} as a {record.productType} reference family
            and records the information needed to begin a technical and commercial
            review.
          </p>
        </article>
        <article class="resource-checklist-card">
          <h3>What it does not establish</h3>
          <p>
            A series name does not prove that two suffixes, part numbers or
            machine installations are interchangeable. Direct compatibility
            remains conditional on the exact-code and application review.
          </p>
        </article>
        <article class="resource-checklist-card">
          <h3>Commercial evidence boundary</h3>
          <p>
            A catalog or source record may show that a route exists. Current
            stock, condition, included configuration, price, MOQ, lead time and
            warranty require confirmation for the quoted item and quantity.
          </p>
        </article>
      </div>
    </section>

    <section>
      <h2>{record.series} Review and Release Matrix</h2>
      <div class="resource-table-wrap">
        <table class="resource-table">
          <thead>
            <tr>
              <th scope="col">Review field</th>
              <th scope="col">Evidence to send</th>
              <th scope="col">Release rule</th>
            </tr>
          </thead>
          <tbody>
            {
              record.reviewFocus.map((focus) => {
                const guidance = evidenceForFocus(focus);
                return (
                  <tr>
                    <td>
                      <strong>{focus}</strong>
                    </td>
                    <td>{guidance.evidence}</td>
                    <td>{guidance.release}</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="series-columns">
      <article class="resource-checklist-card">
        <h2>Record Types Linked to This Series</h2>
        <ul class="resource-list">
          {record.supplyRoutes.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="resource-checklist-card">
        <h2>Typical Applications</h2>
        <ul class="resource-list">
          {record.applications.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </section>

    <section>
      <h2>Minimum Evidence for a {record.series} Inquiry</h2>
      <ul class="resource-list">
        {minimumEvidence.map((item) => <li>{item}</li>)}
      </ul>
      <p class="resource-note">
        Missing information should be listed as an open confirmation point. It
        should not be guessed from appearance, a shortened family name or an
        unrelated catalog example.
      </p>
    </section>

    {
      isMcr && (
        <section>
          <h2>MCR Replacement Selection & Commercial Confirmation</h2>
          <div class="resource-checklist-grid">
            <article class="resource-checklist-card">
              <h3>Complete-code replacement review</h3>
              <p>
                Send the complete MCR code, displacement, shaft, mounting,
                ports, brake and application duty. A direct-compatible
                commitment is made only for the configuration confirmed in the
                quotation.
              </p>
            </article>
            <article class="resource-checklist-card">
              <h3>MCR03 seal-kit identification</h3>
              <p>
                The MCR03 motor size and design revision are checked before kit
                contents, seal material, stock status and supply route are
                confirmed.
              </p>
            </article>
            <article class="resource-checklist-card">
              <h3>Stock, lead time and warranty</h3>
              <p>
                Each offer states condition, exact availability, MOQ, lead time,
                inspection scope and any written warranty period for the exact
                motor or kit.
              </p>
            </article>
          </div>
          <div class="hub-grid mcr-related-grid">
            <a href="/models/poclain-mcr03-seal-kit/" class="hub-card">
              <h3>Poclain MCR03 seal kit</h3>
              <p>Open the exact service-kit record and quotation fields.</p>
              <span class="hub-card-link">View MCR03 record →</span>
            </a>
            <a
              href="/products/hydraulic-motors/radial-piston-motors/"
              class="hub-card"
            >
              <h3>Radial piston motors</h3>
              <p>Compare the broader high-torque motor selection criteria.</p>
              <span class="hub-card-link">View motor category →</span>
            </a>
            <a href="/brands/poclain/" class="hub-card">
              <h3>Poclain reference coverage</h3>
              <p>Browse consolidated Poclain model and series references.</p>
              <span class="hub-card-link">View brand coverage →</span>
            </a>
          </div>
        </section>
      )
    }

    {
      isCatPump && (
        <section>
          <h2>Caterpillar Hydraulic Pump Part-Number Review</h2>
          <div class="resource-checklist-grid">
            <article class="resource-checklist-card">
              <h3>Machine and part-number identification</h3>
              <p>
                Submit the Caterpillar pump part number, machine model, serial
                range, pump nameplate and installed-unit photos. Superseded
                numbers are reviewed together rather than treated as automatic
                equivalents.
              </p>
            </article>
            <article class="resource-checklist-card">
              <h3>Replacement pump configuration</h3>
              <p>
                Displacement, control, rotation, shaft, flange, ports,
                through-drive and application duty are confirmed before a
                direct-compatible route is offered.
              </p>
            </article>
            <article class="resource-checklist-card">
              <h3>Commercial confirmation</h3>
              <p>
                Exact availability, condition, included configuration, price,
                lead time, inspection evidence and any warranty period are
                stated in the quotation.
              </p>
            </article>
          </div>
          <p class="resource-note">
            Review the linked exact record for Caterpillar references{" "}
            <a href="/models/cat-169-4883-259-0815-295-9426-153-9426-10r3805/">
              169-4883, 259-0815, 295-9426, 153-9426 and 10R3805
            </a>
            , or return to the{" "}
            <a href="/products/hydraulic-pumps/">
              hydraulic pump supplier page
            </a>
            .
          </p>
        </section>
      )
    }

    <section>
      <div class="series-model-heading">
        <div>
          <p>EXACT RECORDS</p>
          <h2>{models.length} linked model and part records</h2>
        </div>
        <a href="/models/">Browse all models</a>
      </div>
      {
        models.length ? (
          <div class="series-model-grid">
            {models.map((model) => (
              <article>
                <span>{model.productType}</span>
                <h3>
                  <a href={`/models/${model.slug}/`}>{model.model}</a>
                </h3>
                <dl>
                  <div>
                    <dt>Status</dt>
                    <dd>{model.commercial?.status ?? "Engineering review"}</dd>
                  </div>
                  <div>
                    <dt>MOQ</dt>
                    <dd>{model.commercial?.moq ?? "Confirm with quotation"}</dd>
                  </div>
                  <div>
                    <dt>Lead time</dt>
                    <dd>
                      {model.commercial?.leadTime ??
                        "Confirmed after complete-code review"}
                    </dd>
                  </div>
                </dl>
                <a href={`/models/${model.slug}/`}>Open exact record →</a>
              </article>
            ))}
          </div>
        ) : (
          <div class="series-empty">
            <strong>Series anchor published</strong>
            <p>
              Exact model records are added after the model code and technical
              review fields can be confirmed. Send a nameplate to start the next
              record.
            </p>
          </div>
        )
      }
    </section>

    <DetailRfqStrip
      quoteHref={quoteHref}
      title={`Request a ${record.series} match`}
      text="Send the full code, nameplate, quantity and destination. The quotation will state condition, current stock, MOQ, lead time, differences and warranty."
      modalContext={`${record.series} series inquiry`}
      modalSource={`series-${record.slug}`}
    />

    <p class="resource-related">
      <a href="/series/">All series</a>
      <span aria-hidden="true">·</span>
      <a href="/models/">Exact model records</a>
      <span aria-hidden="true">·</span>
      <a href="/commercial-proof/">Commercial evidence</a>
    </p>

    <HydraulicProductSidebar
      slot="sidebar"
      activeSlug=""
      quoteHref={quoteHref}
    />
  </DetailPageShell>
</BaseLayout>

<style>
  .series-evidence {
    padding: 26px;
    border: 1px solid rgba(20, 110, 245, 0.22);
    border-left: 4px solid var(--color-primary);
    background: #f7f9fc;
  }
  .series-evidence > p:first-child,
  .series-model-heading p {
    margin: 0;
    color: var(--color-primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .series-evidence h2 {
    margin: 8px 0 18px;
    text-transform: none;
  }
  .series-evidence dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .series-evidence dl > div {
    padding: 14px;
    border: 1px solid var(--color-stroke);
    background: #fff;
  }
  .series-evidence dt,
  .series-model-grid dt {
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .series-evidence dd,
  .series-model-grid dd {
    margin: 5px 0 0;
    color: var(--color-title);
    line-height: 1.5;
  }
  .series-evidence > p:not(:first-child) {
    color: #536071;
    line-height: 1.65;
  }
  .series-evidence a,
  .resource-checklist-card a,
  .series-model-heading a,
  .series-model-grid a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }
  .series-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .series-columns h2 {
    margin-top: 0;
  }
  .series-model-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
  }
  .series-model-heading h2 {
    margin: 7px 0 0;
    text-transform: none;
  }
  .series-model-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .mcr-related-grid {
    grid-template-columns: repeat(3, 1fr);
    margin-top: 16px;
  }
  .series-model-grid article,
  .series-empty {
    padding: 22px;
    border: 1px solid var(--color-stroke);
    background: #fff;
  }
  .series-model-grid article > span {
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .series-model-grid h3 {
    margin: 8px 0 15px;
    font-size: 19px;
    text-transform: none;
    overflow-wrap: anywhere;
  }
  .series-model-grid h3 a {
    color: var(--color-title);
  }
  .series-model-grid dl {
    margin: 0 0 16px;
  }
  .series-model-grid dl > div {
    padding: 8px 0;
    border-top: 1px solid var(--color-stroke);
  }
  .series-empty p {
    margin-bottom: 0;
    color: #536071;
  }
  @media (max-width: 760px) {
    .series-evidence dl,
    .series-columns,
    .series-model-grid,
    .mcr-related-grid {
      grid-template-columns: 1fr;
    }
    .series-model-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
